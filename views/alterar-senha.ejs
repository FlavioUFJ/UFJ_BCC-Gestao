<div class="container-fluid py-3">
    <div class="row justify-content-center">
        <div class="col-lg-5 col-md-7">
            <div class="card shadow border-0">
                <div class="card-header text-center text-white">
                    <h4 class="mb-0 fw-bold"><i class="fas fa-key me-2"></i>Alterar Senha</h4>
                </div>
                <div class="card-body p-3">
                    <% if (primeiroLogin) { %>
                        <div class="alert alert-warning mb-3" role="alert">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            <strong>Primeiro acesso:</strong> Por segurança, você deve alterar sua senha inicial.
                        </div>
                    <% } else { %>
                        <div class="alert alert-info mb-3" role="alert">
                            <i class="fas fa-shield-alt me-2"></i>
                            <strong>Mantenha sua conta segura</strong>
                        </div>
                    <% } %>
                
                <% if (error) { %>
                    <div class="alert alert-danger d-flex align-items-center">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <div><%= error %></div>
                    </div>
                <% } %>
                
                <% if (success) { %>
                    <div class="alert alert-success d-flex align-items-center">
                        <i class="fas fa-check-circle me-2"></i>
                        <div><%= success %></div>
                    </div>
                <% } %>
                
                <form method="POST" action="/alterar-senha" id="alterarSenhaForm">
                    <!-- Campo hidden para preservar o returnUrl -->
                    <input type="hidden" name="returnUrl" value="<%= returnUrl %>">
                    
                    <div class="mb-3">
                        <label for="senhaAtual" class="form-label">
                            <% if (primeiroLogin) { %>
                                Senha Atual (sua matrícula) *
                            <% } else { %>
                                Senha Atual *
                            <% } %>
                        </label>
                        <% let placeholderText = primeiroLogin ? 'Digite sua matrícula' : 'Digite sua senha atual'; %>
                    <input type="password" class="form-control" id="senhaAtual" name="senhaAtual" required
                           placeholder="<%= placeholderText %>">
                    </div>
                    
                    <div class="mb-3">
                        <label for="novaSenha" class="form-label">Nova Senha *</label>
                        <input type="password" class="form-control" id="novaSenha" name="novaSenha" required minlength="6" 
                               placeholder="Digite sua nova senha">
                        <div class="form-text">Mínimo 6 caracteres</div>
                    </div>
                    
                    <div class="mb-3">
                        <label for="confirmarNovaSenha" class="form-label">Confirmar Nova Senha *</label>
                        <input type="password" class="form-control" id="confirmarNovaSenha" name="confirmarNovaSenha" required minlength="6" 
                               placeholder="Confirme sua nova senha">
                        <div id="senhaMatch" class="form-text"></div>
                    </div>
                    

                    
                    <div class="d-flex justify-content-between align-items-center">
                        <a href="<%= returnUrl %>" class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-left me-1"></i>Voltar
                        </a>
                        <button type="submit" class="btn btn-primary" id="submitBtn" disabled>
                            <i class="fas fa-save me-1"></i>Alterar Senha
                        </button>
                    </div>
                </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.card {
    border-radius: 10px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
}

.card-header {
    background: linear-gradient(135deg, #667eea, #764ba2);
    border: none;
    border-radius: 10px 10px 0 0;
    padding: 1rem;
}

.form-control:focus {
    border-color: #667eea;
    box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
}

.btn-primary {
    background: linear-gradient(135deg, #667eea, #764ba2);
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: 500;
    transition: all 0.2s ease;
}

.btn-primary:hover:not(:disabled) {
    transform: translateY(-1px);
    box-shadow: 0 4px 8px rgba(102, 126, 234, 0.3);
}

.btn-primary:disabled {
    opacity: 0.6;
    cursor: not-allowed;
}

.btn-outline-secondary {
    border: 1px solid #6c757d;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: 500;
    transition: all 0.2s ease;
}

.btn-outline-secondary:hover {
    transform: translateY(-1px);
    box-shadow: 0 2px 4px rgba(108, 117, 125, 0.2);
}

@media (max-width: 768px) {
    .d-flex.justify-content-between {
        flex-direction: column;
        gap: 0.5rem;
    }
    
    .d-flex.justify-content-between .btn {
        width: 100%;
        text-align: center;
    }
}
</style>

<script>
// Validação simples
document.addEventListener('DOMContentLoaded', function() {
    const novaSenha = document.getElementById('novaSenha');
    const confirmarSenha = document.getElementById('confirmarNovaSenha');
    const senhaMatch = document.getElementById('senhaMatch');
    const submitBtn = document.getElementById('submitBtn');
    
    function validarSenhas() {
        const senha = novaSenha.value;
        const confirmacao = confirmarSenha.value;
        const senhaAtual = document.getElementById('senhaAtual').value;
        
        if (confirmacao === '') {
            senhaMatch.textContent = '';
            senhaMatch.className = 'form-text';
        } else if (senha === confirmacao) {
            senhaMatch.innerHTML = '<i class="fas fa-check-circle me-1"></i>Senhas coincidem';
            senhaMatch.className = 'form-text text-success';
        } else {
            senhaMatch.innerHTML = '<i class="fas fa-times-circle me-1"></i>Senhas não coincidem';
            senhaMatch.className = 'form-text text-danger';
        }
        
        // Habilitar/desabilitar botão
        const senhasValidas = senha.length >= 6 && senha === confirmacao && senhaAtual.length > 0;
        submitBtn.disabled = !senhasValidas;
    }
    
    novaSenha.addEventListener('input', validarSenhas);
    confirmarSenha.addEventListener('input', validarSenhas);
    document.getElementById('senhaAtual').addEventListener('input', validarSenhas);
    
    // Prevenir submit inválido
    document.getElementById('alterarSenhaForm').addEventListener('submit', function(e) {
        if (submitBtn.disabled) {
            e.preventDefault();
            alert('Preencha todos os campos corretamente.');
        }
    });
});
</script>