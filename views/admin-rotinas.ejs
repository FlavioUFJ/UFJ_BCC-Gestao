            async carregarVinculosUsuario(idPessoa) {
                if (!idPessoa) {
                    document.getElementById('modulosVinculo').style.display = 'none';
                    document.getElementById('vinculosAtuais').style.display = 'none';
                    return;
                }
                
                try {
                    const response = await fetch(`/admin/usuario-modulos/${idPessoa}`, {
                        headers: {
                            'Accept': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    });
                    
                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }
                    
                    const vinculos = await response.json();
                    
                    // Mostrar seções
                    document.getElementById('modulosVinculo').style.display = 'block';
                    document.getElementById('vinculosAtuais').style.display = 'block';
                    
                    // Limpar checkboxes
                    document.querySelectorAll('#checkboxModulos input[type="checkbox"]').forEach(cb => {
                        cb.checked = false;
                    });
                    
                    // Marcar módulos vinculados
                    vinculos.forEach(vinculo => {
                        const checkbox = document.getElementById(`modulo_${vinculo.id_modulo}`);
                        if (checkbox) {
                            checkbox.checked = vinculo.ativo;
                        }
                    });
                    
                    // Mostrar vínculos atuais
                    const tbody = document.getElementById('corpoVinculosAtuais');
                    tbody.innerHTML = vinculos.map(vinculo => `
                        <tr>
                            <td>
                                <i class="${vinculo.icone} me-2" style="color: ${vinculo.cor};"></i>
                                ${vinculo.nome_modulo}
                            </td>
                            <td>
                                <span class="badge bg-${vinculo.ativo ? 'success' : 'secondary'}">
                                    ${vinculo.ativo ? 'Ativo' : 'Inativo'}
                                </span>
                            </td>
                            <td>${new Date(vinculo.dataCadastro).toLocaleDateString('pt-BR')}</td>
                        </tr>
                    `).join('');
                    
                } catch (error) {
                    console.error('Erro ao carregar vínculos:', error);
                    AdminRotinas.mostrarMensagem('Erro ao carregar vínculos do usuário', 'error');
                }
            },
            
            async salvarVinculos() {
                const idPessoa = document.getElementById('usuarioVinculo').value;
                if (!idPessoa) {
                    AdminRotinas.mostrarMensagem('Selecione um usuário', 'error');
                    return;
                }
                
                const checkboxes = document.querySelectorAll('#checkboxModulos input[type="checkbox"]');
                const vinculos = Array.from(checkboxes).map(cb => ({
                    id_modulo: cb.value,
                    ativo: cb.checked
                }));
                
                try {
