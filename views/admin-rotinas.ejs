            async vincularPessoas(idModulo) {
                try {
                    // Buscar dados do módulo
                    const responseModulo = await fetch(`/admin/modulos/${idModulo}`);
                    const modulo = await responseModulo.json();
                    
                    if (!responseModulo.ok) {
                        AdminRotinas.mostrarMensagem(modulo.error || 'Erro ao carregar dados do módulo', 'error');
                        return;
                    }
                    
                    this.moduloAtual = modulo;
                    
                    // Atualizar título do modal
                    document.getElementById('tituloVincularPessoas').textContent = `Vincular Pessoas - ${modulo.nome}`;
                    
                    // Carregar pessoas vinculadas
                    await this.carregarPessoasVinculadas(idModulo);
                    
                    // Limpar busca
                    const buscaPessoaVinculo = document.getElementById('buscaPessoaVinculo');
                    const resultadosBusca = document.getElementById('resultadosBuscaPessoaVinculo');
                    if (buscaPessoaVinculo) buscaPessoaVinculo.value = '';
                    if (resultadosBusca) resultadosBusca.innerHTML = '';
                    
                    // Abrir modal
                    new bootstrap.Modal(document.getElementById('modalVincularPessoas')).show();
                    
                } catch (error) {
                    console.error('Erro ao abrir modal de vinculação:', error);
                    AdminRotinas.mostrarMensagem('Erro ao abrir modal de vinculação', 'error');
                }
