            selectPessoaLogin(id, nome) {
                document.getElementById('buscaPessoaLogin').value = nome;
                document.getElementById('pessoaLoginId').value = id;
                document.getElementById('resultadosBuscaPessoa').style.display = 'none';
                
                this.loadPessoaLoginData(id);
            },
            
            async loadPessoaLoginData(id) {
                try {
                    const response = await fetch(`/api/pessoas/${id}`);
                    const data = await response.json();
                    
                    if (data.success) {
                        const pessoa = data.pessoa;
                        
                        // Preencher dados da pessoa
                        document.getElementById('nomeCompleto').value = pessoa.nome;
                        document.getElementById('emailPessoa').value = pessoa.email;
                        
                        // Carregar dados de login se existirem
                        if (pessoa.login) {
                            document.getElementById('nivelAcesso').value = pessoa.login.nivelacesso;
                            document.getElementById('statusLogin').value = pessoa.login.status;
                        }
                        
                        // Mostrar informações da pessoa
                        document.getElementById('infosPessoa').innerHTML = `
                            <p><strong>Categoria:</strong> ${pessoa.categoria}</p>
                            <p><strong>CPF/CNPJ:</strong> ${pessoa.cnpj_cpf}</p>
                            <p><strong>Telefone:</strong> ${pessoa.telefone}</p>
                            <p><strong>Data Cadastro:</strong> ${new Date(pessoa.dataCadastro).toLocaleDateString('pt-BR')}</p>
                        `;
                        
                        document.getElementById('formLogin').style.display = 'block';
                    }
                } catch (error) {
                    console.error('Erro ao carregar dados:', error);
                    this.showError('Erro ao carregar dados da pessoa');
                }
            },
            
            async saveLoginData() {
                const pessoaId = document.getElementById('pessoaLoginId').value;
                const nivelAcesso = document.getElementById('nivelAcesso').value;
                const status = document.getElementById('statusLogin').value;
                const senha = document.getElementById('senhaLogin').value;
                
                if (!pessoaId || !nivelAcesso || !status) {
                    this.showError('Preencha todos os campos obrigatórios');
                    return;
                }
                
                try {
                    const response = await fetch(`/admin/criar-login`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            id_pessoa: pessoaId,
                            nivelacesso: nivelAcesso,
                            status: status,
                            senha: senha
                        })
                    });
                    
                    const data = await response.json();
                    
                    if (data.success) {
                        this.showSuccess('Dados de login salvos com sucesso!');
                        document.getElementById('senhaLogin').value = '';
                    } else {
                        this.showError('Erro ao salvar dados: ' + data.message);
                    }
                } catch (error) {
                    console.error('Erro:', error);
                    this.showError('Erro ao salvar dados de login');
                }
            },
            
            resetLoginForm() {
                document.getElementById('buscaPessoaLogin').value = '';
                document.getElementById('pessoaLoginId').value = '';
                document.getElementById('formLogin').style.display = 'none';
                document.getElementById('resultadosBuscaPessoa').style.display = 'none';
            },
            
