                }
            } else {
                console.warn('Resposta da API não contém dados válidos:', data);
                // Notificar usuário sobre a falta dos parâmetros
                console.warn('Link do WhatsApp não encontrado: parâmetro "Grupo WhatsApp" com valor "Link do Estágio" não configurado.');
                
                // Criar notificação visual para o usuário
                const alertDiv = document.createElement('div');
                alertDiv.className = 'alert alert-warning alert-dismissible fade show mt-3';
                alertDiv.innerHTML = `
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    <strong>Atenção!</strong> Link do grupo WhatsApp não configurado. Entre em contato com o administrador para configurar o parâmetro "Grupo WhatsApp" com valor "Link do Estágio".
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                `;
                
                // Inserir a notificação após o header
                const container = document.querySelector('.container.mt-4');
                const headerRow = container.querySelector('.row.mb-3');
                if (container && headerRow) {
                    headerRow.insertAdjacentElement('afterend', alertDiv);
                }
            }
        } catch (error) {
            console.error('Erro detalhado ao carregar link do WhatsApp:', error);
            
            // Notificar usuário sobre erro de conexão
            const alertDiv = document.createElement('div');
            alertDiv.className = 'alert alert-danger alert-dismissible fade show mt-3';
            alertDiv.innerHTML = `
                <i class="fas fa-exclamation-circle me-2"></i>
                <strong>Erro!</strong> Não foi possível carregar o link do grupo WhatsApp. Verifique sua conexão ou entre em contato com o suporte.
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            `;
            
            const container = document.querySelector('.container.mt-4');
            const headerRow = container.querySelector('.row.mb-3');
            if (container && headerRow) {
                headerRow.insertAdjacentElement('afterend', alertDiv);
            }
        }
    }

    // Funções específicas para Plano de Atividade
    function planAtiNavegar(direcao) {
        if (!planosAtividade || planosAtividade.length === 0) return;
        
        if (direcao === 'anterior') {
            planoAtividadeAtualIndex--;
        } else if (direcao === 'proximo') {
            planoAtividadeAtualIndex++;
        }
        
        if (planoAtividadeAtualIndex < 0) {
            planoAtividadeAtualIndex = planosAtividade.length - 1;
        } else if (planoAtividadeAtualIndex >= planosAtividade.length) {
            planoAtividadeAtualIndex = 0;
        }
        
        AdminDashboard.atualizarExibicaoPlanoAtividade();
    }
    
    function planAtiFiltrar() {
        const filtro = document.getElementById('planAtiBusca').value.toLowerCase().trim();
        
        if (!filtro) {
            // Se não há filtro, mostrar todos os planos
            AdminDashboard.atualizarExibicaoPlanoAtividade();
            return;
        }
        
        const planosFiltrados = planosAtividade.filter(plano => {
            return (plano.nome_estagiario && plano.nome_estagiario.toLowerCase().includes(filtro)) ||
                   (plano.nome_orientador && plano.nome_orientador.toLowerCase().includes(filtro)) ||
                   (plano.nome_supervisor && plano.nome_supervisor.toLowerCase().includes(filtro));
        });
        
        if (planosFiltrados.length === 0) {
            document.getElementById('cardPlanoAtividade').innerHTML = '<div class="text-center py-3"><i class="fas fa-search fa-2x text-muted mb-2"></i><p class="text-muted mb-0">Nenhum plano encontrado</p></div>';
            return;
        }
        
        // Temporariamente substituir os dados para exibição filtrada
        const planosOriginais = [...planosAtividade];
        planosAtividade = planosFiltrados;
        planoAtividadeAtualIndex = 0;
        AdminDashboard.atualizarExibicaoPlanoAtividade();
    }
    
    function mostrarLoadingPlanoAtividade(mostrar) {
        const cardBody = document.getElementById('cardPlanoAtividade');
        if (mostrar) {
            cardBody.innerHTML = `
                <div class="text-center py-3">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Carregando...</span>
                    </div>
                    <p class="text-muted mt-2 mb-0">Carregando planos de atividade...</p>
                </div>
            `;
        }
    }

    document.addEventListener('DOMContentLoaded', function() {
        if (registrosOriginais.length > 0) {
            atualizarExibicaoRegistro();
        }
        // Carregar link do WhatsApp
        carregarLinkWhatsApp();
    });

</script>

