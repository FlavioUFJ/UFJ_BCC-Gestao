    // Função auxiliar para aprovar plano
    async function aprovarPlano(id) {
        try {
            mostrarLoadingPlanoAtividade(true);
            
            const response = await fetch(`/planos-atividade/${id}`, {
                method: 'PUT',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    situacao: 'Aprovado',
                    data_fechamento: new Date().toISOString().slice(0, 19).replace('T', ' ')
                })
            });
            
            const result = await response.json();
            
            if (result.success) {
                mostrarAlertaPlanoAtividade('success', 'Plano de atividade aprovado com sucesso!');
                await carregarPlanosAtividade(null, true);
            } else {
                mostrarAlertaPlanoAtividade('error', result.message || 'Erro ao aprovar plano de atividade');
            }
        } catch (error) {
            console.error('Erro ao aprovar plano:', error);
            mostrarAlertaPlanoAtividade('error', 'Erro ao aprovar plano de atividade');
        } finally {
            mostrarLoadingPlanoAtividade(false);
        }
    }
    
