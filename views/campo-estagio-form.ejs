                window.pessoaManager.abrirModal(hiddenInputId, function(id, nome) {
                    document.getElementById(hiddenInputId).value = id;
                    document.getElementById(nomeInputId).value = nome;
                }, {
                    categoriaAutomatica: categoria,
                    showTabs: true,
