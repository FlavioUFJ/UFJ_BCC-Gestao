    // Função para atualizar exibição da frequência
    function atualizarExibicaoFrequencia() {
        if (!frequencias || frequencias.length === 0) {
            // Verificar se há plano de atividade selecionado para mostrar mensagem específica
            if (planoAtividadeSelecionadoId) {
                mostrarFrequenciaSemDados('Não existe frequência iniciada para lançamento.');
            } else {
                mostrarFrequenciaSemDados('Selecione um plano de atividade para visualizar as frequências');
            }
            return;
        }
        
        // Usar frequências filtradas se houver filtro ativo
        const frequenciasParaExibir = frequenciasFiltradas.length > 0 ? frequenciasFiltradas : frequencias;
        
        if (frequenciasParaExibir.length === 0) {
            // Verificar se há plano de atividade selecionado para mostrar mensagem específica
            if (planoAtividadeSelecionadoId) {
                mostrarFrequenciaSemDados('Não existe frequência iniciada para lançamento.');
            } else {
                mostrarFrequenciaSemDados('Selecione um plano de atividade para visualizar as frequências');
            }
            return;
        }
        
        // Garantir que o índice está dentro dos limites
        if (frequenciaAtualIndex >= frequenciasParaExibir.length) {
            frequenciaAtualIndex = 0;
        }
        
        const frequencia = frequenciasParaExibir[frequenciaAtualIndex];
        frequenciaSelecionadaId = frequencia.id_campo_estagio_frequencia;
        
        // Mostrar dados e ocultar loading
        document.getElementById('frequenciaLoading').style.display = 'none';
        document.getElementById('frequenciaSemDados').style.display = 'none';
        document.getElementById('frequenciaData').style.display = 'block';
        
        // Atualizar informações na interface
        document.getElementById('frequenciaNomeEstagiario').textContent = frequencia.nome_estagiario || 'N/A';
        document.getElementById('frequenciaMesReferencia').textContent = frequencia.mesdereferencia || 'N/A';
        
        // Formatar datas
        const dataAbertura = frequencia.data_abertura ? new Date(frequencia.data_abertura).toLocaleDateString('pt-BR', { day: '2-digit', month: '2-digit', year: '2-digit' }) : 'N/A';
        const dataEncerramento = frequencia.data_encerramento ? new Date(frequencia.data_encerramento).toLocaleDateString('pt-BR', { day: '2-digit', month: '2-digit', year: '2-digit' }) : 'N/A';
        
        document.getElementById('frequenciaDataAbertura').textContent = dataAbertura;
        document.getElementById('frequenciaDataEncerramento').textContent = dataEncerramento;
        
        // Total de horas
        document.getElementById('frequenciaTotalHoras').textContent = frequencia.total_hora_mesreferencia || '00:00';
        
        // Status de aprovações com cores
        const aprovadoEstagiario = document.getElementById('frequenciaAprovadoEstagiario');
        const aprovadoOrientador = document.getElementById('frequenciaAprovadoOrientador');
        const aprovadoSupervisor = document.getElementById('frequenciaAprovadoSupervisor');
        
        // Função auxiliar para definir badge
        function definirBadge(elemento, valor) {
            elemento.textContent = valor || 'Não';
            elemento.className = 'badge';
            if (valor === 'Sim') {
                elemento.classList.add('bg-success');
            } else {
                elemento.classList.add('bg-danger');
            }
        }
        
        definirBadge(aprovadoEstagiario, frequencia.aprovado_estagiario);
        definirBadge(aprovadoOrientador, frequencia.aprovado_orientador);
        definirBadge(aprovadoSupervisor, frequencia.aprovado_supervisor);
        
        // Verificar se há pelo menos uma aprovação
        const temAprovacao = frequencia.aprovado_estagiario === 'Sim' || 
                           frequencia.aprovado_orientador === 'Sim' || 
                           frequencia.aprovado_supervisor === 'Sim';
        
        // Verificar categoria do usuário para edição
        const userCategoria = '<%= user.categoria %>';
        const podeEditarPorCategoria = userCategoria === '1' || userCategoria === '2' || userCategoria === '5'; // Coordenador, Professor/Orientador ou Supervisor
        
        // Controlar botões Editar e Lançar Dia baseado nas aprovações e categoria
        const btnEditar = document.getElementById('btnFreqAtiEditar');
        const btnLancar = document.getElementById('btnFreqAtiLancar');
        
        if (temAprovacao) {
            // Desabilitar botões quando há aprovação
            btnEditar.disabled = true;
            btnLancar.disabled = true;
            btnEditar.title = 'Não é possível editar frequência com aprovação';
            btnLancar.title = 'Não é possível lançar dias em frequência com aprovação';
            btnEditar.classList.remove('btn-outline-primary');
            btnEditar.classList.add('btn-outline-secondary');
            btnLancar.classList.remove('btn-warning');
            btnLancar.classList.add('btn-outline-secondary');
        } else if (!podeEditarPorCategoria) {
            // Desabilitar botões quando usuário não tem permissão por categoria
            btnEditar.disabled = true;
            btnLancar.disabled = true;
            btnEditar.title = 'Apenas Coordenadores, Supervisores e Orientadores podem editar frequências';
            btnLancar.title = 'Apenas Coordenadores, Supervisores e Orientadores podem lançar dias';
            btnEditar.classList.remove('btn-outline-primary');
            btnEditar.classList.add('btn-outline-secondary');
            btnLancar.classList.remove('btn-warning');
            btnLancar.classList.add('btn-outline-secondary');
        } else {
            // Habilitar botões quando não há aprovação e usuário tem permissão
            btnEditar.disabled = false;
            btnLancar.disabled = false;
            btnEditar.title = 'Editar frequência selecionada';
            btnLancar.title = 'Lançar dia na frequência selecionada';
            btnEditar.classList.remove('btn-outline-secondary');
            btnEditar.classList.add('btn-outline-primary');
            btnLancar.classList.remove('btn-outline-secondary');
            btnLancar.classList.add('btn-warning');
