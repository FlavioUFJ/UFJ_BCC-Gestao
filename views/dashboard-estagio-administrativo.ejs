                <td>${plano.estagiario_nome || 'N/A'}</td>
                <td>${plano.supervisor_nome || 'N/A'}</td>
                <td>${plano.orientador_nome || 'N/A'}</td>
                <td>
                    <span class="badge ${this.getSituacaoBadgeClass(plano.pa_situacao)}">${plano.pa_situacao || 'N/A'}</span>
                </td>
                <td>
                    <span class="badge bg-primary">
                        ${plano.pa_cargahoraria || 'N/A'}h
                    </span>
                </td>
                <td class="text-center">
                    ${temAnexo ? 
                        `<a href="${plano.pa_url_planoassinado}" target="_blank" class="btn btn-sm btn-success" title="Baixar Plano de Atividade">
                            <i class="fas fa-download"></i> Baixar
                        </a>` : 
                        '<span class="text-muted">-</span>'
                    }
                </td>
                <td>
                    <span class="anexo-sei-toggle" 
                          data-plano-id="${plano.pa_id_planoatividade}" 
                          style="cursor: pointer; font-weight: bold; color: ${plano.pa_plano_anexado_sei === 'Sim' ? '#006400' : '#8B0000'};"
                          title="Clique para mudar de valor"
                          onclick="DashboardAdmin.toggleAnexoSei(${plano.pa_id_planoatividade}, this)">
                        ${plano.pa_plano_anexado_sei || 'Não'}
                    </span>
                </td>
            `;
            
            tbody.appendChild(tr);
        });
        
        // Aplicar filtros após renderizar
        this.filtrarPlanosIndependente();
    },

    getSituacaoBadgeClass(situacao) {
        switch(situacao) {
            case 'Em Edição':
                return 'bg-warning text-dark';
            case 'Em Aprovação':
                return 'bg-info';
            case 'Aprovado sem Anexo':
                return 'bg-success';
            case 'Aprovado com Anexo':
                return 'bg-primary';
            default:
                return 'bg-secondary';
        }
    },

    async carregarFrequenciasIndependente() {
        console.log('[DEBUG] Carregando frequências independentes...');
        try {
            console.log('[DEBUG] Fazendo fetch para /secure/estagios/dashboard-administrativo/frequencias-independente');
            const response = await fetch('/secure/estagios/dashboard-administrativo/frequencias-independente');
            const dados = await response.json();
            
            if (dados.success) {
                console.log('[DEBUG] Frequências carregadas com sucesso:', dados.data.length, 'registros');
                this.renderizarTabelaFrequenciasIndependente(dados.data);
            } else {
                console.error('[DEBUG] Erro na resposta:', dados.message);
            }
        } catch (error) {
            console.error('Erro ao carregar frequências independentes:', error);
        }
    },

    renderizarTabelaFrequenciasIndependente(frequencias) {
        const tbody = document.getElementById('corpoTabelaFrequenciasIndependente');
        tbody.innerHTML = '';
        
        if (frequencias.length === 0) {
            tbody.innerHTML = `
                <tr>
                    <td colspan="10" class="text-center text-muted py-4">
                        <i class="fas fa-inbox me-2"></i>Nenhuma frequência encontrada
                    </td>
                </tr>
            `;
            return;
        }
        
        frequencias.forEach(freq => {
            const tr = document.createElement('tr');
            tr.dataset.aprovadoEstagiario = freq.caf_aprovado_estagiario;
            tr.dataset.aprovadoOrientador = freq.caf_aprovado_orientador;
            tr.dataset.aprovadoSupervisor = freq.caf_aprovado_supervisor;
            tr.dataset.categoria = freq.estagiario_categoria;
            tr.dataset.anexadoSei = freq.caf_frenquencia_anexado_sei || 'Não';
            
            // Determinar se está pendente
            const isPendente = freq.caf_aprovado_estagiario !== 'Sim' || 
                              freq.caf_aprovado_orientador !== 'Sim' || 
                              freq.caf_aprovado_supervisor !== 'Sim';
            tr.dataset.pendente = isPendente ? 'sim' : 'nao';
            
            tr.innerHTML = `
                <td>${freq.estagiario_nome || 'N/A'}</td>
                <td>${freq.supervisor_nome || 'N/A'}</td>
                <td>${freq.orientador_nome || 'N/A'}</td>
                <td>${freq.caf_mesdereferencia || 'N/A'}</td>
                <td>${freq.caf_total_hora_mesreferencia || '0'}h</td>
                <td>
                    <span class="badge ${freq.caf_aprovado_estagiario === 'Sim' ? 'bg-success' : 'bg-secondary'}">
                        ${freq.caf_aprovado_estagiario || 'Não'}
                    </span>
                </td>
                <td>
                    <span class="badge ${freq.caf_aprovado_orientador === 'Sim' ? 'bg-success' : 'bg-secondary'}">
                        ${freq.caf_aprovado_orientador || 'Não'}
                    </span>
                </td>
                <td>
                    <span class="badge ${freq.caf_aprovado_supervisor === 'Sim' ? 'bg-success' : 'bg-secondary'}">
                        ${freq.caf_aprovado_supervisor || 'Não'}
                    </span>
                </td>
                <td>
                    <span class="badge ${freq.caf_frenquencia_anexado_sei === 'Sim' ? 'bg-success' : 'bg-secondary'}">
                        ${freq.caf_frenquencia_anexado_sei || 'Não'}
                    </span>
                </td>
                <td>
                    <button class="btn btn-sm btn-outline-primary" onclick="DashboardAdmin.editarFrequencia(${freq.caf_id_campo_estagio_frequencia || 0})">
                        <i class="fas fa-edit"></i>
                    </button>
                </td>
            `;
            
            tbody.appendChild(tr);
        });
        
        // Aplicar filtros após renderizar
        this.filtrarFrequenciasIndependente();
    },

    filtrarPlanosIndependente() {
        const situacaoEmEdicao = document.getElementById('filtroSituacaoEmEdicao')?.checked || false;
        const situacaoEmAprovacao = document.getElementById('filtroSituacaoEmAprovacao')?.checked || false;
        const situacaoAprovadoSemAnexo = document.getElementById('filtroSituacaoAprovadoSemAnexo')?.checked || false;
        const situacaoAprovadoComAnexo = document.getElementById('filtroSituacaoAprovadoComAnexo')?.checked || false;
        const categoria = document.getElementById('filtroCategoriaPessoa')?.value || '';
        const nomePesquisa = document.getElementById('filtroNomePessoa')?.value.toLowerCase().trim() || '';
        
        const linhas = document.querySelectorAll('#tabelaPlanosIndependente tbody tr');
        let registrosVisiveis = 0;
        
        linhas.forEach(linha => {
            if (linha.children.length === 1) return; // Pular linha de "nenhum resultado"
            
            const situacao = linha.dataset.situacao;
            const categoriaLinha = linha.dataset.categoria;
            
            let mostrar = true;
            
            // Filtro por situação
            const situacaoValida = 
                (situacaoEmEdicao && situacao === 'Em Edição') ||
                (situacaoEmAprovacao && situacao === 'Em Aprovação') ||
                (situacaoAprovadoSemAnexo && situacao === 'Aprovado sem Anexo') ||
                (situacaoAprovadoComAnexo && situacao === 'Aprovado com Anexo');
            
            if (!situacaoValida) mostrar = false;
            
            // Filtro por categoria - corrigido para funcionar com valores específicos
            if (mostrar && categoria && categoria !== '') {
                // Mapear categorias do select para os valores do dataset
                let categoriaComparacao = '';
                if (categoria === 'Estagiário' && categoriaLinha === '3') categoriaComparacao = categoria;
                else if (categoria === 'Professor' && (categoriaLinha === '2' || categoriaLinha === '2,5')) categoriaComparacao = categoria;
                else if (categoria === 'Supervisor' && categoriaLinha === '5') categoriaComparacao = categoria;
                
                mostrar = categoriaComparacao === categoria;
                
                // Filtro por nome quando categoria específica está selecionada
                if (mostrar && nomePesquisa) {
                    let nomeParaComparar = '';
                    
                    // Obter o nome da pessoa baseado na categoria selecionada
                    if (categoria === 'Estagiário') {
                        nomeParaComparar = linha.children[0]?.textContent.toLowerCase() || ''; // Coluna Estagiário
                    } else if (categoria === 'Professor') {
                        nomeParaComparar = linha.children[2]?.textContent.toLowerCase() || ''; // Coluna Orientador
                    } else if (categoria === 'Supervisor') {
                        nomeParaComparar = linha.children[1]?.textContent.toLowerCase() || ''; // Coluna Supervisor
                    }
                    
                    mostrar = nomeParaComparar.includes(nomePesquisa);
                }
            }
            
            // Filtro por Anexado SEI
            if (mostrar) {
                const anexadoSEISim = document.getElementById('filtroAnexadoSEISim')?.checked || false;
                const anexadoSEINao = document.getElementById('filtroAnexadoSEINao')?.checked || false;
                
                if (!anexadoSEISim && !anexadoSEINao) {
                    mostrar = false; // Se nenhum filtro SEI estiver marcado, não mostrar nada
                } else {
                    const anexadoSEI = linha.dataset.anexadoSei; // Assumindo que existe este dataset
                    const isSim = anexadoSEI === 'Sim';
                    const isNao = anexadoSEI === 'Não';
                    
                    mostrar = (anexadoSEISim && isSim) || (anexadoSEINao && isNao);
                }
            }
            
            // Filtro por Anexado SEI
            if (mostrar) {
                const anexadoSEISimFreq = document.getElementById('filtroAnexadoSEISimFreq')?.checked || false;
                const anexadoSEINaoFreq = document.getElementById('filtroAnexadoSEINaoFreq')?.checked || false;
                
                if (!anexadoSEISimFreq && !anexadoSEINaoFreq) {
                    mostrar = false; // Se nenhum filtro SEI estiver marcado, não mostrar nada
                } else {
                    const anexadoSEI = linha.dataset.anexadoSei; // Assumindo que existe este dataset
                    const isSim = anexadoSEI === 'Sim';
                    const isNao = anexadoSEI === 'Não';
                    
                    mostrar = (anexadoSEISimFreq && isSim) || (anexadoSEINaoFreq && isNao);
                }
            }
            
            linha.style.display = mostrar ? '' : 'none';
            if (mostrar) registrosVisiveis++;
        });
        
        // Atualizar contador
        document.getElementById('contadorRegistrosPlanos').textContent = registrosVisiveis;
    },

    filtrarFrequenciasIndependente() {
        const aprovadoEstagiario = document.getElementById('filtroAprovadoEstagiario').checked;
        const aprovadoOrientador = document.getElementById('filtroAprovadoOrientador').checked;
        const aprovadoSupervisor = document.getElementById('filtroAprovadoSupervisor').checked;
        const pendentes = document.getElementById('filtroPendentes').checked;
        const categoria = document.getElementById('filtroCategoriaFreq').value;
        const anexadoSEISimFreq = document.getElementById('filtroAnexadoSEISimFreq')?.checked || false;
        const anexadoSEINaoFreq = document.getElementById('filtroAnexadoSEINaoFreq')?.checked || false;
        
        const linhas = document.querySelectorAll('#tabelaFrequenciasIndependente tbody tr');
        let registrosVisiveis = 0;
        
        linhas.forEach(linha => {
            if (linha.children.length === 1) return; // Pular linha de "nenhum resultado"
            
            const aprovEstagiario = linha.dataset.aprovadoEstagiario;
            const aprovOrientador = linha.dataset.aprovadoOrientador;
            const aprovSupervisor = linha.dataset.aprovadoSupervisor;
            const isPendente = linha.dataset.pendente === 'sim';
            const categoriaLinha = linha.dataset.categoria;
            
            let mostrar = false;
            
            // Filtro por status de aprovação
            if (aprovadoEstagiario && aprovEstagiario === 'Sim') mostrar = true;
            if (aprovadoOrientador && aprovOrientador === 'Sim') mostrar = true;
            if (aprovadoSupervisor && aprovSupervisor === 'Sim') mostrar = true;
            if (pendentes && isPendente) mostrar = true;
            
            // Se nenhum filtro de status estiver marcado, não mostrar nada
            if (!aprovadoEstagiario && !aprovadoOrientador && !aprovadoSupervisor && !pendentes) {
                mostrar = false;
            }
            
            // Filtro por categoria
            if (mostrar && categoria && categoria !== '') {
                // Mapear categorias para comparação
                let categoriaComparacao = '';
                if (categoria === 'Estagiário' && categoriaLinha === '3') categoriaComparacao = categoria;
                else if (categoria === 'Professor' && (categoriaLinha === '2' || categoriaLinha === '2,5')) categoriaComparacao = categoria;
                else if (categoria === 'Supervisor' && categoriaLinha === '5') categoriaComparacao = categoria;
                
                mostrar = categoriaComparacao === categoria;
            }
            
            // Filtro por nome (quando uma categoria específica está selecionada)
            if (mostrar && categoria && categoria !== '') {
                const termoPesquisa = document.getElementById('filtroNomeFreq').value.toLowerCase().trim();
                if (termoPesquisa) {
                    // Determinar qual coluna de nome verificar baseado na categoria
                    let colunaIndice = -1;
                    if (categoria === 'Estagiário') colunaIndice = 0; // Nome do estagiário
                    else if (categoria === 'Supervisor') colunaIndice = 1; // Nome do supervisor
                    else if (categoria === 'Professor') colunaIndice = 2; // Nome do professor
                    
                    if (colunaIndice >= 0 && linha.children[colunaIndice]) {
                        const nomeColuna = linha.children[colunaIndice].textContent.toLowerCase();
                        mostrar = nomeColuna.includes(termoPesquisa);
                    }
                }
            }
            
            // Filtro "Anexado SEI"
            if (mostrar && (anexadoSEISimFreq || anexadoSEINaoFreq)) {
                const anexadoSEI = linha.dataset.anexadoSei;
                const isSim = anexadoSEI === 'Sim';
                const isNao = anexadoSEI === 'Não';
                
                mostrar = (anexadoSEISimFreq && isSim) || (anexadoSEINaoFreq && isNao);
            }
            
            linha.style.display = mostrar ? '' : 'none';
            if (mostrar) registrosVisiveis++;
        });
        
        // Atualizar contador
        document.getElementById('contadorRegistrosFrequencias').textContent = registrosVisiveis;
    },

    editarFrequencia(frequenciaId) {
        if (frequenciaId && frequenciaId > 0) {
            window.open(`/frequencias/${frequenciaId}/editar`, '_blank');
        } else {
            alert('ID da frequência inválido');
        }
    }
};

// Inicializar quando o DOM estiver carregado
document.addEventListener('DOMContentLoaded', () => {
    DashboardAdmin.init();
});
</script>