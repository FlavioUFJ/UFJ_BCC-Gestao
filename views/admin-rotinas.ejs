    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Namespace para organizar o código
        const AdminRotinas = {
            // Variáveis de controle
            modalAberto: false, // Prevenir múltiplas aberturas

            // Inicialização
            init() {
                this.setupEventListeners();
                this.setupModalEventListeners();
            },

            // Configurar event listeners principais
            setupEventListeners() {
                // Formulários
                document.getElementById('alterarSenhaForm')?.addEventListener('submit', (e) => this.alterarSenha(e));

                // Backup
                document.getElementById('criarBackupBtn')?.addEventListener('click', () => this.criarBackup());
                document.getElementById('listarBackupsBtn')?.addEventListener('click', () => this.listarBackups());
                document.getElementById('atualizarBackupsBtn')?.addEventListener('click', () => this.listarBackups());
            },

            // Configurar event listeners do modal
            setupModalEventListeners() {
                // Configurações específicas para outros modais podem ser adicionadas aqui
            },



            // Funcionalidades de administração
            alterarSenha(e) {
                e.preventDefault();
                
                console.log('DEBUG - Função alterarSenha chamada');
                
                // Capturar dados diretamente dos campos
                const email = document.getElementById('emailAlterarSenha').value;
                const novaSenha = document.getElementById('novaSenha').value;
                
                console.log('DEBUG - Dados capturados:', { email, novaSenhaLength: novaSenha?.length });
                
                if (!email || !novaSenha) {
                    this.showAlert('Por favor, preencha todos os campos', 'error');
                    return;
                }
                
                this.showLoading(true);
                
                // Usar JSON em vez de FormData
                fetch('/admin/alterar-senha', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ email, novaSenha })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        e.target.reset();
                        this.showAlert('Senha alterada com sucesso!', 'success');
                    } else {
                        this.showAlert('Erro: ' + data.message, 'error');
                    }
                })
                .catch(error => {
                    console.error('Erro:', error);
                    this.showAlert('Erro ao alterar senha.', 'error');
                })
                .finally(() => {
                    this.showLoading(false);
                });
            },



            // Funcionalidades de backup
            criarBackup() {
                const btn = document.getElementById('criarBackupBtn');
                const originalText = btn.innerHTML;
                
                btn.disabled = true;
                btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Criando...';
                
                fetch('/admin/criar-backup', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        this.showAlert('Backup criado com sucesso: ' + data.fileName, 'success');
                        this.listarBackups();
                    } else {
                        this.showAlert('Erro ao criar backup: ' + data.message, 'error');
                    }
                })
                .catch(error => {
                    console.error('Erro:', error);
                    this.showAlert('Erro ao criar backup', 'error');
                })
                .finally(() => {
                    btn.disabled = false;
                    btn.innerHTML = originalText;
                });
            },

            listarBackups() {
                fetch('/admin/listar-backups')
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        const container = document.getElementById('backupsContainer');
                        const lista = document.getElementById('backupsList');
                        
                        if (data.backups.length === 0) {
                            lista.innerHTML = '<p class="text-muted">Nenhum backup encontrado.</p>';
                        } else {
                            let html = '<div class="table-responsive"><table class="table table-striped"><thead><tr><th>Nome do Arquivo</th><th>Data/Hora</th><th>Tamanho</th><th>Ações</th></tr></thead><tbody>';
                            
                            data.backups.forEach(backup => {
                                html += `
                                    <tr>
                                        <td><i class="fas fa-database me-2"></i>${backup.fileName}</td>
                                        <td>${backup.date}</td>
                                        <td>${backup.size}</td>
                                        <td>
                                            <button class="btn btn-sm btn-success me-2" onclick="AdminRotinas.restaurarBackup('${backup.fileName}')">
                                                <i class="fas fa-history me-1"></i>Restaurar
                                            </button>
                                            <a href="/admin/download-backup/${backup.fileName}" class="btn btn-sm btn-outline-primary">
                                                <i class="fas fa-download me-1"></i>Download
                                            </a>
                                        </td>
                                    </tr>
                                `;
                            });
                            
                            html += '</tbody></table></div>';
                            lista.innerHTML = html;
                        }
                        
                        container.style.display = 'block';
                    } else {
                        this.showAlert('Erro ao listar backups: ' + data.message, 'error');
                    }
                })
                .catch(error => {
                    console.error('Erro:', error);
                    this.showAlert('Erro ao listar backups', 'error');
                });
            },

            restaurarBackup(fileName) {
                if (confirm(`Tem certeza que deseja restaurar o backup "${fileName}"? Os dados atuais serão substituídos!`)) {
                    this.showLoading(true);
                    
                    fetch('/admin/restaurar-backup', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({ backupFileName: fileName })
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            this.showAlert('Backup restaurado com sucesso! Backup atual salvo como: ' + data.currentBackup, 'success');
                            this.listarBackups();
                            setTimeout(() => location.reload(), 2000);
                        } else {
                            this.showAlert('Erro ao restaurar backup: ' + data.message, 'error');
                        }
                    })
                    .catch(error => {
                        console.error('Erro:', error);
                        this.showAlert('Erro ao restaurar backup', 'error');
                    })
                    .finally(() => {
                        this.showLoading(false);
                    });
                }
            },

            // Utilitários de UI
            showAlert(message, type = 'info') {
                // Remove alertas existentes
                const existingAlerts = document.querySelectorAll('.alert-temp');
                existingAlerts.forEach(alert => alert.remove());
                
                const alertClass = {
                    'success': 'alert-success',
                    'error': 'alert-danger',
                    'warning': 'alert-warning',
                    'info': 'alert-info'
                }[type] || 'alert-info';
                
                const icon = {
                    'success': 'fas fa-check-circle',
                    'error': 'fas fa-exclamation-circle',
                    'warning': 'fas fa-exclamation-triangle',
                    'info': 'fas fa-info-circle'
                }[type] || 'fas fa-info-circle';
                
                const alertDiv = document.createElement('div');
                alertDiv.className = `alert ${alertClass} alert-dismissible fade show alert-temp`;
                alertDiv.innerHTML = `
                    <i class="${icon} me-2"></i>${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                `;
                
                const container = document.querySelector('.container-fluid');
                const firstChild = container.firstElementChild;
                container.insertBefore(alertDiv, firstChild);
                
                // Auto-remove após 5 segundos
                setTimeout(() => {
                    if (alertDiv.parentNode) {
                        alertDiv.remove();
                    }
                }, 5000);
            },

            showLoading(show) {
                const body = document.body;
                if (show) {
                    body.classList.add('loading');
                } else {
                    body.classList.remove('loading');
                }
            },

            // Alias para compatibilidade
            mostrarMensagem(message, type = 'info') {
                this.showAlert(message, type);
            }
        };

        // ===== FUNCIONALIDADE DA ABA PESSOAS =====
        console.log('Definindo GerenciadorPessoas...');
        const GerenciadorPessoas = {
            paginaAtual: 1,
            totalPaginas: 1,
            itensPorPagina: 25,
            
            init() {
                this.bindEvents();
                this.buscarPessoas(); // Carregar primeiros 25 registros
            },
            
            bindEvents() {
                // Busca por Enter
                document.getElementById('buscaPessoa').addEventListener('keypress', (e) => {
                    if (e.key === 'Enter') {
                        this.buscarPessoas();
                    }
                });
                
                // Busca por botão
                document.getElementById('btnBuscarPessoa').addEventListener('click', () => {
                    this.buscarPessoas();
                });
                

                
                // Mudança de categoria
                document.getElementById('categoriaPessoa').addEventListener('change', () => {
                    this.buscarPessoas();
                });
            },
            
            buscarPessoas(pagina = 1) {
                const termo = document.getElementById('buscaPessoa').value.trim();
                const categoria = document.getElementById('categoriaPessoa').value;
                
                this.paginaAtual = pagina;
                
                const params = new URLSearchParams({
                    termo: termo,
                    categoria: categoria,
                    pagina: pagina,
                    limite: this.itensPorPagina
                });
                
                fetch(`/api/pessoas/buscar?${params}`)
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            this.renderizarTabela(data.pessoas);
                            this.renderizarPaginacao(data.total);
                        } else {
                            this.mostrarErro('Erro ao buscar pessoas: ' + data.message);
                        }
                    })
                    .catch(error => {
                        console.error('Erro:', error);
                        this.mostrarErro('Erro ao buscar pessoas');
                    });
            },
            
            renderizarTabela(pessoas) {
                const tbody = document.getElementById('corpoTabelaPessoas');
                
                if (!pessoas || pessoas.length === 0) {
                    tbody.innerHTML = `
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                <i class="fas fa-users fa-2x mb-2"></i><br>
                                Nenhuma pessoa encontrada
                            </td>
                        </tr>
                    `;
                    return;
                }
                
                let html = '';
                pessoas.forEach(pessoa => {
                    html += `
                        <tr>
                            <td>${pessoa.nome || ''}</td>
                            <td>${pessoa.email || ''}</td>
                            <td>${pessoa.telefone || ''}</td>
                            <td>${this.formatarCategoria(pessoa.categoria)}</td>
                            <td>${pessoa.cnpj_cpf || ''}</td>
                            <td>
                                <button class="btn btn-sm btn-primary me-1" onclick="console.log('Botão clicado para ID:', ${pessoa.id_pessoa}); GerenciadorPessoas.editarPessoa(${pessoa.id_pessoa})">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <button class="btn btn-sm btn-danger" onclick="GerenciadorPessoas.excluirPessoa(${pessoa.id_pessoa}, '${pessoa.nome}')">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    `;
                });
                
                tbody.innerHTML = html;
            },
            
            renderizarPaginacao(total) {
                this.totalPaginas = Math.ceil(total / this.itensPorPagina);
                const paginacao = document.getElementById('paginacaoPessoas');
                
                if (this.totalPaginas <= 1) {
                    paginacao.style.display = 'none';
                    return;
                }
                
                paginacao.style.display = 'block';
                const ul = paginacao.querySelector('ul');
                
                let html = '';
                
                // Botão anterior
                html += `
                    <li class="page-item ${this.paginaAtual === 1 ? 'disabled' : ''}">
                        <a class="page-link" href="#" onclick="GerenciadorPessoas.buscarPessoas(${this.paginaAtual - 1})">
                            <i class="fas fa-chevron-left"></i>
                        </a>
                    </li>
                `;
                
                // Páginas
                for (let i = 1; i <= this.totalPaginas; i++) {
                    if (i === 1 || i === this.totalPaginas || (i >= this.paginaAtual - 2 && i <= this.paginaAtual + 2)) {
                        html += `
                            <li class="page-item ${i === this.paginaAtual ? 'active' : ''}">
                                <a class="page-link" href="#" onclick="GerenciadorPessoas.buscarPessoas(${i})">${i}</a>
                            </li>
                        `;
                    } else if (i === this.paginaAtual - 3 || i === this.paginaAtual + 3) {
                        html += '<li class="page-item disabled"><span class="page-link">...</span></li>';
                    }
                }
                
                // Botão próximo
                html += `
                    <li class="page-item ${this.paginaAtual === this.totalPaginas ? 'disabled' : ''}">
                        <a class="page-link" href="#" onclick="GerenciadorPessoas.buscarPessoas(${this.paginaAtual + 1})">
                            <i class="fas fa-chevron-right"></i>
                        </a>
                    </li>
                `;
                
                ul.innerHTML = html;
            },
            
            formatarCategoria(categoria) {
                const categorias = {
                    1: 'Coordenador',
                    2: 'Professor Orientador',
                    3: 'Aluno/Estagiário',
                    4: 'Concedente/Local de Estágio',
                    5: 'Supervisor',
                    6: 'Curso/Instituição de Ensino',
                    99: 'Usuário Geral'
                };
                return categorias[categoria] || 'Categoria não definida';
            },
            

            
            async editarPessoa(id) {
                console.log('editarPessoa chamada com ID:', id);
                console.log('pessoaManager disponível:', typeof window.pessoaManager);
                try {
                    // Buscar dados da pessoa
                    const response = await fetch(`/api/pessoas/${id}`);
                    const result = await response.json();
                    
                    if (result.success) {
                        // Abrir modal em modo de edição
                        pessoaManager.abrirModal('', function(editedId, editedNome) {
                             // Após editar, recarregar a lista de pessoas com delay para evitar conflitos
                             setTimeout(() => {
                                 GerenciadorPessoas.buscarPessoas();
                             }, 100);
                         }, {
                             showBuscarTab: false,
                             showTabs: false,
                             submitButtonText: 'Salvar',
                             modalTitle: 'Editar Pessoa',
                             editMode: true,
                             personData: result.pessoa
                         });
                    } else {
                        console.error('Erro ao carregar dados da pessoa:', result.message);
                    }
                } catch (error) {
                    console.error('Erro ao buscar pessoa:', error);
                    console.error('Erro ao carregar dados da pessoa');
                }
            },
            
            excluirPessoa(id, nome) {
                if (confirm(`Tem certeza que deseja excluir a pessoa "${nome}"?`)) {
                    fetch(`/api/pessoas/${id}`, {
                        method: 'DELETE'
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            this.buscarPessoas(this.paginaAtual);
                            AdminRotinas.showAlert('Pessoa excluída com sucesso!', 'success');
                        } else {
                            this.mostrarErro('Erro ao excluir pessoa: ' + data.message);
                        }
                    })
                    .catch(error => {
                        console.error('Erro:', error);
                        this.mostrarErro('Erro ao excluir pessoa');
                    });
                }
            },
            
            mostrarErro(mensagem) {
                AdminRotinas.showAlert(mensagem, 'error');
            }
        };

        // Inicializar quando o DOM estiver carregado
        // Event listener consolidado removido - será usado o do final do arquivo
    </script>
    
    <!-- Script do gerenciador de pessoas -->
