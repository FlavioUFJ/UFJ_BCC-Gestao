        if (filtrosSalvos) {
            try {
                const filtros = JSON.parse(filtrosSalvos);
                
                // Restaurar valores dos filtros
                if (filtros.buscaPessoa !== undefined) {
                    document.getElementById('buscaPessoa').value = filtros.buscaPessoa;
                }
                if (filtros.filtroTipoPessoa !== undefined) {
