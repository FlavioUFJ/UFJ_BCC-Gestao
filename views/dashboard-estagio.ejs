                                <small class="text-muted">Orientador</small>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="mb-2">
                                <div class="fw-bold">${plano.nome_supervisor || 'N/A'}</div>
                                <small class="text-muted">Supervisor</small>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="mb-2">
                                <div class="fw-bold">${plano.nome_concedente || 'N/A'}</div>
