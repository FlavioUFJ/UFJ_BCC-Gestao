                tbody.innerHTML = this.modulos.map(modulo => `
                    <tr>
                        <td>${modulo.nome}</td>
                        <td>${modulo.descricao || '-'}</td>
                        <td><small>${modulo.url || '-'}</small></td>
                        <td>
