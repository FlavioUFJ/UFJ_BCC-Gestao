            async vincularPessoa(idPessoa, nomePessoa) {
                if (!this.moduloAtual) {
                    AdminRotinas.mostrarMensagem('Erro: módulo não selecionado', 'error');
                    return;
                }
                
                try {
                    const response = await fetch(`/admin/modulos/${this.moduloAtual.id_modulo}/pessoas`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            id_pessoa: idPessoa
                        })
                    });
                    
                    const result = await response.json();
                    
                    if (response.ok) {
                        AdminRotinas.mostrarMensagem(`${nomePessoa} vinculado(a) com sucesso!`, 'success');
                        
                        // Limpar busca
                        document.getElementById('buscaPessoaVinculo').value = '';
                        const resultadosBusca = document.getElementById('resultadosBuscaPessoaVinculo');
                if (resultadosBusca) resultadosBusca.innerHTML = '';
                        
                        // Recarregar lista de pessoas vinculadas
                        await this.carregarPessoasVinculadas(this.moduloAtual.id_modulo);
                        
                        // Recarregar tabela de módulos para atualizar contador
                        await this.carregarModulos();
                        
                    } else {
                        AdminRotinas.mostrarMensagem(result.error || 'Erro ao vincular pessoa', 'error');
                    }
                } catch (error) {
                    console.error('Erro ao vincular pessoa:', error);
                    AdminRotinas.mostrarMensagem('Erro ao vincular pessoa', 'error');
                }
            },
            
