<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Parâmetros do Sistema - Gestão de Estágio</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        .main-container {
            background: rgba(255, 255, 255, 0.95);
            border-radius: 20px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
            backdrop-filter: blur(10px);
            margin: 20px;
            padding: 30px;
        }
        .parametro-card {
            background: #fff;
            border-radius: 15px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
            padding: 25px;
            margin-bottom: 25px;
            border-left: 4px solid #667eea;
        }
        .parametro-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }
        .parametro-title {
            color: #667eea;
            font-weight: 600;
            margin: 0;
            flex-grow: 1;
        }
        .form-control:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
        }
        .btn-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            border-radius: 10px;
            padding: 12px 30px;
            font-weight: 600;
            transition: all 0.3s ease;
        }
        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(102, 126, 234, 0.3);
        }
        .btn-secondary {
            border-radius: 10px;
            padding: 8px 20px;
        }
        .btn-success {
            background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
            border: none;
            border-radius: 10px;
        }
        .btn-danger {
            background: linear-gradient(135deg, #dc3545 0%, #fd7e14 100%);
            border: none;
            border-radius: 10px;
        }
        .text-gradient {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .valor-item {
            background: #f8f9fa;
            border-radius: 8px;
            padding: 15px;
            margin-bottom: 10px;
            border-left: 3px solid #667eea;
        }
        .help-icon {
            color: #6c757d;
            cursor: help;
            margin-left: 5px;
        }
        .help-icon:hover {
            color: #667eea;
        }
        .modal-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
        }
        .add-parametro-btn {
            position: fixed;
            bottom: 30px;
            right: 30px;
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
            border: none;
            color: white;
            font-size: 24px;
            box-shadow: 0 8px 25px rgba(40, 167, 69, 0.3);
            transition: all 0.3s ease;
        }
        .add-parametro-btn:hover {
            transform: scale(1.1);
            box-shadow: 0 12px 35px rgba(40, 167, 69, 0.4);
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="main-container">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="text-gradient mb-0">
                    <i class="fas fa-cogs me-3"></i>Parâmetros do Sistema
                </h1>
                <a href="<%= origem %>" class="btn btn-secondary">
                    <i class="fas fa-arrow-left me-2"></i>Voltar
                </a>
            </div>

            <% if (typeof message !== 'undefined' && message) { %>
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle me-2"></i>
                    <%= message %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% } %>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fas fa-exclamation-circle me-2"></i>
                    <%= error %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% } %>

            <!-- Lista de Parâmetros -->
            <% if (parametros && parametros.length > 0) { %>
                <% parametros.forEach(parametro => { %>
                    <div class="parametro-card">
                        <div class="parametro-header">
                            <h3 class="parametro-title">
                                <i class="fas fa-sliders-h me-2"></i><%= parametro.identificador %>
                                <% if (parametro.descricao) { %>
                                    <i class="fas fa-question-circle help-icon" 
                                       data-bs-toggle="tooltip" 
                                       title="<%= parametro.descricao.replace(/"/g, '&quot;') %>"></i>
                                <% } %>
                            </h3>
                            <div>
                                <button class="btn btn-sm btn-primary me-2" 
                                        data-action="editar" 
                                        data-parametro-id="<%= parametro.id_parametro %>">
                                    <i class="fas fa-edit"></i> Editar
                                </button>
                                <button class="btn btn-sm btn-danger" 
                                        data-action="excluir" 
                                        data-parametro-id="<%= parametro.id_parametro %>" 
                                        data-parametro-nome="<%= parametro.identificador.replace(/"/g, '&quot;') %>">
                                    <i class="fas fa-trash"></i> Excluir
                                </button>
                            </div>
                        </div>
                        
                        <% if (parametro.modulo) { %>
                            <div class="mb-3">
                                <span class="badge bg-info">
                                    <i class="fas fa-cube me-1"></i>Módulo: <%= parametro.modulo %>
                                </span>
                            </div>
                        <% } %>
                        
                        <% if (parametro.descricao) { %>
                            <div class="alert alert-info mb-3">
                                <i class="fas fa-info-circle me-2"></i>
                                <%= parametro.descricao %>
                            </div>
                        <% } %>
                        
                        <div class="row">
                            <% parametro.valores.forEach((valor, index) => { %>
                                <div class="col-md-6 mb-3">
                                    <div class="valor-item">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <label class="form-label fw-medium mb-0">
                                                <i class="fas fa-tag me-2"></i><%= valor.identificadorvalor %>
                                            </label>
                                            <div class="btn-group btn-group-sm">
                                                <button type="button" class="btn btn-outline-primary btn-sm" 
                                                        data-action="editar-valor" 
                                                        data-valor-id="<%= valor.id_parametrovalor %>" 
                                                        data-valor-identificador="<%= valor.identificadorvalor.replace(/"/g, '&quot;') %>" 
                                                        data-valor-valor="<%= valor.valor.replace(/"/g, '&quot;') %>" 
                                                        title="Editar valor">
                                                    <i class="fas fa-edit"></i>
                                                </button>
                                                <button type="button" class="btn btn-outline-danger btn-sm" 
                                                        data-action="excluir-valor" 
                                                        data-valor-id="<%= valor.id_parametrovalor %>" 
                                                        data-valor-identificador="<%= valor.identificadorvalor.replace(/"/g, '&quot;') %>" 
                                                        title="Excluir valor">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </div>
                                        </div>
                                        <input type="text" class="form-control valor-input" 
                                               value="<%= valor.valor.replace(/"/g, '&quot;') %>" 
                                               data-parametro-id="<%= parametro.id_parametro %>"
                                               data-valor-id="<%= valor.id_parametrovalor %>">
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                        
                        <!-- Botão para adicionar novo valor -->
                        <div class="text-center mt-3">
                            <button class="btn btn-outline-primary btn-sm" 
                                    data-action="novo-valor" 
                                    data-parametro-id="<%= parametro.id_parametro %>">
                                <i class="fas fa-plus me-1"></i>Adicionar Valor
                            </button>
                        </div>
                    </div>
                <% }); %>
            <% } else { %>
                <div class="text-center py-5">
                    <i class="fas fa-cogs fa-5x text-muted mb-3"></i>
                    <h3 class="text-muted">Nenhum parâmetro cadastrado</h3>
                    <p class="text-muted">Clique no botão "+" para adicionar o primeiro parâmetro.</p>
                </div>
            <% } %>
        </div>
    </div>

    <!-- Botão Flutuante para Adicionar Parâmetro -->
    <button class="add-parametro-btn" data-bs-toggle="modal" data-bs-target="#novoParametroModal">
        <i class="fas fa-plus"></i>
    </button>

    <!-- Modal Novo Parâmetro -->
    <div class="modal fade" id="novoParametroModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fas fa-plus"></i> Novo Parâmetro</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form id="formNovoParametro">
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Identificador *</label>
                            <input type="text" class="form-control" name="identificador" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Descrição *</label>
                            <textarea class="form-control" name="descricao" rows="2" required></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Módulo</label>
                            <input type="text" class="form-control" name="modulo" placeholder="Ex: email, sistema, etc.">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Quantidade de Valores *</label>
                            <input type="number" class="form-control" name="quantidadevalor" min="1" max="20" value="1" required>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary">Salvar Parâmetro</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal Editar Parâmetro -->
    <div class="modal fade" id="editarParametroModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fas fa-edit"></i> Editar Parâmetro</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form id="formEditarParametro">
                    <input type="hidden" name="id_parametro" id="editIdParametro">
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Identificador *</label>
                            <input type="text" class="form-control" name="identificador" id="editIdentificador" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Descrição *</label>
                            <textarea class="form-control" name="descricao" id="editDescricao" rows="2" required></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Módulo</label>
                            <input type="text" class="form-control" name="modulo" id="editModulo">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Quantidade de Valores *</label>
                            <input type="number" class="form-control" name="quantidadevalor" id="editQuantidadevalor" min="1" max="20" required>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary">Atualizar Parâmetro</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal Novo Valor -->
    <div class="modal fade" id="novoValorModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fas fa-plus"></i> Novo Valor</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form id="formNovoValor">
                    <input type="hidden" name="id_parametro" id="novoValorParametroId">
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Identificador do Valor *</label>
                            <input type="text" class="form-control" name="identificadorvalor" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Valor</label>
                            <input type="text" class="form-control" name="valor">
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary">Salvar Valor</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal Editar Valor -->
    <div class="modal fade" id="editarValorModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fas fa-edit"></i> Editar Valor</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form id="formEditarValor">
                    <input type="hidden" name="id_parametrovalor" id="editValorId">
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Identificador do Valor *</label>
                            <input type="text" class="form-control" name="identificadorvalor" id="editValorIdentificador" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Valor</label>
                            <input type="text" class="form-control" name="valor" id="editValorValor">
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary">Atualizar Valor</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Inicializar tooltips
        const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]');
        const tooltipList = [...tooltipTriggerList].map(tooltipTriggerEl => {
            return new bootstrap.Tooltip(tooltipTriggerEl);
        });

        // Event delegation para todos os botões
        document.addEventListener('click', function(e) {
            const target = e.target.closest('[data-action]');
            if (!target) return;

            const action = target.dataset.action;
            
            switch(action) {
                case 'editar':
                    editarParametro(target.dataset.parametroId);
                    break;
                case 'excluir':
                    excluirParametro(target.dataset.parametroId, target.dataset.parametroNome);
                    break;
                case 'editar-valor':
                    editarValor(target.dataset.valorId, target.dataset.valorIdentificador, target.dataset.valorValor);
                    break;
                case 'excluir-valor':
                    excluirValor(target.dataset.valorId, target.dataset.valorIdentificador);
                    break;
                case 'novo-valor':
                    abrirModalNovoValor(target.dataset.parametroId);
                    break;
            }
        });

        // Event delegation para inputs de valor
        document.addEventListener('change', function(e) {
            if (e.target.classList.contains('valor-input')) {
                atualizarValor(e.target);
            }
        });

        // Configurações e constantes
        const CONFIG = {
            ALERT_TIMEOUT: 5000,
            FEEDBACK_TIMEOUT: 1500,
            API_ENDPOINTS: {
                CREATE_PARAM: '/admin/parametro/criar',
                EDIT_PARAM: '/admin/parametro/editar',
                DELETE_PARAM: '/admin/parametro/{id}/excluir',
                GET_PARAM: '/admin/parametro/{id}',
                CREATE_VALUE: '/admin/parametro/valor/criar',
                EDIT_VALUE: '/admin/parametro/valor/editar',
                DELETE_VALUE: '/admin/parametro/valor/excluir',
                UPDATE_VALUE: '/admin/parametro/atualizar-valor'
            }
        };

        // Função para mostrar alertas
        function showAlert(message, type = 'info') {
            const alertContainer = document.querySelector('.main-container');
            if (!alertContainer) return;
            
            const alertDiv = document.createElement('div');
            alertDiv.className = `alert alert-${type} alert-dismissible fade show`;
            
            const iconMap = {
                'danger': 'exclamation-circle',
                'success': 'check-circle',
                'warning': 'exclamation-triangle',
                'info': 'info-circle'
            };
            
            alertDiv.innerHTML = `
                <i class="fas fa-${iconMap[type] || 'info-circle'} me-2"></i>
                ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            `;
            
            const firstChild = alertContainer.firstElementChild;
            alertContainer.insertBefore(alertDiv, firstChild.nextSibling);
            
            // Auto-remover após tempo configurado
            setTimeout(() => {
                if (alertDiv.parentNode) {
                    alertDiv.remove();
                }
            }, CONFIG.ALERT_TIMEOUT);
        }

        // Função para validar formulários
        function validateForm(formData, requiredFields) {
            const errors = [];
            
            requiredFields.forEach(field => {
                const value = formData.get(field);
                if (!value || value.trim() === '') {
                    errors.push(`O campo ${field} é obrigatório`);
                }
            });
            
            return errors;
        }

        // Função para fazer requisições HTTP
        async function makeRequest(url, options = {}) {
            try {
                const response = await fetch(url, {
                    headers: {
                        'Content-Type': 'application/json',
                        ...options.headers
                    },
                    ...options
                });
                
                if (!response.ok) {
                    throw new Error(`HTTP ${response.status}: ${response.statusText}`);
                }
                
                return response;
            } catch (error) {
                console.error('Erro na requisição:', error);
                throw error;
            }
        }

        // Submeter formulário de novo parâmetro
        document.getElementById('formNovoParametro').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const formData = new FormData(this);
            
            // Validar campos obrigatórios
            const errors = validateForm(formData, ['identificador', 'descricao', 'quantidadevalor']);
            if (errors.length > 0) {
                showAlert(errors.join('<br>'), 'danger');
                return;
            }
            
            const data = {
                identificador: formData.get('identificador').trim(),
                descricao: formData.get('descricao').trim(),
                modulo: formData.get('modulo')?.trim() || 'geral',
                quantidadevalor: parseInt(formData.get('quantidadevalor'))
            };
            
            // Validar quantidade de valores
            if (data.quantidadevalor < 1 || data.quantidadevalor > 20) {
                showAlert('A quantidade de valores deve estar entre 1 e 20', 'danger');
                return;
            }
            
            try {
                const response = await makeRequest(CONFIG.API_ENDPOINTS.CREATE_PARAM, {
                    method: 'POST',
                    body: JSON.stringify(data)
                });
                
                if (response.ok) {
                    showAlert('Parâmetro criado com sucesso!', 'success');
                    setTimeout(() => location.reload(), 1000);
                } else {
                    const error = await response.text();
                    showAlert('Erro ao criar parâmetro: ' + error, 'danger');
                }
            } catch (error) {
                showAlert('Erro ao criar parâmetro: ' + error.message, 'danger');
            }
        });

        // Função para editar parâmetro
        async function editarParametro(id) {
            if (!id) {
                showAlert('ID do parâmetro não fornecido', 'danger');
                return;
            }
            
            try {
                const url = CONFIG.API_ENDPOINTS.GET_PARAM.replace('{id}', id);
                const response = await makeRequest(url);
                const data = await response.json();
                
                if (data.success && data.parametro) {
                    const parametro = data.parametro;
                    
                    const elements = {
                        editIdParametro: parametro.id_parametro,
                        editIdentificador: parametro.identificador,
                        editDescricao: parametro.descricao,
                        editModulo: parametro.modulo || '',
                        editQuantidadevalor: parametro.quantidadevalor
                    };
                    
                    Object.entries(elements).forEach(([elementId, value]) => {
                        const element = document.getElementById(elementId);
                        if (element) {
                            element.value = value;
                        } else {
                            console.warn(`Elemento ${elementId} não encontrado`);
                        }
                    });
                    
                    const modal = document.getElementById('editarParametroModal');
                    if (modal) {
                        new bootstrap.Modal(modal).show();
                    } else {
                        showAlert('Modal de edição não encontrado', 'danger');
                    }
                } else {
                    showAlert('Erro ao carregar parâmetro: ' + (data.message || 'Dados não encontrados'), 'danger');
                }
            } catch (error) {
                showAlert('Erro ao carregar parâmetro: ' + error.message, 'danger');
            }
        }

        // Submissão do formulário de editar parâmetro
        document.getElementById('formEditarParametro').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const formData = new FormData(this);
            
            // Validar campos obrigatórios
            const errors = validateForm(formData, ['id_parametro', 'identificador', 'descricao', 'quantidadevalor']);
            if (errors.length > 0) {
                showAlert(errors.join('<br>'), 'danger');
                return;
            }
            
            const data = {
                id_parametro: formData.get('id_parametro'),
                identificador: formData.get('identificador').trim(),
                descricao: formData.get('descricao').trim(),
                modulo: formData.get('modulo')?.trim() || 'geral',
                quantidadevalor: parseInt(formData.get('quantidadevalor'))
            };
            
            // Validar quantidade de valores
            if (data.quantidadevalor < 1 || data.quantidadevalor > 20) {
                showAlert('A quantidade de valores deve estar entre 1 e 20', 'danger');
                return;
            }
            
            try {
                const response = await makeRequest(CONFIG.API_ENDPOINTS.EDIT_PARAM, {
                    method: 'POST',
                    body: JSON.stringify(data)
                });
                
                if (response.ok) {
                    showAlert('Parâmetro editado com sucesso!', 'success');
                    setTimeout(() => location.reload(), 1000);
                } else {
                    const error = await response.text();
                    showAlert('Erro ao editar parâmetro: ' + error, 'danger');
                }
            } catch (error) {
                showAlert('Erro ao editar parâmetro: ' + error.message, 'danger');
            }
        });

        // Função para excluir parâmetro
        async function excluirParametro(id, nome) {
            if (!id || !nome) {
                showAlert('Dados do parâmetro não fornecidos', 'danger');
                return;
            }
            
            if (!confirm(`Tem certeza que deseja excluir o parâmetro "${nome}" e todos os seus valores?\n\nEsta ação não pode ser desfeita.`)) {
                return;
            }
            
            try {
                const url = CONFIG.API_ENDPOINTS.DELETE_PARAM.replace('{id}', id);
                const response = await makeRequest(url, {
                    method: 'DELETE'
                });
                
                if (response.ok) {
                    showAlert('Parâmetro excluído com sucesso!', 'success');
                    setTimeout(() => location.reload(), 1000);
                } else {
                    const error = await response.text();
                    showAlert('Erro ao excluir parâmetro: ' + error, 'danger');
                }
            } catch (error) {
                showAlert('Erro ao excluir parâmetro: ' + error.message, 'danger');
            }
        }

        // Abrir modal para novo valor
        function abrirModalNovoValor(parametroId) {
            if (!parametroId) {
                showAlert('ID do parâmetro não fornecido', 'danger');
                return;
            }
            
            const modal = document.getElementById('novoValorModal');
            const input = document.getElementById('novoValorParametroId');
            
            if (modal && input) {
                input.value = parametroId;
                // Limpar campos do formulário
                const form = modal.querySelector('form');
                if (form) {
                    form.reset();
                    input.value = parametroId; // Restaurar o ID após reset
                }
                new bootstrap.Modal(modal).show();
            } else {
                showAlert('Erro ao abrir modal de novo valor: elementos não encontrados', 'danger');
            }
        }

        // Submeter formulário de novo valor
        document.getElementById('formNovoValor').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const formData = new FormData(this);
            
            // Validar campos obrigatórios
            const errors = validateForm(formData, ['id_parametro', 'identificadorvalor']);
            if (errors.length > 0) {
                showAlert(errors.join('<br>'), 'danger');
                return;
            }
            
            const data = {
                parametroId: formData.get('id_parametro'),
                identificadorvalor: formData.get('identificadorvalor').trim(),
                valor: formData.get('valor')?.trim() || ''
            };
            
            try {
                const response = await makeRequest(CONFIG.API_ENDPOINTS.CREATE_VALUE, {
                    method: 'POST',
                    body: JSON.stringify(data)
                });
                
                const result = await response.json();
                
                if (result.success) {
                    showAlert('Valor criado com sucesso!', 'success');
                    setTimeout(() => location.reload(), 1000);
                } else {
                    showAlert('Erro ao criar valor: ' + result.message, 'danger');
                }
            } catch (error) {
                showAlert('Erro ao criar valor: ' + error.message, 'danger');
            }
        });

        // Atualizar valor em tempo real
        async function atualizarValor(input) {
            const valorId = input.dataset.valorId;
            const novoValor = input.value;
            
            if (!valorId) {
                showAlert('ID do valor não encontrado', 'danger');
                return;
            }
            
            try {
                const response = await makeRequest(CONFIG.API_ENDPOINTS.UPDATE_VALUE, {
                    method: 'POST',
                    body: JSON.stringify({
                        valorId: valorId,
                        valor: novoValor
                    })
                });
                
                const data = await response.json();
                
                if (data.success) {
                    // Feedback visual de sucesso
                    input.style.borderColor = '#28a745';
                    input.style.backgroundColor = '#f8fff8';
                    setTimeout(() => {
                        input.style.borderColor = '';
                        input.style.backgroundColor = '';
                    }, CONFIG.FEEDBACK_TIMEOUT);
                } else {
                    showAlert('Erro ao atualizar valor: ' + data.message, 'danger');
                    // Feedback visual de erro
                    input.style.borderColor = '#dc3545';
                    input.style.backgroundColor = '#fff8f8';
                    setTimeout(() => {
                        input.style.borderColor = '';
                        input.style.backgroundColor = '';
                    }, CONFIG.FEEDBACK_TIMEOUT);
                }
            } catch (error) {
                console.error('Erro:', error);
                showAlert('Erro ao atualizar valor: ' + error.message, 'danger');
            }
        }

        // Função para editar valor
        function editarValor(id, identificador, valor) {
            const elements = {
                editValorId: id,
                editValorIdentificador: identificador,
                editValorValor: valor
            };
            
            Object.entries(elements).forEach(([elementId, value]) => {
                const element = document.getElementById(elementId);
                if (element) element.value = value;
            });
            
            const modal = new bootstrap.Modal(document.getElementById('editarValorModal'));
            modal.show();
        }

        // Função para excluir valor
        async function excluirValor(id, identificador) {
            if (!id || !identificador) {
                showAlert('Dados do valor não fornecidos', 'danger');
                return;
            }
            
            if (!confirm(`Tem certeza que deseja excluir o valor "${identificador}"?\n\nEsta ação não pode ser desfeita.`)) {
                return;
            }
            
            try {
                const response = await makeRequest(CONFIG.API_ENDPOINTS.DELETE_VALUE, {
                    method: 'POST',
                    body: JSON.stringify({
                        id_parametrovalor: id
                    })
                });
                
                const data = await response.json();
                
                if (data.success) {
                    showAlert('Valor excluído com sucesso!', 'success');
                    setTimeout(() => location.reload(), 1000);
                } else {
                    showAlert('Erro ao excluir valor: ' + data.message, 'danger');
                }
            } catch (error) {
                console.error('Erro:', error);
                showAlert('Erro ao excluir valor: ' + error.message, 'danger');
            }
        }

        // Submeter formulário de editar valor
        document.getElementById('formEditarValor').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const formData = new FormData(this);
            
            // Validar campos obrigatórios
            const errors = validateForm(formData, ['id_parametrovalor', 'identificadorvalor']);
            if (errors.length > 0) {
                showAlert(errors.join('<br>'), 'danger');
                return;
            }
            
            const data = {
                id_parametrovalor: formData.get('id_parametrovalor'),
                identificadorvalor: formData.get('identificadorvalor').trim(),
                valor: formData.get('valor')?.trim() || ''
            };
            
            try {
                const response = await makeRequest(CONFIG.API_ENDPOINTS.EDIT_VALUE, {
                    method: 'POST',
                    body: JSON.stringify(data)
                });
                
                if (response.ok) {
                    showAlert('Valor editado com sucesso!', 'success');
                    setTimeout(() => location.reload(), 1000);
                } else {
                    const error = await response.text();
                    showAlert('Erro ao editar valor: ' + error, 'danger');
                }
            } catch (error) {
                showAlert('Erro ao editar valor: ' + error.message, 'danger');
            }
        });
    </script>
</body>
</html>