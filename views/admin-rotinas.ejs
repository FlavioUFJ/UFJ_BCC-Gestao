                            </div>
                        </div>
                    `).join('');
                    
                } catch (error) {
                    console.error('Erro ao buscar pessoas:', error);
                    const resultadosBusca = document.getElementById('resultadosBuscaPessoaVinculo');
                    if (resultadosBusca) resultadosBusca.innerHTML = `
                        <div class="list-group-item text-danger text-center">
                            Erro ao buscar pessoas
