    // Função para anexar plano assinado
    async function campEstAnexarPlano() {
        if (!campoSelecionadoId) {
            alert('Por favor, selecione um campo de estágio para anexar o plano.');
            return;
        }
        
        try {
            // Verificar se os parâmetros necessários estão configurados
            const response = await fetch('/parametro/buscar?identificador=Pastas dos Anexos');
            const parametroPastas = await response.json();
            
            const response2 = await fetch('/parametro/buscar?identificador=Planos Assinados');
            const parametroPlanos = await response2.json();
            
            if (!parametroPastas.success || !parametroPastas.data || 
                !parametroPlanos.success || !parametroPlanos.data) {
                alert('Para utilizar esta funcionalidade, é necessário configurar os parâmetros:\n\n' +
                      '• "Pastas dos Anexos"\n' +
                      '• "Planos Assinados"\n\n' +
                      'Entre em contato com o administrador do sistema.');
                return;
            }
            
            // Criar input file para seleção do PDF
            const input = document.createElement('input');
            input.type = 'file';
            input.accept = '.pdf';
            input.style.display = 'none';
            
            input.onchange = async function(event) {
                const file = event.target.files[0];
                if (!file) return;
                
                if (file.type !== 'application/pdf') {
                    alert('Por favor, selecione apenas arquivos PDF.');
                    return;
                }
                
                // Criar FormData para upload
                const formData = new FormData();
                formData.append('plano_assinado', file);
                formData.append('campo_estagio_id', campoSelecionadoId);
                
                try {
                    const uploadResponse = await fetch('/secure/estagios/campo/anexar-plano', {
                        method: 'POST',
                        body: formData
                    });
                    
                    const result = await uploadResponse.json();
                    
                    if (result.success) {
                        alert('Plano assinado anexado com sucesso!');
                        location.reload(); // Recarregar para atualizar a exibição
                    } else {
                        alert('Erro ao anexar plano: ' + result.message);
                    }
                } catch (error) {
                    console.error('Erro no upload:', error);
                    alert('Erro ao anexar plano. Tente novamente.');
                }
            };
            
            document.body.appendChild(input);
            input.click();
            document.body.removeChild(input);
            
        } catch (error) {
            console.error('Erro ao verificar parâmetros:', error);
            alert('Erro ao verificar configurações. Tente novamente.');
        }
    }
    
    // Variáveis para navegação entre registros
    let registrosOriginais = <%- JSON.stringify(camposEstagio || []) %>;
    let registrosFiltrados = [...registrosOriginais];
    let indiceAtual = 0;
    
    // Função para navegar entre registros
    function campEstNavegar(direcao) {
        if (registrosFiltrados.length === 0) return;
        
        indiceAtual += direcao;
        
        if (indiceAtual < 0) {
            indiceAtual = registrosFiltrados.length - 1;
        } else if (indiceAtual >= registrosFiltrados.length) {
            indiceAtual = 0;
        }
        
        atualizarExibicaoRegistro();
    }
    
    // Função para atualizar a exibição do registro atual
    function atualizarExibicaoRegistro() {
        if (registrosFiltrados.length === 0) {
            document.getElementById('campoEstagioContent').innerHTML = '<div class="text-center py-3"><i class="fas fa-search fa-2x text-muted mb-2"></i><p class="text-muted mb-0">Nenhum registro encontrado</p></div>';
            campoSelecionadoId = null; // Limpar seleção quando não há registros
            return;
        }
        
        const registro = registrosFiltrados[indiceAtual];
        
        // Armazenar o ID do campo atual para uso no botão Editar
        campoSelecionadoId = registro.id_campo_estagio;
        
        // Atualizar situação
        const situacaoElement = document.getElementById('situacaoAtual');
        if (situacaoElement) {
            const situacao = registro.situacao || 'N/A';
            situacaoElement.textContent = situacao;
            
            // Controlar cor da fonte baseada na situação
            if (situacao !== 'Em Edição' && situacao !== 'N/A') {
                situacaoElement.style.color = '#28a745'; // Verde
            } else {
                situacaoElement.style.color = '#ffc107'; // Amarelo (padrão)
            }
        }
        
        // Controlar estado dos botões baseado na situação
        const situacao = registro.situacao || '';
        
        // Botão Editar - desabilitado se situação for "Cadastrado"
        const btnEditarCampo = document.getElementById('btnCampEstEditar');
        if (btnEditarCampo) {
            const podeEditar = situacao === 'Em Edição';
            btnEditarCampo.disabled = !podeEditar;
            
            if (!podeEditar) {
                btnEditarCampo.title = 'Edição disponível apenas para campos com situação "Em Edição"';
                btnEditarCampo.classList.remove('btn-outline-primary');
                btnEditarCampo.classList.add('btn-outline-secondary');
            } else {
                btnEditarCampo.title = 'Editar campo de estágio';
                btnEditarCampo.classList.remove('btn-outline-secondary');
                btnEditarCampo.classList.add('btn-outline-primary');
            }
        }
        
        // Botão Gerar PDF - desabilitado se situação for "Em Edição"
        const btnGerarPDF = document.getElementById('btnCampEstGerarPDF');
        if (btnGerarPDF) {
            const podeGerarPDF = situacao === 'Cadastrado';
            btnGerarPDF.disabled = !podeGerarPDF;
            
            if (!podeGerarPDF) {
                btnGerarPDF.title = 'Geração de PDF disponível apenas para campos com situação "Cadastrado"';
                btnGerarPDF.classList.remove('btn-outline-info');
                btnGerarPDF.classList.add('btn-outline-secondary');
            } else {
                btnGerarPDF.title = 'Gerar PDF do campo de estágio';
                btnGerarPDF.classList.remove('btn-outline-secondary');
                btnGerarPDF.classList.add('btn-outline-info');
            }
        }
        
        // Botão Anexar Plano Assinado - desabilitado se situação for "Em Edição"
        const btnAnexarPlano = document.getElementById('btnCampEstAnexarPlano');
        if (btnAnexarPlano) {
            const podeAnexarPlano = situacao === 'Cadastrado';
            btnAnexarPlano.disabled = !podeAnexarPlano;
            
            if (!podeAnexarPlano) {
                btnAnexarPlano.title = 'Anexar plano disponível apenas para campos com situação "Cadastrado"';
                btnAnexarPlano.classList.remove('btn-outline-warning');
                btnAnexarPlano.classList.add('btn-outline-secondary');
            } else {
                btnAnexarPlano.title = 'Anexar plano assinado';
                btnAnexarPlano.classList.remove('btn-outline-secondary');
                btnAnexarPlano.classList.add('btn-outline-warning');
            }
        }
        
        // Atualizar datas
        const inicioElement = document.getElementById('inicioAtual');
        if (inicioElement) {
            inicioElement.textContent = registro.data_inicio ? new Date(registro.data_inicio).toLocaleDateString('pt-BR') : 'N/A';
        }
        
        const fimElement = document.getElementById('fimAtual');
        if (fimElement) {
            fimElement.textContent = registro.data_fim ? new Date(registro.data_fim).toLocaleDateString('pt-BR') : 'N/A';
        }
        
        // Atualizar pessoas
        const estagiarioElement = document.getElementById('estagiarioAtual');
        if (estagiarioElement) {
            estagiarioElement.textContent = registro.nome_estagiario || 'N/A';
        }
        
        const orientadorElement = document.getElementById('orientadorAtual');
        if (orientadorElement) {
            orientadorElement.textContent = registro.nome_orientador || 'N/A';
        }
        
        const supervisorElement = document.getElementById('supervisorAtual');
        if (supervisorElement) {
            supervisorElement.textContent = registro.nome_supervisor || 'N/A';
        }
        
        const concedenteElement = document.getElementById('concedenteAtual');
        if (concedenteElement) {
            concedenteElement.textContent = registro.nome_concedente || 'N/A';
        }
        
        // Atualizar contador no header
        const contadorHeader = document.getElementById('contadorHeader');
        if (contadorHeader) {
            contadorHeader.textContent = `${indiceAtual + 1} de ${registrosFiltrados.length}`;
        }
        
        // Atualizar estado dos botões
        const btnAnterior = document.getElementById('btnAnterior');
        const btnProximo = document.getElementById('btnProximo');
        
        if (btnAnterior && btnProximo) {
            btnAnterior.disabled = registrosFiltrados.length <= 1;
            btnProximo.disabled = registrosFiltrados.length <= 1;
        }
    }
    
    // Função para filtrar registros
    function campEstFiltrar() {
        const termo = document.getElementById('campEstBusca').value.toLowerCase().trim();
        
        if (termo === '') {
            registrosFiltrados = [...registrosOriginais];
        } else {
            registrosFiltrados = registrosOriginais.filter(registro => {
                return (
                    (registro.nome_estagiario && registro.nome_estagiario.toLowerCase().includes(termo)) ||
                    (registro.nome_orientador && registro.nome_orientador.toLowerCase().includes(termo)) ||
                    (registro.nome_supervisor && registro.nome_supervisor.toLowerCase().includes(termo)) ||
                    (registro.nome_concedente && registro.nome_concedente.toLowerCase().includes(termo)) ||
                    (registro.situacao && registro.situacao.toLowerCase().includes(termo))
                );
            });
        }
        
        indiceAtual = 0;
        atualizarExibicaoRegistro();
    }
    
