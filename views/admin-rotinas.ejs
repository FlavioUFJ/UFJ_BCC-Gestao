                if (!confirm('Tem certeza que deseja desvincular esta pessoa do módulo?')) {
                    return;
                }
                
                try {
                    const response = await fetch(`/admin/modulos/${idModulo}/pessoas/${idPessoa}`, {
                        method: 'DELETE'
                    });
                    
                    const result = await response.json();
                    
                    if (response.ok) {
                        AdminRotinas.mostrarMensagem('Pessoa desvinculada com sucesso!', 'success');
                        
                        // Recarregar lista de pessoas vinculadas
                        await this.carregarPessoasVinculadas(idModulo);
                        
                        // Recarregar tabela de módulos para atualizar contador
                        await this.carregarModulos();
                        
                    } else {
                        AdminRotinas.mostrarMensagem(result.error || 'Erro ao desvincular pessoa', 'error');
                    }
                } catch (error) {
                    console.error('Erro ao desvincular pessoa:', error);
                    AdminRotinas.mostrarMensagem('Erro ao desvincular pessoa', 'error');
                }
            },
            
