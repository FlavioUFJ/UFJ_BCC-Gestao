        document.getElementById('btnFreqAtiGerarPDF').disabled = false;
        document.getElementById('linkFreqAtiAprovar').style.display = 'inline';
        
        // Controlar navegação
        document.getElementById('btnFreqAtiAnterior').disabled = frequenciasParaExibir.length <= 1;
        document.getElementById('btnFreqAtiProximo').disabled = frequenciasParaExibir.length <= 1;
    }
    
    // Função para navegar entre frequências
    function frequenciaNavegar(direcao) {
        const frequenciasParaExibir = frequenciasFiltradas.length > 0 ? frequenciasFiltradas : frequencias;
        
        if (frequenciasParaExibir.length <= 1) return;
        
        if (direcao === 'anterior') {
            frequenciaAtualIndex = frequenciaAtualIndex > 0 ? frequenciaAtualIndex - 1 : frequenciasParaExibir.length - 1;
        } else if (direcao === 'proximo') {
            frequenciaAtualIndex = frequenciaAtualIndex < frequenciasParaExibir.length - 1 ? frequenciaAtualIndex + 1 : 0;
        }
        
        atualizarExibicaoFrequencia();
    }
    
    // Função para filtrar frequências
    function frequenciaFiltrar() {
        const termo = document.getElementById('freqAtiBusca').value.toLowerCase().trim();
        const termoNormalizado = normalizarTexto(termo);
        
        if (termo === '') {
            frequenciasFiltradas = [];
        } else {
            frequenciasFiltradas = frequencias.filter(frequencia => {
                // Busca normal (mantém compatibilidade)
                const buscaNormal = (
                    (frequencia.nome_estagiario && frequencia.nome_estagiario.toLowerCase().includes(termo)) ||
                    (frequencia.mesdereferencia && frequencia.mesdereferencia.toLowerCase().includes(termo)) ||
                    (frequencia.resumo_atividades && frequencia.resumo_atividades.toLowerCase().includes(termo))
                );
                
                // Busca normalizada (sem acentos)
                const buscaNormalizada = (
                    (frequencia.nome_estagiario && normalizarTexto(frequencia.nome_estagiario).includes(termoNormalizado)) ||
                    (frequencia.mesdereferencia && normalizarTexto(frequencia.mesdereferencia).includes(termoNormalizado)) ||
                    (frequencia.resumo_atividades && normalizarTexto(frequencia.resumo_atividades).includes(termoNormalizado))
                );
                
                return buscaNormal || buscaNormalizada;
            });
        }
        
        frequenciaAtualIndex = 0;
        atualizarExibicaoFrequencia();
    }
    
