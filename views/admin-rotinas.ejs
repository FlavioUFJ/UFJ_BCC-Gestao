    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Namespace para organizar o código
        const AdminRotinas = {
            // Variáveis de controle
            modalAberto: false, // Prevenir múltiplas aberturas

            // Inicialização
            init() {
                this.setupEventListeners();
                this.setupModalEventListeners();
            },

            // Configurar event listeners principais
            setupEventListeners() {
                // Formulários
                document.getElementById('alterarSenhaForm')?.addEventListener('submit', (e) => this.alterarSenha(e));

                // Backup
                document.getElementById('criarBackupBtn')?.addEventListener('click', () => this.criarBackup());
                document.getElementById('listarBackupsBtn')?.addEventListener('click', () => this.listarBackups());
                document.getElementById('atualizarBackupsBtn')?.addEventListener('click', () => this.listarBackups());
                
                // Listener para quando a aba Gestão dos Dados for ativada
                document.addEventListener('click', (e) => {
                    if (e.target.matches('button[data-bs-target="#importar"]') || e.target.closest('button[data-bs-target="#importar"]')) {
                        // Aguardar um pouco para o DOM da aba ser renderizado
                        setTimeout(() => {
                            // Carregar lista de backups automaticamente
                            this.listarBackups();
                        }, 100);
                    }
                });
            },

            // Configurar event listeners do modal
            setupModalEventListeners() {
                // Configurações específicas para outros modais podem ser adicionadas aqui
            },



            // Funcionalidades de administração
            alterarSenha(e) {
                e.preventDefault();
                
                console.log('DEBUG - Função alterarSenha chamada');
                
                // Capturar dados diretamente dos campos
                const email = document.getElementById('emailAlterarSenha').value;
                const novaSenha = document.getElementById('novaSenha').value;
                
                console.log('DEBUG - Dados capturados:', { email, novaSenhaLength: novaSenha?.length });
                
                if (!email || !novaSenha) {
                    this.showAlert('Por favor, preencha todos os campos', 'error');
                    return;
                }
                
                this.showLoading(true);
                
                // Usar JSON em vez de FormData
                fetch('/admin/alterar-senha', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ email, novaSenha })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        e.target.reset();
                        this.showAlert('Senha alterada com sucesso!', 'success');
                    } else {
                        this.showAlert('Erro: ' + data.message, 'error');
                    }
                })
                .catch(error => {
                    console.error('Erro:', error);
                    this.showAlert('Erro ao alterar senha.', 'error');
                })
                .finally(() => {
                    this.showLoading(false);
                });
            },



            // Funcionalidades de backup
            criarBackup() {
                const btn = document.getElementById('criarBackupBtn');
                const originalText = btn.innerHTML;
                
                btn.disabled = true;
                btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Criando...';
                
                fetch('/admin/criar-backup', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        this.showAlert('Backup criado com sucesso: ' + data.fileName, 'success');
                        this.listarBackups();
                    } else {
                        this.showAlert('Erro ao criar backup: ' + data.message, 'error');
                    }
                })
                .catch(error => {
                    console.error('Erro:', error);
                    this.showAlert('Erro ao criar backup', 'error');
                })
                .finally(() => {
                    btn.disabled = false;
                    btn.innerHTML = originalText;
                });
            },

            listarBackups() {
                fetch('/admin/listar-backups')
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        const container = document.getElementById('backupsContainer');
                        const lista = document.getElementById('backupsList');
                        
                        if (data.backups.length === 0) {
                            lista.innerHTML = '<p class="text-muted">Nenhum backup encontrado.</p>';
                        } else {
                            let html = '<div class="table-responsive"><table class="table table-striped"><thead><tr><th>Nome do Arquivo</th><th>Data/Hora</th><th>Tamanho</th><th>Ações</th></tr></thead><tbody>';
                            
                            data.backups.forEach(backup => {
                                html += `
                                    <tr>
                                        <td><i class="fas fa-database me-2"></i>${backup.fileName}</td>
                                        <td>${backup.date}</td>
                                        <td>${backup.size}</td>
                                        <td>
                                            <button class="btn btn-sm btn-success me-2" onclick="AdminRotinas.restaurarBackup('${backup.fileName}')">
                                                <i class="fas fa-history me-1"></i>Restaurar
                                            </button>
                                            <a href="/admin/download-backup/${backup.fileName}" class="btn btn-sm btn-outline-primary">
                                                <i class="fas fa-download me-1"></i>Download
                                            </a>
                                        </td>
                                    </tr>
                                `;
                            });
                            
                            html += '</tbody></table></div>';
                            lista.innerHTML = html;
                        }
                        
                        container.style.display = 'block';
                    } else {
                        this.showAlert('Erro ao listar backups: ' + data.message, 'error');
                    }
                })
                .catch(error => {
                    console.error('Erro:', error);
                    this.showAlert('Erro ao listar backups', 'error');
                });
            },

            restaurarBackup(fileName) {
                if (confirm(`Tem certeza que deseja restaurar o backup "${fileName}"? Os dados atuais serão substituídos!`)) {
                    this.showLoading(true);
                    
                    fetch('/admin/restaurar-backup', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({ backupFileName: fileName })
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            this.showAlert('Backup restaurado com sucesso! Backup atual salvo como: ' + data.currentBackup, 'success');
                            this.listarBackups();
                            setTimeout(() => location.reload(), 2000);
                        } else {
                            this.showAlert('Erro ao restaurar backup: ' + data.message, 'error');
                        }
                    })
                    .catch(error => {
                        console.error('Erro:', error);
                        this.showAlert('Erro ao restaurar backup', 'error');
                    })
                    .finally(() => {
                        this.showLoading(false);
                    });
                }
            },

            // Utilitários de UI
            showAlert(message, type = 'info') {
                // Remove alertas existentes
                const existingAlerts = document.querySelectorAll('.alert-temp');
                existingAlerts.forEach(alert => alert.remove());
                
                const alertClass = {
                    'success': 'alert-success',
                    'error': 'alert-danger',
                    'warning': 'alert-warning',
                    'info': 'alert-info'
                }[type] || 'alert-info';
                
                const icon = {
                    'success': 'fas fa-check-circle',
                    'error': 'fas fa-exclamation-circle',
                    'warning': 'fas fa-exclamation-triangle',
                    'info': 'fas fa-info-circle'
                }[type] || 'fas fa-info-circle';
                
                const alertDiv = document.createElement('div');
                alertDiv.className = `alert ${alertClass} alert-dismissible fade show alert-temp`;
                alertDiv.innerHTML = `
                    <i class="${icon} me-2"></i>${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                `;
                
                const container = document.querySelector('.container-fluid');
                const firstChild = container.firstElementChild;
                container.insertBefore(alertDiv, firstChild);
                
                // Auto-remove após 5 segundos
                setTimeout(() => {
                    if (alertDiv.parentNode) {
                        alertDiv.remove();
                    }
                }, 5000);
            },

            showLoading(show) {
                const body = document.body;
                if (show) {
                    body.classList.add('loading');
                } else {
                    body.classList.remove('loading');
                }
            },

            // Alias para compatibilidade
            mostrarMensagem(message, type = 'info') {
                this.showAlert(message, type);
            }
        };

