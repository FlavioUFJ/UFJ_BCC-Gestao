    // Função para normalizar texto removendo acentos
    function normalizarTexto(texto) {
        if (!texto) return '';
        return texto.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
    }
    
    // Função para filtrar registros
    function campEstFiltrar() {
        const termo = document.getElementById('campEstBusca').value.toLowerCase().trim();
        const termoNormalizado = normalizarTexto(termo);
        
        if (termo === '') {
            registrosFiltrados = [...registrosOriginais];
        } else {
            registrosFiltrados = registrosOriginais.filter(registro => {
                // Busca normal (mantém compatibilidade)
                const buscaNormal = (
                    (registro.nome_estagiario && registro.nome_estagiario.toLowerCase().includes(termo)) ||
                    (registro.nome_orientador && registro.nome_orientador.toLowerCase().includes(termo)) ||
                    (registro.nome_supervisor && registro.nome_supervisor.toLowerCase().includes(termo)) ||
                    (registro.nome_concedente && registro.nome_concedente.toLowerCase().includes(termo)) ||
                    (registro.situacao && registro.situacao.toLowerCase().includes(termo))
                );
                
                // Busca normalizada (sem acentos)
                const buscaNormalizada = (
                    (registro.nome_estagiario && normalizarTexto(registro.nome_estagiario).includes(termoNormalizado)) ||
                    (registro.nome_orientador && normalizarTexto(registro.nome_orientador).includes(termoNormalizado)) ||
                    (registro.nome_supervisor && normalizarTexto(registro.nome_supervisor).includes(termoNormalizado)) ||
                    (registro.nome_concedente && normalizarTexto(registro.nome_concedente).includes(termoNormalizado)) ||
                    (registro.situacao && normalizarTexto(registro.situacao).includes(termoNormalizado))
                );
                
                return buscaNormal || buscaNormalizada;
            });
        }
        
        indiceAtual = 0;
        atualizarExibicaoRegistro();
    }
    
