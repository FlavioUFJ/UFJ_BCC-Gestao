                        </td>
                        <td>
                            <button class="btn btn-sm btn-outline-primary me-1" onclick="GerenciadorModulos.editarModulo(${modulo.id_modulo})" title="Editar">
                                <i class="fas fa-edit"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-success" onclick="GerenciadorModulos.vincularPessoas(${modulo.id_modulo})" title="Vincular Pessoas">
                                <i class="fas fa-users"></i>
                            </button>
                        </td>
                    </tr>
                `).join('');
            },
            
            async criarModulo() {
                const form = document.getElementById('novoModuloForm');
                const formData = new FormData(form);
                
                try {
                    const response = await fetch('/admin/modulos', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            nome: formData.get('nome'),
                            descricao: formData.get('descricao'),
                            icone: formData.get('icone'),
                            cor: formData.get('cor'),
                            url: formData.get('url'),
                            ordem: formData.get('ordem'),
                            ativo: formData.get('ativo') === '1'
                        })
                    });
                    
                    const result = await response.json();
                    
                    if (response.ok) {
                        AdminRotinas.mostrarMensagem('Módulo criado com sucesso!', 'success');
                        form.reset();
                        bootstrap.Modal.getInstance(document.getElementById('modalNovoModulo')).hide();
                        this.carregarModulos();
                    } else {
                        AdminRotinas.mostrarMensagem(result.error || 'Erro ao criar módulo', 'error');
                    }
                } catch (error) {
                    console.error('Erro ao criar módulo:', error);
                    AdminRotinas.mostrarMensagem('Erro ao criar módulo', 'error');
                }
            },
            
            async editarModulo(id) {
                try {
                    const response = await fetch(`/admin/modulos/${id}`);
                    const modulo = await response.json();
                    
                    if (response.ok) {
                        this.moduloAtual = modulo;
                        
                        // Preencher formulário de edição
                        document.getElementById('editarModuloId').value = modulo.id_modulo;
                        document.getElementById('editarModuloNome').value = modulo.nome;
                        document.getElementById('editarModuloDescricao').value = modulo.descricao || '';
                        document.getElementById('editarModuloIcone').value = modulo.icone || '';
                        document.getElementById('editarModuloCor').value = modulo.cor || '';
                        document.getElementById('editarModuloUrl').value = modulo.url || '';
                        document.getElementById('editarModuloOrdem').value = modulo.ordem || '';
                        document.getElementById('editarModuloAtivo').value = modulo.ativo ? '1' : '0';
                        
                        // Abrir modal
                        new bootstrap.Modal(document.getElementById('modalEditarModulo')).show();
                    } else {
                        AdminRotinas.mostrarMensagem(modulo.error || 'Erro ao carregar dados do módulo', 'error');
