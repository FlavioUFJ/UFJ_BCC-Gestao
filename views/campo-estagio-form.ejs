            <% } else { %>
            

            
            // Buscar dados do usuário logado
            fetch('/secure/pessoa/<%= user.id_pessoa %>', {
                method: 'GET',
                credentials: 'include'
            })
            .then(response => response.json())
            .then(data => {
                if (data.success && data.data) {
                    const usuarioLogado = data.data;
                    const idUsuario = parseInt('<%= user.id_pessoa %>');
                    
                    console.log('Dados do usuário:', { nivelAcesso: '<%= user.nivelacesso %>', idUsuario });
                    
                    // Verificar situação do campo de estágio
                    const situacaoCampo = '<%= campoEstagio.situacao %>';
                    console.log('Situação do campo:', situacaoCampo);
                    
                    let podeExcluir = false;
                    let motivoDesabilitado = '';
                    
                    if ('<%= user.nivelacesso %>' === 'Administrador') {
                        // Administrador: Desabilitar apenas para 'Finalizado'
