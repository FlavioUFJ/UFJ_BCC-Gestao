# Configurações de Ambiente - UFJ BCC-Gestão
# Copie este arquivo para .env e configure as variáveis

# Ambiente da aplicação
NODE_ENV=production

# Porta da aplicação
PORT=3000

# Chave secreta para sessões (ALTERE ESTA CHAVE!)
# Gere uma chave forte com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=ALTERE_ESTA_CHAVE_SECRETA_MUITO_FORTE_AQUI

# Configurações do banco de dados MariaDB/MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gestao_bccufj
DB_USER=seu_usuario
DB_PASSWORD=sua_senha

# Configurações de Email (Gmail como exemplo)
# Para usar Gmail, você precisa gerar uma "Senha de App" nas configurações de segurança
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=seu_email@gmail.com
EMAIL_PASS=sua_senha_de_app_do_gmail
EMAIL_FROM=seu_email@gmail.com

# Configurações de Email alternativas (outros provedores)
# Para Outlook/Hotmail:
# EMAIL_HOST=smtp-mail.outlook.com
# EMAIL_PORT=587
# EMAIL_SECURE=false

# Para Yahoo:
# EMAIL_HOST=smtp.mail.yahoo.com
# EMAIL_PORT=587
# EMAIL_SECURE=false

# Configurações de Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# URL base da aplicação (para links em emails)
BASE_URL=https://gestao.computacaoufj.online

# Configurações de Upload
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=pdf,doc,docx,jpg,jpeg,png

# Configurações de Backup
BACKUP_ENABLED=true
BACKUP_INTERVAL=24
BACKUP_RETENTION_DAYS=30