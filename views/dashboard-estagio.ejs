    // Função para aprovar frequência
    async function frequenciaAprovar() {
        if (!frequenciaSelecionadaId) {
            alert('Por favor, selecione uma frequência para aprovar.');
            return;
        }
        
        const frequenciaAtual = frequencias.find(f => f.id_campo_estagio_frequencia == frequenciaSelecionadaId);
        if (!frequenciaAtual) {
            alert('Frequência não encontrada.');
            return;
        }
        
        try {
            // Buscar categoria do usuário logado
            const response = await fetch(`/planos-atividade/${planoAtividadeSelecionadoId}/categoria-usuario`);
            
            if (response.status === 403) {
                const result = await response.json();
                alert(result.message || 'Você não tem permissão para aprovar frequências.');
                return;
            }
            
            const result = await response.json();
            
            if (!result.success) {
                alert('Erro ao verificar categoria do usuário.');
                return;
            }
            
            const categorias = result.categorias || [result.categoria];
            const categoriasDisponiveis = [];
            const categoriasJaAprovadas = [];
            
            // Verificar quais categorias estão disponíveis e quais já aprovaram
            categorias.forEach(categoria => {
                if (categoria === 'Estagiário' && frequenciaAtual.aprovado_estagiario === 'Sim') {
                    categoriasJaAprovadas.push(categoria);
                } else if (categoria === 'Orientador' && frequenciaAtual.aprovado_orientador === 'Sim') {
                    categoriasJaAprovadas.push(categoria);
                } else if (categoria === 'Supervisor' && frequenciaAtual.aprovado_supervisor === 'Sim') {
                    categoriasJaAprovadas.push(categoria);
                } else {
                    categoriasDisponiveis.push(categoria);
                }
            });
            
            // Se todas as categorias já aprovaram
            if (categoriasDisponiveis.length === 0) {
                if (categoriasJaAprovadas.length > 0) {
                    alert(`Você já aprovou esta frequência como: ${categoriasJaAprovadas.join(', ')}.`);
                } else {
                    alert('Esta frequência já está totalmente aprovada.');
                }
                return;
            }
            
            // Verificar se já está totalmente aprovada
            if (frequenciaAtual.aprovado_estagiario === 'Sim' && 
                frequenciaAtual.aprovado_orientador === 'Sim' && 
                frequenciaAtual.aprovado_supervisor === 'Sim') {
                alert('Esta frequência já está totalmente aprovada.');
                return;
            }
            
            // Se há múltiplas categorias disponíveis, permitir escolha
            let categoriaEscolhida;
            if (categoriasDisponiveis.length > 1) {
                const opcoes = categoriasDisponiveis.map((cat, index) => `${index + 1}. ${cat}`).join('\n');
                const escolha = prompt(`Você possui múltiplas funções neste estágio. Escolha como deseja aprovar:\n\n${opcoes}\n\nDigite o número da opção:`);
                
                const indice = parseInt(escolha) - 1;
                if (isNaN(indice) || indice < 0 || indice >= categoriasDisponiveis.length) {
                    alert('Opção inválida.');
                    return;
                }
                categoriaEscolhida = categoriasDisponiveis[indice];
            } else {
                categoriaEscolhida = categoriasDisponiveis[0];
            }
            
            // Mensagem personalizada com categoria escolhida
            const mensagem = `Tem certeza que deseja aprovar esta frequência como <b>${categoriaEscolhida}</b>?`;
            
            // Criar modal de confirmação personalizado
            const modalHtml = `
                <div class="modal fade" id="modalConfirmacaoAprovacao" tabindex="-1" role="dialog">
                    <div class="modal-dialog" role="document">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">Confirmar Aprovação</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <p>${mensagem}</p>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                <button type="button" class="btn btn-primary" id="btnConfirmarAprovacao">Confirmar</button>
                            </div>
                        </div>
                    </div>
                </div>
            `;
            
            // Remover modal existente se houver
            $('#modalConfirmacaoAprovacao').remove();
            
            // Adicionar modal ao body
            $('body').append(modalHtml);
            
            // Mostrar modal
            const modal = new bootstrap.Modal(document.getElementById('modalConfirmacaoAprovacao'));
            modal.show();
            
            // Configurar evento de confirmação
            $('#btnConfirmarAprovacao').off('click').on('click', function() {
                const modal = bootstrap.Modal.getInstance(document.getElementById('modalConfirmacaoAprovacao'));
                modal.hide();
                aprovarFrequencia(frequenciaSelecionadaId, categoriaEscolhida);
            });
            
        } catch (error) {
            console.error('Erro ao verificar categoria do usuário:', error);
            alert('Erro ao verificar categoria do usuário.');
        }
    }
    
    // Função auxiliar para aprovar frequência
    async function aprovarFrequencia(id, categoriaUsuario) {
        try {
            let tipoAprovacao = '';
            
            // Determinar tipo de aprovação baseado na categoria do usuário
            if (categoriaUsuario === 'Estagiário') {
                tipoAprovacao = 'estagiario';
            } else if (categoriaUsuario === 'Orientador') {
                tipoAprovacao = 'orientador';
            } else if (categoriaUsuario === 'Supervisor') {
                tipoAprovacao = 'supervisor';
            } else {
                alert('Você não tem permissão para aprovar frequências.');
                return;
            }
            
            const response = await fetch(`/frequencias/${id}/aprovar-${tipoAprovacao}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                }
            });
            
            const result = await response.json();
            
            if (result.success) {
                alert(`Frequência aprovada com sucesso como ${categoriaUsuario}!`);
                await AdminDashboard.carregarFrequencias(planoAtividadeSelecionadoId);
            } else {
                alert(result.message || 'Erro ao aprovar frequência');
            }
        } catch (error) {
            console.error('Erro ao aprovar frequência:', error);
            alert('Erro ao aprovar frequência');
        }
    }
    
    // Inicializar navegação quando a página carregar
    // Função para carregar o link do WhatsApp
    async function carregarLinkWhatsApp() {
        try {
            console.log('Iniciando carregamento do link do WhatsApp...');
            const url = '/parametro/buscar-valor?identificador=' + encodeURIComponent('Grupo WhatsApp') + '&identificadorValor=' + encodeURIComponent('Link do Estágio');
            console.log('URL da requisição:', url);
            
            const response = await fetch(url);
            console.log('Status da resposta:', response.status);
            
            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            
            const data = await response.json();
            console.log('Dados recebidos:', data);
            
            if (data.success && data.resultado && data.resultado.valor) {
                console.log('Link encontrado:', data.resultado.valor);
                const whatsappLink = document.getElementById('whatsappLink');
                if (whatsappLink) {
                    whatsappLink.href = data.resultado.valor;
                    whatsappLink.style.display = 'inline-block';
                    console.log('Link do WhatsApp configurado com sucesso!');
                } else {
                    console.error('Elemento whatsappLink não encontrado!');
                }
            } else {
                console.warn('Resposta da API não contém dados válidos:', data);
                // Notificar usuário sobre a falta dos parâmetros
                console.warn('Link do WhatsApp não encontrado: parâmetro "Grupo WhatsApp" com valor "Link do Estágio" não configurado.');
                
                // Criar notificação visual para o usuário
                const alertDiv = document.createElement('div');
                alertDiv.className = 'alert alert-warning alert-dismissible fade show mt-3';
                alertDiv.innerHTML = `
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    <strong>Atenção!</strong> Link do grupo WhatsApp não configurado. Entre em contato com o administrador para configurar o parâmetro "Grupo WhatsApp" com valor "Link do Estágio".
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                `;
                
                // Inserir a notificação após o header
                const container = document.querySelector('.container.mt-4');
                const headerRow = container.querySelector('.row.mb-3');
                if (container && headerRow) {
                    headerRow.insertAdjacentElement('afterend', alertDiv);
                }
            }
        } catch (error) {
            console.error('Erro detalhado ao carregar link do WhatsApp:', error);
            
            // Notificar usuário sobre erro de conexão
            const alertDiv = document.createElement('div');
            alertDiv.className = 'alert alert-danger alert-dismissible fade show mt-3';
            alertDiv.innerHTML = `
                <i class="fas fa-exclamation-circle me-2"></i>
                <strong>Erro!</strong> Não foi possível carregar o link do grupo WhatsApp. Verifique sua conexão ou entre em contato com o suporte.
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            `;
            
            const container = document.querySelector('.container.mt-4');
            const headerRow = container.querySelector('.row.mb-3');
            if (container && headerRow) {
                headerRow.insertAdjacentElement('afterend', alertDiv);
            }
        }
    }

    // Funções específicas para Plano de Atividade
    

    
    function mostrarLoadingPlanoAtividade(mostrar) {
        const cardBody = document.getElementById('cardPlanoAtividade');
        if (mostrar) {
            cardBody.innerHTML = `
                <div class="text-center py-3">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Carregando...</span>
                    </div>
                    <p class="text-muted mt-2 mb-0">Carregando planos de atividade...</p>
                </div>
            `;
        }
    }

    // Função para remover plano assinado (apenas para administradores)
    async function removerPlanoAssinado(planoId) {
        if (!confirm('Tem certeza que deseja remover o plano assinado?\n\nEsta ação não pode ser desfeita e o status será alterado para "Aprovado sem Anexo".')) {
            return;
        }
        
        try {
            const response = await fetch(`/planos-atividade/${planoId}/remover-assinado`, {
                method: 'DELETE',
                headers: {
                    'Content-Type': 'application/json'
                }
            });
            
            const result = await response.json();
            
            if (result.success) {
                alert('Plano assinado removido com sucesso!');
                // Recarregar a página para atualizar a interface
                window.location.reload();
            } else {
                alert(result.message || 'Erro ao remover plano assinado');
            }
        } catch (error) {
            console.error('Erro ao remover plano assinado:', error);
            alert('Erro ao remover plano assinado');
        }
    }

    document.addEventListener('DOMContentLoaded', function() {
        if (registrosOriginais.length > 0) {
            atualizarExibicaoRegistro();
        }
        // Carregar link do WhatsApp
        carregarLinkWhatsApp();
    });

</script>

