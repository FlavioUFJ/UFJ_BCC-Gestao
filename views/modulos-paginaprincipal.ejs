<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
   
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        
        .dashboard-container {
            padding: 2rem 0;
        }
        
        .page-title {
            text-align: center;
            color: #2c5aa0;
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 3rem;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.1);
        }
        
        .welcome-card {
            background: rgba(255, 255, 255, 0.95);
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            padding: 2rem;
            margin-bottom: 2rem;
            backdrop-filter: blur(10px);
        }
        
        .module-card {
            background: rgba(255, 255, 255, 0.95);
            border-radius: 15px;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
            padding: 2rem;
            margin-bottom: 1.5rem;
            transition: all 0.3s ease;
            cursor: pointer;
            text-decoration: none;
            color: inherit;
            backdrop-filter: blur(10px);
            border: 2px solid transparent;
        }
        
        .module-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.15);
            text-decoration: none;
            color: inherit;
            border-color: rgba(255, 255, 255, 0.3);
        }
        
        .module-card-disabled {
            filter: grayscale(100%);
            pointer-events: none;
        }
        
        .module-card-disabled:hover {
            transform: none;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }
        
        .module-icon {
            font-size: 3rem;
            margin-bottom: 1rem;
            display: block;
        }
        
        .module-title {
            font-size: 1.5rem;
            font-weight: 600;
            margin-bottom: 0.5rem;
        }
        
        .module-description {
            color: #495057;
            font-size: 0.95rem;
            line-height: 1.4;
        }
        
        .user-info {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 10px;
            padding: 1rem;
            margin-bottom: 1rem;
        }
        

        
        .no-modules {
            text-align: center;
            padding: 3rem;
            color: #6c757d;
        }
        
        .no-modules i {
            font-size: 4rem;
            margin-bottom: 1rem;
            opacity: 0.5;
        }
        
        @media (max-width: 768px) {
            .dashboard-container {
                padding: 1rem;
            }
            
            .welcome-card, .module-card {
                padding: 1.5rem;
            }
            
            .module-icon {
                font-size: 2.5rem;
            }
            

        }
    </style>
</head>
<body>
    <div class="container dashboard-container" style="margin-top: 20px;">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <!-- Mensagem de boas-vindas -->
                <div class="welcome-message text-center mb-4">
                    <h3 style="color: #ffffff; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; font-weight: 500; font-size: 1.5rem; margin-bottom: 0;">Bem-vindo(a) <%= user.nome %></h3>
                </div>
                <!-- Título personalizado -->
                <div class="welcome-section text-center mb-5">
                    <h1 class="mb-1" style="color: #2c3e50; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; font-weight: 600; font-size: 2rem; line-height: 1.1;">Ciência da Computação - BCC/UFJ</h1>
                    <h2 class="mb-4" style="color: #34495e; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; font-weight: 400; font-size: 1.4rem; line-height: 1.2;">CoordenAI - Gestão Inteligente</h2>
                </div>
                <!-- Cards dos Módulos -->
                <% if (modulos && modulos.length > 0) { %>
                    <div class="row">
                        <% modulos.forEach(modulo => { %>
                            <div class="col-lg-6 col-md-6 mb-4">
                                <% if (modulo.tem_acesso) { %>
                                    <a href="<%= modulo.url %>" class="module-card d-block">
                                        <div class="text-center">
                                            <i class="<%= modulo.icone %> module-icon" data-color="<%= modulo.cor || '#667eea' %>"></i>
                                            <h3 class="module-title"><%= modulo.nome %></h3>
                                            <p class="module-description"><%= modulo.descricao %></p>
                                        </div>
                                    </a>
                                <% } else { %>
                                     <div class="module-card module-card-disabled d-block" style="cursor: not-allowed; opacity: 0.6; background: rgba(245, 245, 245, 0.95);">
                                         <div class="text-center">
                                             <i class="<%= modulo.icone %> module-icon" style="color: #999;"></i>
                                             <h3 class="module-title" style="color: #999;"><%= modulo.nome %></h3>
                                             <p class="module-description" style="color: #999;"><%= modulo.descricao %></p>
                                         </div>
                                     </div>
                                 <% } %>
                            </div>
                        <% }); %>
                    </div>
                <% } else { %>
                    <div class="welcome-card">
                        <div class="no-modules">
                            <i class="fas fa-exclamation-triangle"></i>
                            <h4>Nenhum módulo disponível</h4>
                            <p>Entre em contato com o administrador para liberar o acesso aos módulos.</p>
                        </div>
                    </div>
                <% } %>
            </div>
        </div>
        
        <!-- Botão Encerrar Login -->
        <div class="text-center mt-5 mb-4">
            <a href="/logout" class="btn btn-outline-light">
                <i class="fas fa-sign-out-alt me-2"></i>
                Encerrar Login
            </a>
        </div>
        
        <!-- Rodapé -->
        <div class="row mt-5">
            <div class="col-12">
                <footer class="text-center py-4" style="border-top: 1px solid #e9ecef; margin-top: 3rem; background-color: #2c3e50;">
                     <p class="mb-0" style="color: white; font-size: 0.9rem; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;">
                         UFJ – BCC | <strong>Flávio Ferreira Borges</strong> | By Trae | 2025
                     </p>
                 </footer>
            </div>
        </div>
    </div>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js" integrity="sha512-v2CJ7UaYy4JwqLDIrZUI/4hqeoQieOmAZNXBeQyjo21dadnwR+8ZaIJVT8EE2iyI61OV8e6M8PP2/4hpQINQ/g==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script>
        // Aplicar cores dos módulos dinamicamente
        document.addEventListener('DOMContentLoaded', function() {
            const moduleIcons = document.querySelectorAll('.module-icon[data-color]');
            moduleIcons.forEach(function(icon) {
                const color = icon.getAttribute('data-color');
                if (color) {
                    icon.style.color = color;
                }
            });
        });
    </script>
</body>
</html>