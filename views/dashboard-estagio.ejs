<div class="container mt-4">
    <!-- Header Administrativo -->
    <div class="row mb-3">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h3 class="mb-1" style="color: #333; font-weight: 600;"><i class="fas fa-graduation-cap me-2"></i>Módulo Estágio</h3>
                    <p class="mb-0" style="color: #666;">Painel Principal</p>
                </div>
                <div class="d-flex gap-2">
                    <!-- Botão Visão Administrativa (apenas para administradores) -->
                    <% if (user && user.nivelacesso === 'Administrador') { %>
                        <a href="/secure/estagios/dashboard-administrativo" class="btn btn-warning btn-sm">
                            <i class="fas fa-chart-line me-2"></i>Visão Administrativa
                        </a>
                    <% } %>
                    
                    <!-- Link do WhatsApp -->
                    <a href="#" id="whatsappLink" class="btn btn-success btn-sm" style="display: none;" target="_blank">
                        <i class="fab fa-whatsapp me-2"></i>Entre no Grupo do WhatsApp
                    </a>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Mensagens de Feedback -->
    <% if (typeof success !== 'undefined' && success) { %>
    <div class="row mb-4">
        <div class="col-12">
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fas fa-check-circle me-2"></i>
                <strong>Sucesso!</strong> <%= success %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        </div>
    </div>
    <% } %>
    
    <% if (typeof error !== 'undefined' && error) { %>
    <div class="row mb-4">
        <div class="col-12">
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fas fa-exclamation-triangle me-2"></i>
                <strong>Erro!</strong> <%= error %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        </div>
    </div>
    <% } %>



    <!-- Cards das Rotinas do Módulo Estágio -->
    <div class="row mb-4">
        <!-- Card Campo de Estágio -->
        <div class="col-lg-4 col-md-6 mb-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-building fa-2x me-3"></i>
                            <div>
                                <h5 class="mb-0">Campo de Estágio</h5>
                            </div>
                        </div>
                        <span class="badge bg-light text-dark" id="contadorCampoEstagioTitulo">
                            <% if (camposEstagio && camposEstagio.length > 0) { %>
                                1/<%= camposEstagio.length %>
                            <% } else { %>
                                0/0
                            <% } %>
                        </span>
                    </div>
                </div>
                <div class="card-body" id="cardCampoEstagio">
                    <% if (camposEstagio && camposEstagio.length > 0) { %>
                        <div class="mb-3" id="campoEstagioContent">
                            <!-- Primeira linha: Concedente e Situação -->
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <strong id="concedenteAtual"><%= camposEstagio[0].nome_concedente || 'N/A' %></strong>
                                <% if (camposEstagio && camposEstagio.length > 0) { %>
                                    <span class="badge" style="background-color: #ffc107; color: #000; font-weight: bold;" id="situacaoAtual">
                                        <%= camposEstagio[0].situacao || 'N/A' %>
                                    </span>
                                <% } else { %>
                                    <span class="badge bg-secondary" id="situacaoAtual">N/A</span>
                                <% } %>
                            </div>
                            <p class="mb-2 text-muted"><small>Local do Estágio</small></p>
                            
                            <div class="row mb-2">
                                <div class="col-4">
                                    <strong>Início:</strong> <span id="inicioAtual"><%= camposEstagio[0].data_inicio ? new Date(camposEstagio[0].data_inicio).toLocaleDateString('pt-BR') : 'N/A' %></span>
                                </div>
                                <div class="col-4">
                                    <strong>Fim:</strong> <span id="fimAtual"><%= camposEstagio[0].ce_data_fim ? new Date(camposEstagio[0].ce_data_fim).toLocaleDateString('pt-BR') : 'N/A' %></span>
                                </div>
                                <div class="col-4">
                                    <strong>CH:</strong> <%= camposEstagio[0].cargahoraria || 'N/A' %>h
                                </div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-4 text-center">
                                    <div class="fw-bold" id="estagiarioAtual"><%= camposEstagio[0].nome_estagiario || 'N/A' %></div>
                                    <small class="text-muted">Estagiário</small>
                                </div>
                                <div class="col-4 text-center">
                                    <div class="fw-bold" id="orientadorAtual"><%= camposEstagio[0].nome_orientador || 'N/A' %></div>
                                    <small class="text-muted">Orientador</small>
                                </div>
                                <div class="col-4 text-center">
                                    <div class="fw-bold" id="supervisorAtual"><%= camposEstagio[0].nome_supervisor || 'N/A' %></div>
                                    <small class="text-muted">Supervisor</small>
                                </div>
                            </div>
                        </div>
                        

                    <% } else { %>
                        <div class="text-center py-3">
                            <i class="fas fa-inbox fa-3x text-muted mb-2"></i>
                            <p class="text-muted mb-0">Nenhum campo de estágio cadastrado</p>
                        </div>
                    <% } %>
                </div>
                <div class="card-footer bg-transparent">
                    <div class="d-flex justify-content-between mb-3">
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-success btn-sm" id="btnCampEstNovo" onclick="campEstNovo()">
                                <i class="fas fa-plus me-1"></i>Novo
                            </button>
                            <button type="button" class="btn btn-outline-primary btn-sm" id="btnCampEstEditar" onclick="campEstEditar()">
                                <i class="fas fa-edit me-1"></i>Editar
                            </button>
                        </div>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-outline-info btn-sm" id="btnCampEstGerarPDF" onclick="campEstGerarPDF()">
                                <i class="fas fa-file-pdf me-1"></i>Gerar
                            </button>
                        </div>
                    </div>
                    
                    <% if (camposEstagio && camposEstagio.length > 1) { %>
                        <!-- Barra de navegação -->
                        <div class="d-flex align-items-center justify-content-between p-2 bg-light rounded">
                            <button type="button" class="btn btn-sm btn-outline-secondary" id="btnCampEstAnterior" onclick="campEstNavegar(-1)">
                                <i class="fas fa-chevron-left"></i>
                            </button>
                            
                            <div class="flex-grow-1 mx-2">
                                <input type="text" class="form-control form-control-sm" id="campEstBusca" placeholder="Buscar por estagiário, orientador..." onkeyup="campEstFiltrar()">
                            </div>
                            
                            <button type="button" class="btn btn-sm btn-outline-secondary" id="btnCampEstProximo" onclick="campEstNavegar(1)">
                                <i class="fas fa-chevron-right"></i>
                            </button>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- Card Plano de Atividade -->
        <div class="col-lg-4 col-md-6 mb-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-header bg-success text-white">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-tasks fa-2x me-3"></i>
                        <div>
                            <h5 class="mb-0">Plano de Atividade</h5>
                        </div>
                    </div>
                </div>
                <div class="card-body" id="cardPlanoAtividade">
                    <div class="text-center py-3">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Carregando...</span>
                        </div>
                        <p class="text-muted mt-2 mb-0">Carregando planos de atividade...</p>
                    </div>
                </div>
                <div class="card-footer bg-transparent">
                    <div class="d-flex justify-content-between">
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-success btn-sm" id="btnPlanAtiNovo" onclick="planAtiNovo()" title="Criar novo plano de atividade">
                                <i class="fas fa-plus me-1"></i>Novo
                            </button>
                            <button type="button" class="btn btn-outline-primary btn-sm" id="btnPlanAtiEditar" onclick="planAtiEditar()" title="Editar plano de atividade selecionado">
                                <i class="fas fa-edit me-1"></i>Editar
                            </button>
                        </div>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-outline-info btn-sm" id="btnPlanAtiGerarPDF" onclick="planAtiGerarPDF()" title="Gerar PDF do plano de atividade">
                                <i class="fas fa-file-pdf me-1"></i>Gerar
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card Frequência -->
        <div class="col-lg-4 col-md-6 mb-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-header bg-warning text-white">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-calendar-check fa-2x me-3"></i>
                            <div>
                                <h5 class="mb-0">Frequência</h5>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-body" id="frequenciaContent">
                    <div class="text-center py-4" id="frequenciaLoading">
                        <div class="spinner-border spinner-border-sm" role="status">
                            <span class="visually-hidden">Carregando...</span>
                        </div>
                        <p class="text-muted mt-2 mb-0">Carregando frequências...</p>
                    </div>
                    <div id="frequenciaData" style="display: none;">
                        <!-- Nome do estagiário -->
                        <div class="text-center mb-3">
                            <h6 class="mb-0" id="frequenciaNomeEstagiario">-</h6>
                        </div>
                        
                        <!-- Informações da frequência -->
                        <div class="row mb-2">
                            <div class="col-4">
                                <small class="text-muted">Mês:</small>
                                <div class="fw-bold" id="frequenciaMesReferencia">-</div>
                            </div>
                            <div class="col-4">
                                <small class="text-muted">Abertura:</small>
                                <div class="small" id="frequenciaDataAbertura">-</div>
                            </div>
                            <div class="col-4">
                                <small class="text-muted">Encerramento:</small>
                                <div class="small" id="frequenciaDataEncerramento">-</div>
                            </div>
                        </div>
                        
                        <!-- Total de horas -->
                        <div class="text-center mb-3">
                            <small class="text-muted d-block">Total de horas do mês</small>
                            <div class="h4 fw-bold text-primary" id="frequenciaTotalHoras">00:00</div>
                        </div>
                        
                        <!-- Status de aprovações -->
                        <div class="text-center mb-2">
                            <small class="text-muted">Frequência aprovada pelo...</small>
                        </div>
                        <div class="row text-center mb-3">
                            <div class="col-4">
                                <small class="text-muted d-block">Estagiário</small>
                                <span class="badge" id="frequenciaAprovadoEstagiario">-</span>
                            </div>
                            <div class="col-4">
                                <small class="text-muted d-block">Orientador</small>
                                <span class="badge" id="frequenciaAprovadoOrientador">-</span>
                            </div>
                            <div class="col-4">
                                <small class="text-muted d-block">Supervisor</small>
                                <span class="badge" id="frequenciaAprovadoSupervisor">-</span>
                            </div>
                        </div>
                        
                        <!-- Link para aprovar frequência -->
                        <div class="text-center">
                            <a href="#" class="text-success text-decoration-none" id="linkFreqAtiAprovar" onclick="frequenciaAprovar()">
                                <i class="fas fa-check-circle me-1"></i>Aprovar frequência
                            </a>
                        </div>
                    </div>
                    <div id="frequenciaSemDados" style="display: none;">
                        <div class="text-center py-3">
                            <i class="fas fa-info-circle fa-2x text-muted mb-2"></i>
                            <p class="text-muted mb-3">Selecione um plano de atividade para visualizar as frequências</p>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-transparent">
                    <div class="d-flex justify-content-between mb-3">
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-warning btn-sm" id="btnFreqAtiNovo" onclick="frequenciaNovo()">
                                <i class="fas fa-plus me-1"></i>Novo
                            </button>
                            <button type="button" class="btn btn-outline-primary btn-sm" id="btnFreqAtiEditar" onclick="frequenciaEditar()">
                                <i class="fas fa-edit me-1"></i>Editar
                            </button>
                            <button type="button" class="btn btn-warning btn-sm" id="btnFreqAtiLancar" onclick="frequenciaLancarDia()">
                                <i class="fas fa-calendar-plus me-1"></i>Lançar Dia
                            </button>
                        </div>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-outline-info btn-sm" id="btnFreqAtiGerarPDF" onclick="frequenciaGerarPDF()">
                                <i class="fas fa-file-pdf me-1"></i>Gerar
                            </button>
                        </div>
                    </div>
                    
                    <!-- Barra de navegação -->
                    <div class="d-flex align-items-center justify-content-between p-2 bg-light rounded">
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="btnFreqAtiAnterior" onclick="frequenciaNavegar('anterior')">
                            <i class="fas fa-chevron-left"></i>
                        </button>
                        
                        <div class="flex-grow-1 mx-2">
                            <input type="text" class="form-control form-control-sm" id="freqAtiBusca" placeholder="Buscar frequências..." onkeyup="frequenciaFiltrar()">
                        </div>
                        
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="btnFreqAtiProximo" onclick="frequenciaNavegar('proximo')">
                            <i class="fas fa-chevron-right"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card Relatórios -->
        <div class="col-lg-4 col-md-6 mb-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-header bg-info text-white">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-file-alt fa-2x me-3"></i>
                            <div>
                                <h5 class="mb-0">Relatórios</h5>
                                <small class="opacity-75">Parciais e/ou Final</small>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="text-center py-4">
                        <i class="fas fa-tools fa-3x text-muted mb-3"></i>
                        <p class="text-muted mb-0"><strong>Em desenvolvimento</strong></p>
                        <small class="text-muted">Funcionalidade será implementada em breve</small>
                    </div>
                </div>
                <div class="card-footer bg-transparent">
                    <div class="d-flex justify-content-between mb-3">
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-info btn-sm" id="btnRelAtiNovo" disabled title="Funcionalidade em desenvolvimento">
                                <i class="fas fa-plus me-1"></i>Novo
                            </button>
                            <button type="button" class="btn btn-outline-primary btn-sm" id="btnRelAtiEditar" disabled title="Funcionalidade em desenvolvimento">
                                <i class="fas fa-edit me-1"></i>Editar
                            </button>
                        </div>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-outline-info btn-sm" id="btnRelAtiGerarPDF" disabled title="Funcionalidade em desenvolvimento">
                                <i class="fas fa-file-pdf me-1"></i>Gerar
                            </button>
                            <button type="button" class="btn btn-outline-success btn-sm" id="btnRelAtiAvaliar" disabled title="Funcionalidade em desenvolvimento">
                                <i class="fas fa-star me-1"></i>Avaliar
                            </button>
                        </div>
                    </div>
                    
                    <!-- Barra de navegação desabilitada -->
                    <div class="d-flex align-items-center justify-content-between p-2 bg-light rounded opacity-50">
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="btnRelAtiAnterior" disabled>
                            <i class="fas fa-chevron-left"></i>
                        </button>
                        
                        <div class="flex-grow-1 mx-2">
                            <input type="text" class="form-control form-control-sm" id="relAtiBusca" placeholder="Buscar relatórios..." disabled>
                        </div>
                        
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="btnRelAtiProximo" disabled>
                            <i class="fas fa-chevron-right"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>



<!-- Modal simples para detalhes do estagiário -->
<div id="detalhesModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 9999;">
    <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); background: white; border-radius: 8px; padding: 20px; max-width: 600px; width: 90%; max-height: 80vh; overflow-y: auto;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; border-bottom: 1px solid #dee2e6; padding-bottom: 10px;">
            <h5 style="margin: 0; color: #495057;"><i class="fas fa-user me-2"></i>Detalhes do Estagiário</h5>
            <button onclick="fecharModal()" style="background: none; border: none; font-size: 24px; cursor: pointer; color: #6c757d;">&times;</button>
        </div>
        <div id="detalhesContent">
            <div style="text-align: center; padding: 20px;">
                <div class="spinner-border spinner-border-sm" role="status">
                    <span class="visually-hidden">Carregando...</span>
                </div>
            </div>
        </div>
        <div style="margin-top: 15px; text-align: right; border-top: 1px solid #dee2e6; padding-top: 10px;">
            <button onclick="fecharModal()" class="btn btn-secondary btn-sm">Fechar</button>
        </div>
    </div>
</div>

<script>
    // Variáveis globais para planos de atividade
    let planosAtividade = [];
    let planoAtividadeAtualIndex = 0;
    let planoAtividadeSelecionadoId = null;
    
    // Variáveis globais para frequências
    let frequencias = [];
    let frequenciaAtualIndex = 0;
    let frequenciaSelecionadaId = null;
    let frequenciasFiltradas = [];
    
    // Objeto principal para gerenciar o dashboard administrativo
    const AdminDashboard = {
        // Estado do modal
        modalAberto: false,
        linhaAtiva: null,
        
        // Inicialização
        init() {
            this.setupEventListeners();
            this.setupModalEventListeners();
            this.carregarCamposEstagio();
            this.carregarPlanosAtividade();
            // Não carregar frequências na inicialização - só quando um plano for selecionado
            this.carregarRelatorios();
        },
        
        // Carregar dados de Campo de Estágio
        async carregarCamposEstagio() {
            try {
                // Os dados já estão disponíveis na variável registrosOriginais
                // que é preenchida pelo servidor
                console.log('Carregando campos de estágio...', registrosOriginais);
                if (typeof registrosOriginais !== 'undefined' && registrosOriginais && registrosOriginais.length > 0) {
                    registrosFiltrados = [...registrosOriginais];
                    indiceAtual = 0;
                    // Chamar a função global atualizarExibicaoRegistro
                    if (typeof atualizarExibicaoRegistro === 'function') {
                        atualizarExibicaoRegistro();
                    } else {
                        console.error('Função atualizarExibicaoRegistro não encontrada');
                    }
                } else {
                    console.log('Nenhum campo de estágio encontrado ou registrosOriginais não definido');
                    // Exibir mensagem de nenhum registro encontrado
                    const campoContent = document.getElementById('campoEstagioContent');
                    if (campoContent) {
                        campoContent.innerHTML = '<div class="text-center py-3"><i class="fas fa-search fa-2x text-muted mb-2"></i><p class="text-muted mb-0">Nenhum registro encontrado</p></div>';
                    }
                }
            } catch (error) {
                console.error('Erro ao carregar campos de estágio:', error);
            }
        },
        
        // Carregar dados de Frequência
        async carregarFrequencias(planoAtividadeId = null) {
            try {
                console.log('Carregando dados de frequência...', planoAtividadeId ? `para plano ${planoAtividadeId}` : '');
                
                const response = await fetch('/frequencias', {
                    method: 'GET',
                    headers: {
                        'Accept': 'application/json'
                    }
                });
                
                if (response.ok) {
                    const result = await response.json();
                    if (result.success && result.data) {
                        let frequenciasCarregadas = result.data;
                        
                        // Filtrar frequências pelo plano de atividade se especificado
                        if (planoAtividadeId) {
                            frequenciasCarregadas = frequenciasCarregadas.filter(freq => 
                                freq.id_planoatividade == planoAtividadeId
                            );
                        }
                        
                        frequencias = frequenciasCarregadas;
                        frequenciaAtualIndex = 0;
                        atualizarExibicaoFrequencia();
                    } else {
                        console.log('Nenhuma frequência encontrada');
                        // Verificar se há plano de atividade selecionado para mostrar mensagem específica
                        if (planoAtividadeSelecionadoId) {
                            mostrarFrequenciaSemDados('Não existe frequência iniciada para lançamento.');
                        } else {
                            mostrarFrequenciaSemDados('Selecione um plano de atividade para visualizar as frequências');
                        }
                    }
                } else {
                    console.error('Erro ao carregar frequências:', response.status);
                    mostrarFrequenciaSemDados('Erro ao carregar frequências');
                }
            } catch (error) {
                console.error('Erro ao carregar frequências:', error);
                mostrarFrequenciaSemDados('Erro ao carregar frequências');
            }
        },
        
        // Carregar dados de Relatórios
        async carregarRelatorios() {
            try {
                // Implementação futura - dados de relatórios
                console.log('Carregando dados de relatórios...');
            } catch (error) {
                console.error('Erro ao carregar relatórios:', error);
            }
        },
        
        // Carregar planos de atividade
        async carregarPlanosAtividade(campoEstagioId = null, carregarFrequencias = false) {
            try {
                mostrarLoadingPlanoAtividade(true);
                
                const response = await fetch('/planos-atividade', {
                    headers: {
                        'Accept': 'application/json',
                        'Content-Type': 'application/json'
                    }
                });
                const result = await response.json();
                
                if (result.success) {
                    let planosCarregados = result.data || [];
                    
                    // Filtrar planos pelo campo de estágio se especificado
                    if (campoEstagioId) {
                        planosCarregados = planosCarregados.filter(plano => 
                            plano.pa_id_campo_estagio == campoEstagioId
                        );
                    }
                    
                    planosAtividade = planosCarregados;
                    planosAtividadeOriginais = [...planosCarregados];
                    planosAtividadeFiltrados = [...planosCarregados];
                    planoAtividadeAtualIndex = 0;
                    planoAtividadeSelecionadoId = null;
                    
                    this.atualizarExibicaoPlanoAtividade(carregarFrequencias);
