<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Plano de Atividade - <%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        .form-section {
            background: #f8f9fa;
            border-radius: 8px;
            padding: 20px;
            margin-bottom: 20px;
        }
        .section-title {
            color: #495057;
            border-bottom: 2px solid #dee2e6;
            padding-bottom: 10px;
            margin-bottom: 20px;
        }
        .info-header {
            background: linear-gradient(135deg, #007bff, #0056b3);
            color: white;
            border-radius: 8px;
            padding: 20px;
            margin-bottom: 30px;
        }
    </style>
</head>
<body>
    <div class="container mt-4">
        <!-- Cabeçalho com informações do Campo de Estágio -->
        <div class="info-header">
            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <h5 class="mb-0 text-muted"><i class="fas fa-clipboard-list me-2"></i>Plano de Atividade</h5>
                    <div class="text-end">
                         <small class="text-muted" style="font-style: italic; font-weight: bold; color: black;">Período do estágio</small>
                         <div class="small">
                             <% if (campoEstagio && campoEstagio.data_inicial) { %>
                                 <%= new Date(campoEstagio.data_inicial).toLocaleDateString('pt-BR') %>
                             <% } else { %>
                                 Não informado
                             <% } %> - 
                             <% if (campoEstagio && campoEstagio.data_final && campoEstagio.data_final !== 'null' && campoEstagio.data_final.trim() !== '') { %>
                                 <% try { %>
                                     <%= new Date(campoEstagio.data_final).toLocaleDateString('pt-BR') %>
                                 <% } catch(e) { %>
                                     <%= campoEstagio.data_final %>
                                 <% } %>
                             <% } else { %>
                                 Não informado
                             <% } %>
                         </div>
                     </div>
                </div>
                <p class="mb-3"><strong><%= campoEstagio ? campoEstagio.empresa : 'Não informado' %></strong></p>
                <div class="d-flex justify-content-between text-center">
                    <div class="flex-fill">
                        <div class="small"><%= campoEstagio ? campoEstagio.nome_estagiario : 'Não informado' %></div>
                        <small class="text-muted" style="font-style: italic;">Estagiário</small>
                    </div>
                    <div class="flex-fill">
                        <div class="small"><%= campoEstagio ? campoEstagio.nome_orientador : 'Não informado' %></div>
                        <small class="text-muted" style="font-style: italic;">Orientador</small>
                    </div>
                    <div class="flex-fill">
                        <div class="small"><%= campoEstagio ? campoEstagio.nome_supervisor : 'Não informado' %></div>
                        <small class="text-muted" style="font-style: italic;">Supervisor</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Formulário -->
        <form id="formPlanoAtividade" method="POST" action="<%= plano ? `/planos-atividade/${plano.id_campo_estagio_planoatividade}` : '/planos-atividade' %>">
            <% if (plano) { %>
                <input type="hidden" name="_method" value="PUT">
            <% } %>
            <input type="hidden" name="id_campo_estagio" value="<%= campoEstagio ? campoEstagio.id_campo_estagio : '' %>">

            <!-- Seção: Informações Gerais -->
            <div class="form-section">
                <h5 class="section-title"><i class="fas fa-info-circle me-2"></i>Informações Gerais</h5>
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="situacao" class="form-label">Situação *</label>
                            <select class="form-select" id="situacao" name="situacao" required>
                                <option value="Em edição" <%= plano && plano.situacao === 'Em edição' ? 'selected' : '' %>>Em edição</option>
                                <option value="Aprovado" <%= plano && plano.situacao === 'Aprovado' ? 'selected' : '' %>>Aprovado</option>
                                <option value="Reprovado" <%= plano && plano.situacao === 'Reprovado' ? 'selected' : '' %>>Reprovado</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="estagiarioapto" class="form-label">Estagiário Apto *</label>
                            <select class="form-select" id="estagiarioapto" name="estagiarioapto" required>
                                <option value="">Selecione uma opção</option>
                                <option value="Sim" <%= plano && plano.estagiarioapto === 'Sim' ? 'selected' : '' %>>Sim</option>
                                <option value="Não" <%= plano && plano.estagiarioapto === 'Não' ? 'selected' : '' %>>Não</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label for="data_inicial" class="form-label">Data Inicial *</label>
                            <input type="date" class="form-control" id="data_inicial" name="data_inicial" 
                                   value="<% if (plano && plano.data_inicial) { %><%= new Date(plano.data_inicial).toISOString().split('T')[0] %><% } else if (campoEstagio && campoEstagio.data_inicial && campoEstagio.data_inicial !== 'null' && campoEstagio.data_inicial.trim() !== '') { %><% try { %><%= new Date(campoEstagio.data_inicial).toISOString().split('T')[0] %><% } catch(e) { %><% } %><% } %>" required>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label for="data_final" class="form-label">Data Final *</label>
                            <input type="date" class="form-control" id="data_final" name="data_final" 
                                   value="<% if (plano && plano.data_final) { %><%= new Date(plano.data_final).toISOString().split('T')[0] %><% } else if (campoEstagio && campoEstagio.data_final && campoEstagio.data_final !== 'null' && campoEstagio.data_final.trim() !== '') { %><% try { %><%= new Date(campoEstagio.data_final).toISOString().split('T')[0] %><% } catch(e) { %><% } %><% } %>" required>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label for="cargahoraria" class="form-label">Carga Horária (horas/semana) *</label>
                            <input type="number" class="form-control" id="cargahoraria" name="cargahoraria" 
                                   value="<%= plano ? plano.cargahoraria : '' %>" min="1" max="40" required>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Seção: Atividades -->
            <div class="form-section">
                <h5 class="section-title"><i class="fas fa-tasks me-2"></i>Atividades a Desenvolver</h5>
                <div class="mb-3">
                    <label for="atividades" class="form-label">Descrição das Atividades *</label>
                    <textarea class="form-control" id="atividades" name="atividades" rows="6" required><%= plano ? plano.atividades : '' %></textarea>
                    <div class="form-text">Descreva as principais atividades, responsabilidades e tarefas que o estagiário irá executar.</div>
                </div>
            </div>

            <!-- Seção: Objetivos -->
            <div class="form-section">
                <h5 class="section-title"><i class="fas fa-bullseye me-2"></i>Objetivos</h5>
                <div class="mb-3">
                    <label for="objetivos" class="form-label">Objetivos do Estágio *</label>
                    <textarea class="form-control" id="objetivos" name="objetivos" rows="5" required><%= plano ? plano.objetivos : '' %></textarea>
                    <div class="form-text">Especifique os objetivos de aprendizagem, competências técnicas e comportamentais a serem desenvolvidas.</div>
                </div>
            </div>

            <!-- Seção: Cronograma -->
            <div class="form-section">
                <h5 class="section-title"><i class="fas fa-calendar-alt me-2"></i>Cronograma</h5>
                <div class="mb-3">
                    <label for="cronograma" class="form-label">Cronograma de Atividades *</label>
                    <textarea class="form-control" id="cronograma" name="cronograma" rows="5" required><%= plano ? plano.cronograma : '' %></textarea>
                    <div class="form-text">Organize as atividades por períodos (semanal, mensal) com marcos e entregas esperadas.</div>
                </div>
            </div>

            <!-- Seção: Recursos -->
            <div class="form-section">
                <h5 class="section-title"><i class="fas fa-tools me-2"></i>Recursos Necessários</h5>
                <div class="mb-3">
                    <label for="recursos" class="form-label">Recursos e Materiais</label>
                    <textarea class="form-control" id="recursos" name="recursos" rows="4"><%= plano ? plano.recursos : '' %></textarea>
                    <div class="form-text">Especifique equipamentos, softwares, materiais e outros recursos necessários para o desenvolvimento das atividades.</div>
                </div>
            </div>

            <!-- Botões de Ação -->
            <div class="d-flex justify-content-between">
                <button type="button" class="btn btn-secondary" onclick="history.back()">
                    <i class="fas fa-arrow-left me-2"></i>Voltar
                </button>
                <div>
                    <button type="button" class="btn btn-outline-primary me-2" onclick="limparFormulario()">
                        <i class="fas fa-eraser me-2"></i>Limpar
                    </button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-2"></i><%= plano ? 'Atualizar' : 'Salvar' %> Plano
                    </button>
                </div>
            </div>
        </form>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Datas do campo de estágio para validação
        const dataInicialCampo = new Date('<%= campoEstagio && campoEstagio.data_inicial ? campoEstagio.data_inicial : '' %>');
        const dataFinalCampo = new Date('<%= campoEstagio && campoEstagio.data_final ? campoEstagio.data_final : '' %>');

        // Validação de datas
        document.getElementById('data_inicial').addEventListener('change', function() {
            const dataInicial = new Date(this.value);
            const dataFinalInput = document.getElementById('data_final');
            
            // Validar se data inicial é >= data inicial do campo
            if (dataInicialCampo && dataInicial < dataInicialCampo) {
                alert('A data inicial do plano não pode ser menor que a data inicial do estágio (' + dataInicialCampo.toLocaleDateString('pt-BR') + ').');
                this.value = '';
                return;
            }
            
            if (dataFinalInput.value) {
                const dataFinal = new Date(dataFinalInput.value);
                if (dataInicial >= dataFinal) {
                    alert('A data inicial deve ser anterior à data final.');
                    this.value = '';
                }
            }
        });

        document.getElementById('data_final').addEventListener('change', function() {
            const dataFinal = new Date(this.value);
            const dataInicialInput = document.getElementById('data_inicial');
            
            // Validar se data final é <= data final do campo
            if (dataFinalCampo && dataFinal > dataFinalCampo) {
                alert('A data final do plano não pode ser maior que a data final do estágio (' + dataFinalCampo.toLocaleDateString('pt-BR') + ').');
                this.value = '';
                return;
            }
            
            if (dataInicialInput.value) {
                const dataInicial = new Date(dataInicialInput.value);
                if (dataFinal <= dataInicial) {
                    alert('A data final deve ser posterior à data inicial.');
                    this.value = '';
                }
            }
        });

        // Função para limpar formulário
        function limparFormulario() {
            if (confirm('Tem certeza que deseja limpar todos os campos do formulário?')) {
                document.getElementById('formPlanoAtividade').reset();
            }
        }

        // Validação do formulário antes do envio
        document.getElementById('formPlanoAtividade').addEventListener('submit', function(e) {
            const dataInicial = new Date(document.getElementById('data_inicial').value);
            const dataFinal = new Date(document.getElementById('data_final').value);
            
            // Validar datas em relação ao campo de estágio
            if (dataInicialCampo && dataInicial < dataInicialCampo) {
                e.preventDefault();
                alert('A data inicial do plano não pode ser menor que a data inicial do estágio.');
                return false;
            }
            
            if (dataFinalCampo && dataFinal > dataFinalCampo) {
                e.preventDefault();
                alert('A data final do plano não pode ser maior que a data final do estágio.');
                return false;
            }
            
            if (dataInicial >= dataFinal) {
                e.preventDefault();
                alert('A data inicial deve ser anterior à data final.');
                return false;
            }

            // Validar se o campo de estágio foi informado
            const campoEstagioId = document.querySelector('input[name="id_campo_estagio"]').value;
            if (!campoEstagioId) {
                e.preventDefault();
                alert('É necessário selecionar um Campo de Estágio antes de criar o Plano de Atividade.');
                return false;
            }

            // Validar se o campo estagiarioapto foi preenchido
            const estagiarioApto = document.getElementById('estagiarioapto').value;
            if (!estagiarioApto || estagiarioApto === '') {
                e.preventDefault();
                alert('É necessário informar se o estagiário está apto para o estágio.');
                document.getElementById('estagiarioapto').focus();
                return false;
            }
        });
    </script>
</body>
</html>