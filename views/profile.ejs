<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Alertas -->
            <% if (success) { %>
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <%= success %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% } %>
            
            <% if (error) { %>
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <%= error %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% } %>

            <!-- Card do Perfil -->
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="fas fa-user me-2"></i>
                        Meu Perfil
                    </h4>
                </div>
                <div class="card-body">
                    <form action="/pessoas/profile" method="POST" id="profileForm">
                        <input type="hidden" name="_method" value="PUT">
                        <input type="hidden" name="returnUrl" value="<%= returnUrl %>">
                        <input type="hidden" name="tipo" value="<%= pessoa.tipo %>">
                        <input type="hidden" name="categoria" value="<%= pessoa.categoria %>">
                        
                        <div class="row">
                            <!-- Informações Básicas -->
                            <div class="col-md-6">
                                <h5 class="text-primary mb-3">
                                    <i class="fas fa-info-circle me-2"></i>
                                    Informações Básicas
                                </h5>
                                
                                <div class="mb-3">
                                    <label for="nome" class="form-label">Nome Completo *</label>
                                    <input type="text" class="form-control" id="nome" name="nome" 
                                           value="<%= pessoa.nome || '' %>" required>
                                </div>
                                
                                <div class="mb-3">
                                    <label for="email" class="form-label">E-mail *</label>
                                    <input type="email" class="form-control" id="email" name="email" 
                                           value="<%= pessoa.email || '' %>" required>
                                </div>
                                
                                <div class="mb-3">
                                    <label for="telefone" class="form-label">Telefone</label>
                                    <input type="tel" class="form-control" id="telefone" name="telefone" 
                                           value="<%= pessoa.telefone || '' %>" placeholder="(XX) XXXXX-XXXX">
                                </div>
                            </div>
                            
                            <!-- Informações do Sistema -->
                            <div class="col-md-6">
                                <h5 class="text-primary mb-3">
                                    <i class="fas fa-cog me-2"></i>
                                    Informações do Sistema
                                </h5>
                                
                                <div class="mb-3">
                                    <label for="categoria" class="form-label">Categoria</label>
                                    <input type="text" class="form-control" id="categoria" 
                                           value="<%= pessoa.categoriaTexto || '' %>" readonly>
                                </div>
                                
                                <div class="mb-3">
                                    <label for="cnpj_cpf" class="form-label">CPF/CNPJ</label>
                                    <input type="text" class="form-control" id="cnpj_cpf" name="cnpj_cpf" 
                                           value="<%= pessoa.cnpj_cpf || '' %>">
                                </div>
                                
                                <div class="mb-3">
                                    <label for="tipo" class="form-label">Tipo</label>
                                    <input type="text" class="form-control" id="tipo" 
                                           value="<%= pessoa.tipoTexto || '' %>" readonly>
                                </div>
                                
                                <div class="mb-3">
                                    <label for="dataCadastro" class="form-label">Data de Cadastro</label>
                                    <input type="text" class="form-control" id="dataCadastro" 
                                           value="<%= pessoa.dataCadastro ? new Date(pessoa.dataCadastro).toLocaleDateString('pt-BR') : '' %>" readonly>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Botões de Ação -->
                        <div class="row mt-4">
                            <div class="col-12">
                                <div class="d-flex justify-content-between">
                                    <div>
                                        <button type="submit" class="btn btn-primary me-2">
                                            <i class="fas fa-save me-2"></i>
                                            Salvar Alterações
                                        </button>
                                        <a href="<%= returnUrl %>" class="btn btn-secondary">
                                            <i class="fas fa-arrow-left me-2"></i>
                                            Voltar
                                        </a>
                                    </div>
                                    <div>
                                        <a href="/alterar-senha?returnUrl=<%= encodeURIComponent('/pessoas/profile') %>" class="btn btn-warning">
                                            <i class="fas fa-key me-2"></i>
                                            Alterar Senha
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
// Função para aplicar máscara de telefone
function aplicarMascaraTelefone(input) {
    let value = input.value.replace(/\D/g, '');
    if (value.length <= 11) {
        value = value.replace(/(\d{2})(\d{5})(\d{4})/, '($1) $2-$3');
        if (value.length < 14) {
            value = value.replace(/(\d{2})(\d{4})(\d{4})/, '($1) $2-$3');
        }
    }
    input.value = value;
}

// Máscara para telefone
document.getElementById('telefone').addEventListener('input', function(e) {
    aplicarMascaraTelefone(e.target);
});

// Aplicar máscaras ao carregar a página se já houver valores
document.addEventListener('DOMContentLoaded', function() {
    const telefoneInput = document.getElementById('telefone');
    const cnpjCpfInput = document.getElementById('cnpj_cpf');
    
    if (telefoneInput.value) {
        aplicarMascaraTelefone(telefoneInput);
    }
    
    if (cnpjCpfInput.value) {
        aplicarMascaraCpfCnpj(cnpjCpfInput);
    }
});

// Função para aplicar máscara de CPF/CNPJ
function aplicarMascaraCpfCnpj(input) {
    let value = input.value.replace(/\D/g, '');
    if (value.length <= 11) {
        // CPF
        value = value.replace(/(\d{3})(\d{3})(\d{3})(\d{2})/, '$1.$2.$3-$4');
    } else {
        // CNPJ
        value = value.replace(/(\d{2})(\d{3})(\d{3})(\d{4})(\d{2})/, '$1.$2.$3/$4-$5');
    }
    input.value = value;
}

// Máscara para CPF/CNPJ
document.getElementById('cnpj_cpf').addEventListener('input', function(e) {
    aplicarMascaraCpfCnpj(e.target);
});

// Função para limpar máscara do telefone (manter apenas dígitos)
function limparMascaraTelefone(telefone) {
    return telefone ? telefone.replace(/\D/g, '') : '';
}

// Função para limpar máscara do CPF/CNPJ (manter apenas dígitos)
function limparMascaraCpfCnpj(cpfCnpj) {
    return cpfCnpj ? cpfCnpj.replace(/\D/g, '') : '';
}

// Validação do formulário
document.getElementById('profileForm').addEventListener('submit', function(e) {
    const nome = document.getElementById('nome').value.trim();
    const email = document.getElementById('email').value.trim();
    
    if (!nome || !email) {
        e.preventDefault();
        alert('Por favor, preencha todos os campos obrigatórios.');
        return false;
    }
    
    // Validação de email
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!emailRegex.test(email)) {
        e.preventDefault();
        alert('Por favor, insira um e-mail válido.');
        return false;
    }
    
    // Limpar máscaras de formatação antes de enviar
    const telefoneInput = document.getElementById('telefone');
    const cnpjCpfInput = document.getElementById('cnpj_cpf');
    
    if (telefoneInput.value) {
        telefoneInput.value = limparMascaraTelefone(telefoneInput.value);
    }
    if (cnpjCpfInput.value) {
        cnpjCpfInput.value = limparMascaraCpfCnpj(cnpjCpfInput.value);
    }
});
</script>