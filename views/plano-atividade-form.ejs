<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Plano de Atividade - <%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        .form-section {
            background: #f8f9fa;
            border-radius: 8px;
            padding: 20px;
            margin-bottom: 20px;
        }
        .section-title {
            color: #495057;
            border-bottom: 2px solid #dee2e6;
            padding-bottom: 10px;
            margin-bottom: 20px;
        }
        .info-header {
            background: linear-gradient(135deg, #007bff, #0056b3);
            color: white;
            border-radius: 8px;
            padding: 20px;
            margin-bottom: 30px;
        }
    </style>
</head>
<body>
    <div class="container mt-4">
        <!-- Cabeçalho com informações do Campo de Estágio -->
        <div class="info-header">
            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <h5 class="mb-0 text-muted"><i class="fas fa-clipboard-list me-2"></i>Plano de Atividade</h5>
                    <div class="text-end">
                         <small class="text-muted" style="font-style: italic; font-weight: bold; color: black;">Período do estágio</small>
                         <div class="small">
                             <% if (campoEstagio && campoEstagio.ce_data_inicio) { %>
                                 <%= new Date(campoEstagio.ce_data_inicio).toLocaleDateString('pt-BR') %>
                             <% } else { %>
                                 Não informado
                             <% } %> - 
                             <% if (campoEstagio && campoEstagio.ce_data_fim && campoEstagio.ce_data_fim !== 'null' && campoEstagio.ce_data_fim.trim() !== '') { %>
                                 <% try { %>
                                     <%= new Date(campoEstagio.ce_data_fim).toLocaleDateString('pt-BR') %>
                                 <% } catch(e) { %>
                                     <%= campoEstagio.ce_data_fim %>
                                 <% } %>
                             <% } else { %>
                                 Não informado
                             <% } %>
                         </div>
                     </div>
                </div>
                <div class="text-center mb-3">
                    <p class="mb-1" style="font-size: calc(1rem + 2pt);"><strong><%= campoEstagio ? campoEstagio.nome_concedente : 'Não informado' %></strong></p>
                    <small class="text-muted" style="font-style: italic;">Campo de Estágio (concedente)</small>
                </div>
                <div class="d-flex justify-content-between text-center">
                    <div class="flex-fill">
                        <div class="small" style="font-size: calc(0.875rem + 3pt);"><strong><%= campoEstagio ? campoEstagio.nome_estagiario : 'Não informado' %></strong></div>
                        <small class="text-muted" style="font-style: italic; font-size: calc(0.75rem + 3pt);">Estagiário</small>
                    </div>
                    <div class="flex-fill">
                        <div class="small" style="font-size: calc(0.875rem + 3pt);"><strong><%= campoEstagio ? campoEstagio.nome_orientador : 'Não informado' %></strong></div>
                        <small class="text-muted" style="font-style: italic; font-size: calc(0.75rem + 3pt);">Orientador</small>
                    </div>
                    <div class="flex-fill">
                        <div class="small" style="font-size: calc(0.875rem + 3pt);"><strong><%= campoEstagio ? campoEstagio.nome_supervisor : 'Não informado' %></strong></div>
                        <small class="text-muted" style="font-style: italic; font-size: calc(0.75rem + 3pt);">Supervisor</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Formulário -->
        <form id="formPlanoAtividade" method="POST" action="<%= plano ? `/planos-atividade/${plano.pa_id_planoatividade}` : '/planos-atividade' %>">
            <% if (plano) { %>
                <input type="hidden" name="_method" value="PUT">
            <% } %>
            <input type="hidden" name="id_campo_estagio" value="<%= campoEstagio ? campoEstagio.ce_id_campo_estagio : '' %>">

            <!-- Seção: Informações Gerais -->
            <div class="form-section">
                <div class="mb-3 d-flex justify-content-between align-items-center">
                    <h5 class="section-title mb-0"><i class="fas fa-info-circle me-2"></i>Dados do Plano</h5>
                    <div>
                        <button type="button" class="btn btn-secondary me-2" onclick="voltarPaginaAnterior()">
                            <i class="fas fa-arrow-left me-2"></i>Voltar
                        </button>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-2"></i>Atualizar
                        </button>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="situacao" class="form-label">Situação *</label>
                            <select class="form-select" id="situacao" name="situacao" required>
                                <option value="Em Edição" <%= (plano && plano.pa_situacao === 'Em Edição') || !plano ? 'selected' : '' %>>Em Edição</option>
                                <option value="Em Aprovação" <%= plano && plano.pa_situacao === 'Em Aprovação' ? 'selected' : '' %>>Em Aprovação</option>
                                <option value="Aprovado sem Anexo" <%= plano && plano.pa_situacao === 'Aprovado sem Anexo' ? 'selected' : '' %>>Aprovado sem Anexo</option>
                                <option value="Aprovado com Anexo" <%= plano && plano.pa_situacao === 'Aprovado com Anexo' ? 'selected' : '' %>>Aprovado com Anexo</option>
                            </select>
                        </div>
                    </div>

                </div>
                <div class="row">
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label for="data_inicial" class="form-label">Data Inicial do plano *</label>
                            <input type="text" class="form-control" id="data_inicial" name="data_inicial" 
                                   placeholder="DD/MM/AAAA" maxlength="10"
                                   value="<%
                                   let dataInicialValue = '';
                                   if (plano && plano.pa_data_inicial) {
                                       try {
                                           dataInicialValue = new Date(plano.pa_data_inicial).toLocaleDateString('pt-BR');
                                       } catch(e) {
                                           dataInicialValue = '';
                                       }
                                   } else if (campoEstagio && campoEstagio.ce_data_inicio && campoEstagio.ce_data_inicio !== 'null' && typeof campoEstagio.ce_data_inicio === 'string' && campoEstagio.ce_data_inicio.trim() !== '') {
                                       try {
                                           dataInicialValue = new Date(campoEstagio.ce_data_inicio).toLocaleDateString('pt-BR');
                                       } catch(e) {
                                           dataInicialValue = '';
                                       }
                                   }
                                   %><%= dataInicialValue %>" required>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label for="data_final" class="form-label">Data final do plano *</label>
                            <input type="text" class="form-control" id="data_final" name="data_final" 
                                   placeholder="DD/MM/AAAA" maxlength="10"
                                   value="<%
                                   let dataFinalValue = '';
                                   if (plano && plano.pa_data_final) {
                                       try {
                                           dataFinalValue = new Date(plano.pa_data_final).toLocaleDateString('pt-BR');
                                       } catch(e) {
                                           dataFinalValue = '';
                                       }
                                   } else if (campoEstagio && campoEstagio.ce_data_fim && campoEstagio.ce_data_fim !== 'null' && typeof campoEstagio.ce_data_fim === 'string' && campoEstagio.ce_data_fim.trim() !== '') {
                                       try {
                                           dataFinalValue = new Date(campoEstagio.ce_data_fim).toLocaleDateString('pt-BR');
                                       } catch(e) {
                                           dataFinalValue = '';
                                       }
                                   }
                                   %><%= dataFinalValue %>" required>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label for="cargahoraria" class="form-label">CH Semanal *</label>
                            <input type="number" class="form-control" id="cargahoraria" name="cargahoraria" 
                                   value="<%= plano ? plano.pa_cargahoraria : '' %>" min="1" max="40" required>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Seção: Atividades -->
            <div class="form-section">
                <h5 class="section-title"><i class="fas fa-tasks me-2"></i>Atividades a Desenvolver</h5>
                <div class="mb-3">
                    <label for="atividades" class="form-label">Descrição das Atividades *</label>
                    <textarea class="form-control" id="atividades" name="atividades" rows="6" required><%= plano ? plano.pa_atividades : '' %></textarea>
                    <div class="form-text">Descreva as principais atividades, responsabilidades e tarefas que o estagiário irá executar.</div>
                </div>
            </div>

            <!-- Seção: Objetivos -->
            <div class="form-section">
                <h5 class="section-title"><i class="fas fa-bullseye me-2"></i>Objetivos</h5>
                <div class="mb-3">
                    <label for="objetivos" class="form-label">Objetivos do Estágio *</label>
                    <textarea class="form-control" id="objetivos" name="objetivos" rows="5" required><%= plano ? plano.pa_objetivos : '' %></textarea>
                    <div class="form-text">Especifique os objetivos de aprendizagem, competências técnicas e comportamentais a serem desenvolvidas.</div>
                </div>
            </div>

            <!-- Seção: Cronograma -->
            <div class="form-section">
                <h5 class="section-title"><i class="fas fa-calendar-alt me-2"></i>Cronograma</h5>
                <div class="mb-3">
                    <label for="cronograma" class="form-label">Cronograma de Atividades *</label>
                    <textarea class="form-control" id="cronograma" name="cronograma" rows="5" required><%= plano ? plano.pa_cronograma : '' %></textarea>
                    <div class="form-text">Organize as atividades por períodos (semanal, mensal) com marcos e entregas esperadas.</div>
                </div>
            </div>

            <!-- Seção: Recursos -->
            <div class="form-section">
                <h5 class="section-title"><i class="fas fa-tools me-2"></i>Recursos Necessários</h5>
                <div class="mb-3">
                    <label for="recursos" class="form-label">Recursos e Materiais</label>
                    <textarea class="form-control" id="recursos" name="recursos" rows="4"><%= plano ? plano.pa_recursos : '' %></textarea>
                    <div class="form-text">Especifique equipamentos, softwares, materiais e outros recursos necessários para o desenvolvimento das atividades.</div>
                </div>
            </div>

            <!-- Botões de Ação -->
            <div class="d-flex justify-content-between">
                <div>
                    <button type="button" class="btn btn-secondary me-2" onclick="voltarPaginaAnterior()">
                        <i class="fas fa-arrow-left me-2"></i>Voltar
                    </button>
                    <button type="button" class="btn btn-outline-primary" onclick="limparFormulario()">
                        <i class="fas fa-eraser me-2"></i>Limpar
                    </button>
                </div>
                <div>
                    <% if (plano && plano.pa_id_planoatividade) { %>
                        <button type="button" class="btn btn-danger me-2" id="btnExcluir" disabled>
                            <i class="fas fa-trash me-2"></i>Excluir
                        </button>
                    <% } %>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-2"></i>Salvar
                    </button>
                </div>
            </div>
        </form>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Datas do campo de estágio para validação
        const dataInicialCampo = new Date('<%= campoEstagio && campoEstagio.ce_data_inicio ? campoEstagio.ce_data_inicio : '' %>');
        const dataFinalCampo = new Date('<%= campoEstagio && campoEstagio.ce_data_fim ? campoEstagio.ce_data_fim : '' %>');

        // Validação de datas
        document.getElementById('data_inicial').addEventListener('change', function() {
            const dataInicial = new Date(this.value);
            const dataFinalInput = document.getElementById('data_final');
            
            // Validar se data inicial é >= data inicial do campo
            if (dataInicialCampo && dataInicial < dataInicialCampo) {
                alert('A data inicial do plano não pode ser menor que a data inicial do estágio (' + dataInicialCampo.toLocaleDateString('pt-BR') + ').');
                this.value = '';
                return;
            }
            
            if (dataFinalInput.value) {
                const dataFinal = new Date(dataFinalInput.value);
                if (dataInicial >= dataFinal) {
                    alert('A data inicial deve ser anterior à data final.');
                    this.value = '';
                }
            }
        });

        // Função para converter data brasileira (DD/MM/YYYY) para formato ISO (YYYY-MM-DD)
        function convertBRDateToISO(brDate) {
            if (!brDate || typeof brDate !== 'string') return '';
            
            // Se já está no formato ISO, retorna como está
            if (brDate.match(/^\d{4}-\d{2}-\d{2}$/)) {
                return brDate;
            }
            
            // Se está no formato brasileiro DD/MM/YYYY
            const parts = brDate.split('/');
            if (parts.length === 3) {
                const day = parts[0].padStart(2, '0');
                const month = parts[1].padStart(2, '0');
                const year = parts[2];
                return `${year}-${month}-${day}`;
            }
            
            return '';
        }

        // Função para converter Date para formato DD/MM/YYYY
        function formatarDataBR(data) {
            if (!data) return '';
            if (typeof data === 'string') {
                // Se já está no formato DD/MM/YYYY, retorna como está
                if (data.match(/^\d{2}\/\d{2}\/\d{4}$/)) {
                    return data;
                }
                // Se está no formato ISO, converte
                if (data.match(/^\d{4}-\d{2}-\d{2}/)) {
                    const dateObj = new Date(data);
                    return dateObj.toLocaleDateString('pt-BR');
                }
            }
            // Se é um objeto Date
            if (data instanceof Date) {
                return data.toLocaleDateString('pt-BR');
            }
            return '';
        }

        // Preencher campos de data se estiverem vazios e houver dados do campo de estágio
        document.addEventListener('DOMContentLoaded', function() {
            const dataInicialInput = document.getElementById('data_inicial');
            const dataFinalInput = document.getElementById('data_final');
            
            // Se os campos estão vazios, tentar preencher com dados do campo de estágio
            <% if (campoEstagio && !plano) { %>
                <% if (campoEstagio.ce_data_inicio) { %>
                    if (!dataInicialInput.value.trim()) {
                        const dataInicialFormatada = formatarDataBR(new Date('<%= campoEstagio.ce_data_inicio %>'));
                        if (dataInicialFormatada) {
                            dataInicialInput.value = dataInicialFormatada;
                        }
                    }
                <% } %>
                
                <% if (campoEstagio.ce_data_fim) { %>
                    if (!dataFinalInput.value.trim()) {
                        const dataFinalFormatada = formatarDataBR(new Date('<%= campoEstagio.ce_data_fim %>'));
                        if (dataFinalFormatada) {
                            dataFinalInput.value = dataFinalFormatada;
                        }
                    }
                <% } %>
            <% } %>
        });

        document.getElementById('data_final').addEventListener('change', function() {
            const dataFinal = new Date(this.value);
            const dataInicialInput = document.getElementById('data_inicial');
            
            // Validar se data final é <= data final do campo
            if (dataFinalCampo && dataFinal > dataFinalCampo) {
                alert('A data final do plano não pode ser maior que a data final do estágio (' + dataFinalCampo.toLocaleDateString('pt-BR') + ').');
                this.value = '';
                return;
            }
            
            if (dataInicialInput.value) {
                const dataInicial = new Date(dataInicialInput.value);
                if (dataFinal <= dataInicial) {
                    alert('A data final deve ser posterior à data inicial.');
                    this.value = '';
                }
            }
        });

        // Função para limpar formulário
        function limparFormulario() {
            if (confirm('Tem certeza que deseja limpar todos os campos do formulário?')) {
                document.getElementById('formPlanoAtividade').reset();
            }
        }

        function voltarPaginaAnterior() {
            // Tentar voltar para a página anterior
            if (window.history.length > 1) {
                window.history.back();
            } else {
                // Se não há histórico, ir para o dashboard
                window.location.href = '/estagios/dashboard';
            }
            
            // Se a página foi aberta em uma nova aba, tentar fechá-la após um pequeno delay
            setTimeout(() => {
                if (window.opener) {
                    window.close();
                }
            }, 100);
        }

        // Função para aplicar máscara de data DD/MM/YYYY
        function aplicarMascaraData(input) {
            input.addEventListener('input', function(e) {
                let valor = e.target.value.replace(/\D/g, '');
                if (valor.length >= 2) {
                    valor = valor.substring(0,2) + '/' + valor.substring(2);
                }
                if (valor.length >= 5) {
                    valor = valor.substring(0,5) + '/' + valor.substring(5,9);
                }
                e.target.value = valor;
            });
        }

        // Função para converter data DD/MM/YYYY para Date
        function converterDataBR(dataStr) {
            if (!dataStr || dataStr.length !== 10) return null;
            const partes = dataStr.split('/');
            if (partes.length !== 3) return null;
            return new Date(partes[2], partes[1] - 1, partes[0]);
        }

        // Aplicar máscaras aos campos de data
        aplicarMascaraData(document.getElementById('data_inicial'));
        aplicarMascaraData(document.getElementById('data_final'));

        // Validação do formulário antes do envio
        document.getElementById('formPlanoAtividade').addEventListener('submit', function(e) {
            const dataInicial = converterDataBR(document.getElementById('data_inicial').value);
            const dataFinal = converterDataBR(document.getElementById('data_final').value);
            
            // Validar se as datas são válidas
            if (!dataInicial || !dataFinal) {
                e.preventDefault();
                alert('Por favor, insira datas válidas no formato DD/MM/AAAA.');
                return false;
            }
            
            // Validar datas em relação ao campo de estágio
            if (dataInicialCampo && dataInicial < dataInicialCampo) {
                e.preventDefault();
                alert('A data inicial do plano não pode ser menor que a data inicial do estágio.');
                return false;
            }
            
            if (dataFinalCampo && dataFinal > dataFinalCampo) {
                e.preventDefault();
                alert('A data final do plano não pode ser maior que a data final do estágio.');
                return false;
            }
            
            if (dataInicial >= dataFinal) {
                e.preventDefault();
                alert('A data inicial deve ser anterior à data final.');
                return false;
            }

            // Validar se o campo de estágio foi informado (apenas para criação)
            <% if (!plano) { %>
            const campoEstagioId = document.querySelector('input[name="id_campo_estagio"]').value;
            if (!campoEstagioId) {
                e.preventDefault();
                alert('É necessário selecionar um Campo de Estágio antes de criar o Plano de Atividade.');
                return false;
            }
            <% } %>

            return true;
        });

        // Verificar permissão de exclusão
        <% if (plano && plano.pa_id_planoatividade) { %>
        function verificarPermissaoExclusao() {
            const btnExcluir = document.getElementById('btnExcluir');
            if (!btnExcluir) {
                console.log('Botão Excluir não encontrado');
                return;
            }

            const plano = {
                pa_situacao: '<%= plano.pa_situacao %>'
            };
            const userNivelAcesso = '<%= user.nivelacesso %>';

            // Verificar se o plano pode ser excluído baseado na situação
            let podeExcluir = false;
            let motivoDesabilitado = '';

            if (userNivelAcesso === 'Administrador') {
                // Administradores podem excluir: 'Em Edição', 'Em Aprovação', 'Aprovado sem Anexo'
                podeExcluir = plano.pa_situacao === 'Em Edição' || 
                             plano.pa_situacao === 'Em Aprovação' || 
                             plano.pa_situacao === 'Aprovado sem Anexo';
                if (!podeExcluir) {
                    motivoDesabilitado = 'Planos aprovados com anexo não podem ser excluídos';
                }
            } else {
                // Outros usuários podem excluir apenas: 'Em Edição' e 'Em Aprovação'
                podeExcluir = plano.pa_situacao === 'Em Edição' || 
                             plano.pa_situacao === 'Em Aprovação';
                if (!podeExcluir) {
                    motivoDesabilitado = 'Você não tem permissão para excluir planos aprovados';
                }
            }

            // Aplicar permissão ao botão
            btnExcluir.disabled = !podeExcluir;
            if (podeExcluir) {
                btnExcluir.title = 'Excluir plano de atividade';
                btnExcluir.onclick = confirmarExclusao;
            } else {
                btnExcluir.title = motivoDesabilitado;
                btnExcluir.onclick = null;
            }
        }

        function confirmarExclusao() {
            if (confirm('Tem certeza que deseja excluir este plano de atividade? Esta ação não pode ser desfeita.')) {
                excluirPlano();
            }
        }

        async function excluirPlano() {
            try {
                const response = await fetch('/planos-atividade/<%= plano.pa_id_planoatividade %>', {
                    method: 'DELETE',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                });

                const result = await response.json();

                if (result.success) {
                    alert('Plano de atividade excluído com sucesso!');
                    voltarPaginaAnterior();
                } else {
                    alert('Erro ao excluir plano de atividade: ' + result.message);
                }
            } catch (error) {
                console.error('Erro ao excluir plano:', error);
                alert('Erro ao excluir plano de atividade. Tente novamente.');
            }
        }

        // Executar verificação de permissão quando a página carregar
        document.addEventListener('DOMContentLoaded', function() {
            verificarPermissaoExclusao();
        });
        <% } %>

        function limparFormulario() {
            if (confirm('Tem certeza que deseja limpar todos os campos do formulário?')) {
                document.getElementById('formPlanoAtividade').reset();
            }
        }
    </script>
</body>
</html>