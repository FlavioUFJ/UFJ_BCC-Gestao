        },
        
        // Controlar estado dos botões do card Plano de Atividade
        controlarBotoesPlanoAtividade(plano) {
            // Botão Novo - desabilitado se já existir um plano de atividade
            const btnNovoPlano = document.getElementById('btnPlanAtiNovo');
            if (btnNovoPlano) {
                const jaExistePlano = planosAtividade && planosAtividade.length > 0;
                btnNovoPlano.disabled = jaExistePlano;
                
                if (jaExistePlano) {
                    btnNovoPlano.title = 'Já existe um Plano de Atividade para este Campo de Estágio';
                    btnNovoPlano.classList.remove('btn-success');
                    btnNovoPlano.classList.add('btn-secondary');
                } else {
                    btnNovoPlano.title = 'Criar novo plano de atividade';
                    btnNovoPlano.classList.remove('btn-secondary');
                    btnNovoPlano.classList.add('btn-success');
