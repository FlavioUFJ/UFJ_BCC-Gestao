        function validarMudancaSituacao(novaSituacao, selectElement) {
            const situacaoAnterior = selectElement.getAttribute('data-situacao-anterior') || 'Em Edição';
            
            // Verificar se está mudando de "Em Edição" para "Concluído"
            if (situacaoAnterior === 'Em Edição' && novaSituacao === 'Concluído') {
                // 1º) Verificar se existe número SEI
                const numeroSEI = document.getElementById('numero_processosei').value;
                if (!numeroSEI || numeroSEI.trim() === '') {
                    mostrarAlerta('Não é possível mudar a situação do campo de estágio para "Concluído" sem que tenha número SEI informado no formulário.', 'error');
                    selectElement.value = situacaoAnterior;
                    document.getElementById('numero_processosei').focus();
                    return;
                }
                
                // 2º) Confirmar com o usuário
                if (confirm('Tem certeza que deseja concluir o cadastro do campo de estágio? Esta ação irá salvar o formulário e enviar notificações por e-mail para os envolvidos.')) {
                    // 3º) Executar ações de conclusão
                    concluirCampoEstagio();
                } else {
                    // Reverter para "Em Edição"
                    selectElement.value = 'Em Edição';
                }
            }
            
            // Atualizar situação anterior para próximas mudanças
            selectElement.setAttribute('data-situacao-anterior', novaSituacao);
        }
        
        function concluirCampoEstagio() {
            // Mostrar tela de carregamento
            mostrarTelaCarregamento('Salvando formulário e enviando notificações...');
            
            // Salvar formulário com status concluído
            const formData = new FormData(document.getElementById('formCampoEstagio'));
            const data = Object.fromEntries(formData.entries());
            
            // Garantir que a situação seja "Concluído"
            data.situacao = 'Concluído';
            
            // Incluir campos desabilitados
            const camposDesabilitados = [
                'apolice_seguro', 'nome_seguradora', 'valor_bolsa', 'valor_valetransporte',
                'id_pessoa_curso_nome', 'id_pessoa_estagiario_nome', 'id_pessoa_orientador_nome',
                'id_pessoa_concedente_nome', 'id_pessoa_supervisor_nome', 'confirmaaptoestagio',
                'estagiopropriainstituicao', 'numero_convenio'
            ];
            
            camposDesabilitados.forEach(campoId => {
                const elemento = document.getElementById(campoId);
                if (elemento && (elemento.disabled || elemento.readOnly)) {
                    data[campoId] = elemento.value || '';
                }
            });
            
            <% if (typeof isEdicao !== 'undefined' && isEdicao) { %>
            const url = '/secure/estagios/campo/editar/<%= campoEstagio.id_campo_estagio %>';
            <% } else { %>
            const url = '/secure/estagios/campo/criar';
            <% } %>
            
            fetch(url, {
                method: 'POST',
                credentials: 'include',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(data)
            })
            .then(response => response.json())
            .then(result => {
                if (result.success) {
                    // Enviar e-mails de notificação
                    <% if (typeof campoEstagio !== 'undefined' && campoEstagio) { %>
                    enviarEmailsNotificacao(result.campoEstagioId || <%= campoEstagio.id_campo_estagio %>);
                    <% } else { %>
                    enviarEmailsNotificacao(result.campoEstagioId || null);
                    <% } %>
                } else {
                    ocultarTelaCarregamento();
                    mostrarAlerta(result.message || 'Erro ao salvar campo de estágio', 'error');
                    // Reverter situação
                    document.getElementById('situacao').value = 'Em Edição';
                }
            })
            .catch(error => {
                console.error('Erro ao salvar campo de estágio:', error);
                ocultarTelaCarregamento();
                mostrarAlerta('Erro ao salvar campo de estágio', 'error');
                // Reverter situação
                document.getElementById('situacao').value = 'Em Edição';
            });
        }
        
        function enviarEmailsNotificacao(campoEstagioId) {
            fetch(`/secure/estagios/campo/enviar-notificacao/${campoEstagioId}`, {
                method: 'POST',
                credentials: 'include',
                headers: {
                    'Content-Type': 'application/json'
                }
            })
            .then(response => response.json())
            .then(result => {
                ocultarTelaCarregamento();
                if (result.success) {
                    mostrarTelaNotificacao('E-mails de notificação enviados com sucesso para todos os envolvidos no campo de estágio!');
                } else {
                    mostrarAlerta('Campo de estágio salvo, mas houve erro ao enviar e-mails: ' + (result.message || 'Erro desconhecido'), 'warning');
                    setTimeout(() => {
                        voltarPaginaAnterior();
                    }, 3000);
                }
            })
            .catch(error => {
                console.error('Erro ao enviar e-mails:', error);
                ocultarTelaCarregamento();
                mostrarAlerta('Campo de estágio salvo, mas houve erro ao enviar e-mails de notificação', 'warning');
                setTimeout(() => {
                    voltarPaginaAnterior();
                }, 3000);
            });
        }
        
        function mostrarTelaCarregamento(mensagem) {
            const loadingHtml = `
                <div id="loadingOverlay" style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.8); z-index: 9999; display: flex; align-items: center; justify-content: center;">
                    <div style="background: white; padding: 30px; border-radius: 10px; text-align: center; max-width: 400px;">
                        <div class="spinner-border text-primary mb-3" role="status">
                            <span class="visually-hidden">Carregando...</span>
                        </div>
                        <p style="margin: 0; font-size: 16px; color: #333;">${mensagem}</p>
                    </div>
                </div>
            `;
            document.body.insertAdjacentHTML('beforeend', loadingHtml);
        }
        
        function ocultarTelaCarregamento() {
            const overlay = document.getElementById('loadingOverlay');
            if (overlay) {
                overlay.remove();
            }
        }
        
        function mostrarTelaNotificacao(mensagem) {
            const notificationHtml = `
                <div id="notificationOverlay" style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.8); z-index: 9999; display: flex; align-items: center; justify-content: center;">
                    <div style="background: white; padding: 40px; border-radius: 10px; text-align: center; max-width: 500px;">
                        <div style="color: #28a745; font-size: 48px; margin-bottom: 20px;">
                            <i class="fas fa-check-circle"></i>
                        </div>
                        <h4 style="color: #333; margin-bottom: 20px;">Sucesso!</h4>
                        <p style="margin-bottom: 30px; font-size: 16px; color: #666;">${mensagem}</p>
                        <button type="button" class="btn btn-primary" onclick="fecharTelaNotificacao()">OK</button>
                    </div>
                </div>
            `;
            document.body.insertAdjacentHTML('beforeend', notificationHtml);
        }
        
        function fecharTelaNotificacao() {
            const overlay = document.getElementById('notificationOverlay');
            if (overlay) {
                overlay.remove();
            }
            // Usar a função voltarPaginaAnterior para respeitar o referrer
            voltarPaginaAnterior();
        }

        function validarDatas() {
            const dataInicio = document.getElementById('data_inicio').value;
            const dataFim = document.getElementById('data_fim').value;
            
            // Validação: data_inicio não pode ser maior que data_fim
            if (dataInicio && dataFim) {
                const inicio = new Date(dataInicio);
                const fim = new Date(dataFim);
                
                if (inicio > fim) {
                    mostrarAlerta('A data de início não pode ser maior que a data de fim.', 'error');
                    document.getElementById('data_inicio').value = '';
                    document.getElementById('data_inicio').focus();
                    return false;
                }
                
                if (fim < inicio) {
                    mostrarAlerta('A data de fim não pode ser menor que a data de início.', 'error');
                    document.getElementById('data_fim').value = '';
                    document.getElementById('data_fim').focus();
                    return false;
                }
            }
            

            
            return true;
        }

        function parseDataBrasileira(dataStr) {
            if (!dataStr || dataStr.length !== 10) return null;
            const parts = dataStr.split('/');
            if (parts.length !== 3) return null;
            return new Date(parts[2], parts[1] - 1, parts[0]);
        }

        function salvarCampoEstagio() {
            if (!validarFormulario()) return;
            
            const formData = new FormData(document.getElementById('formCampoEstagio'));
            const data = Object.fromEntries(formData.entries());
            
            // Garantir que campos desabilitados ou readonly sejam incluídos
            const camposDesabilitados = [
                'situacao',
                'apolice_seguro', 
                'nome_seguradora',
                'valor_bolsa',
                'valor_valetransporte',
                'id_pessoa_curso_nome',
                'id_pessoa_estagiario_nome', 
                'id_pessoa_orientador_nome',
                'id_pessoa_concedente_nome',
                'id_pessoa_supervisor_nome',
                'confirmaaptoestagio',
                'numero_convenio'
            ];
            
            camposDesabilitados.forEach(campoId => {
                const elemento = document.getElementById(campoId);
                if (elemento && (elemento.disabled || elemento.readOnly)) {
                    data[campoId] = elemento.value || '';
                }
            });
            
            // Tratar checkbox do campo estagiopropriainstituicao
            const checkboxEstagioPropria = document.getElementById('estagiopropriainstituicao');
            data.estagiopropriainstituicao = checkboxEstagioPropria.checked ? 'Sim' : 'Não';
            
            console.log('Dados coletados do formulário:', data);
            console.log('Campo situacao:', data.situacao);
            
            // Debug: Log dos dados coletados do formulário
            // console.log('[DEBUG FRONTEND] Dados coletados:', data);
            // console.log('[DEBUG FRONTEND] Campo situacao:', document.getElementById('situacao').value);
            // console.log('[DEBUG FRONTEND] Campo situacao disabled:', document.getElementById('situacao').disabled);
            // console.log('[DEBUG FRONTEND] Campo tipo_estagio:', data.tipo_estagio);
            // console.log('[DEBUG FRONTEND] Campo tipo_estagio element value:', document.getElementById('tipo_estagio').value);
            // console.log('[DEBUG FRONTEND] Campo tipo_estagio element selectedIndex:', document.getElementById('tipo_estagio').selectedIndex);
            // console.log('[DEBUG FRONTEND] Campo tipo_estagio element options:', Array.from(document.getElementById('tipo_estagio').options).map(o => ({value: o.value, text: o.text, selected: o.selected})));
            
            // Converter valores monetários
            if (data.valor_bolsa) {
                data.valor_bolsa = data.valor_bolsa.replace(/\./g, '').replace(',', '.');
            }
            if (data.valor_valetransporte) {
                data.valor_valetransporte = data.valor_valetransporte.replace(/\./g, '').replace(',', '.');
            }
            
            <% if (isEdicao && campoEstagio) { %>
            // Modo de edição - usar PUT para atualizar
            const campoId = <%= campoEstagio.id_campo_estagio %>;
            fetch(`/secure/estagios/campo/atualizar/${campoId}`, {
                method: 'PUT',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(data),
                credentials: 'include'
            })
            .then(response => response.json())
            .then(result => {
                if (result.success) {
                    mostrarAlerta('Campo de estágio atualizado com sucesso!', 'success');
                    setTimeout(() => {
                        voltarPaginaAnterior();
                    }, 1500);
                } else {
                    mostrarAlerta('Erro ao atualizar campo de estágio: ' + result.message, 'error');
                }
            })
            .catch(error => {
                console.error('Erro:', error);
                mostrarAlerta('Erro ao atualizar campo de estágio.', 'error');
            });
            <% } else { %>
            // Modo de criação - usar POST para criar
            fetch('/secure/estagios/campo/criar', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(data),
                credentials: 'include'
            })
            .then(response => response.json())
            .then(result => {
                if (result.success) {
                    mostrarAlerta('Campo de estágio salvo com sucesso!', 'success');
                    setTimeout(() => {
                        voltarPaginaAnterior();
                    }, 1500);
                } else {
                    mostrarAlerta('Erro ao cadastrar campo de estágio: ' + result.message, 'error');
                }
            })
            .catch(error => {
                console.error('Erro:', error);
                mostrarAlerta('Erro ao salvar campo de estágio.', 'error');
            });
            <% } %>
        }

        function validarFormulario() {
            // Validar campos obrigatórios
            const camposObrigatorios = [
                { id: 'situacao', nome: 'Situação' },
                { id: 'tipo_estagio', nome: 'Tipo de Estágio' },
                { id: 'semestre_ano', nome: 'Semestre/Ano' },
                { id: 'cargahoraria', nome: 'CH Semanal' },
                { id: 'id_pessoa_curso', nome: 'Instituição/Curso' },
                { id: 'numero_matricula', nome: 'Nº Matrícula' }
            ];
            
            for (let campo of camposObrigatorios) {
                const elemento = document.getElementById(campo.id);
                if (!elemento.value || elemento.value.trim() === '') {
                    mostrarAlerta(`O campo ${campo.nome} é obrigatório.`, 'error');
                    elemento.focus();
                    return false;
                }
            }
            
            // Validar carga horária semanal
            const cargaHoraria = document.getElementById('cargahoraria').value;
            if (cargaHoraria && parseInt(cargaHoraria) > 30) {
                mostrarAlerta('A carga horária semanal não pode ser maior que 30 horas.', 'error');
                document.getElementById('cargahoraria').focus();
                return false;
            }
            
            return validarDatas();
        }

        function mostrarAlerta(mensagem, tipo) {
            // Criar alerta Bootstrap
            const alertClass = tipo === 'success' ? 'alert-success' : 
                              tipo === 'error' ? 'alert-danger' : 'alert-warning';
            
            const alertHtml = `
                <div class="alert ${alertClass} alert-dismissible fade show" role="alert">
                    ${mensagem}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            `;
            
            // Inserir no topo do formulário
            const cardBody = document.querySelector('.card-body');
            cardBody.insertAdjacentHTML('afterbegin', alertHtml);
            
            // Auto-remover após 5 segundos
            setTimeout(() => {
                const alert = cardBody.querySelector('.alert');
                if (alert) {
                    alert.remove();
                }
            }, 5000);
        }

        function voltarPaginaAnterior() {
            // Verificar se há parâmetro referrer passado pelo servidor
            const referrer = '<%= typeof referrer !== "undefined" && referrer ? referrer : "" %>';
            
            if (referrer === 'dashboard-administrativo') {
                // Voltar para o dashboard administrativo
                window.location.href = '/secure/estagios/dashboard-administrativo';
            } else if (window.history.length > 1) {
                // Tentar voltar para a página anterior
                window.history.back();
            } else {
                // Se não há histórico, ir para o dashboard padrão
                window.location.href = '/estagios/dashboard';
            }
            
            // Se a página foi aberta em uma nova aba, tentar fechá-la após um pequeno delay
            setTimeout(() => {
                if (window.opener) {
                    window.close();
                }
            }, 100);
        }
    </script>
</body>
</html>