            async carregarModulos() {
                try {
                    const response = await fetch('/admin/modulos');
                    const data = await response.json();
                    
                    if (data.error || data.redirect) {
                        console.error('Erro de autenticação:', data.error);
                        AdminRotinas.mostrarMensagem('Erro de autenticação. Faça login novamente.', 'error');
                        if (data.redirect) {
                            window.location.href = data.redirect;
                        }
                        return;
                    }
                    
                    this.modulos = Array.isArray(data) ? data : [];
                    this.renderizarTabelaModulos();
                    
                } catch (error) {
                    console.error('Erro ao carregar módulos:', error);
                    AdminRotinas.mostrarMensagem('Erro ao carregar módulos', 'error');
                }
