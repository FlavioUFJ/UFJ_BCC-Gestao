    <script>
        // ===== FUNCIONALIDADE DE MÓDULOS E USUÁRIOS =====
        const GerenciadorParametros = {
            parametros: [],
            
            init() {
                this.bindEvents();
                // Só carregar parâmetros se a aba estiver ativa
                if (document.getElementById('corpoTabelaParametros')) {
                    this.carregarParametros();
                }
            },
            
            bindEvents() {
                // Listener para quando a aba Parâmetros for ativada
                document.addEventListener('click', (e) => {
                    if (e.target.matches('button[data-bs-target="#parametros"]') || e.target.closest('button[data-bs-target="#parametros"]')) {
                        // Aguardar um pouco para o DOM da aba ser renderizado
                        setTimeout(() => {
                            if (document.getElementById('corpoTabelaParametros') && (!this.parametros || this.parametros.length === 0)) {
                                this.carregarParametros();
                            }
                        }, 100);
                    }
                });
            },
            
            async carregarParametros() {
                try {
                    const response = await fetch('/secure/parametros/buscar');
                    const data = await response.json();
                    
                    if (!response.ok || !data.success) {
                        console.error('Erro ao carregar parâmetros:', data.message);
                        AdminRotinas.mostrarMensagem(data.message || 'Erro ao carregar parâmetros', 'error');
                        return;
                    }
                    
                    this.parametros = Array.isArray(data.parametros) ? data.parametros : [];
                    this.renderizarTabelaParametros();
                    
                } catch (error) {
                    console.error('Erro ao carregar parâmetros:', error);
                    AdminRotinas.mostrarMensagem('Erro ao carregar parâmetros', 'error');
                }
            },
            
            renderizarTabelaParametros() {
                const tbody = document.getElementById('corpoTabelaParametros');
                if (!tbody) return;
                
                if (!this.parametros || this.parametros.length === 0) {
                    tbody.innerHTML = `
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                <i class="fas fa-sliders-h fa-2x mb-2"></i><br>
                                Nenhum parâmetro encontrado
                            </td>
                        </tr>
                    `;
                    return;
                }
                
                tbody.innerHTML = this.parametros.map(parametro => `
                    <tr>
                        <td>${parametro.identificador}</td>
                        <td>${parametro.descricao || '-'}</td>
                        <td><span class="badge bg-info">${parametro.tipo || 'Texto'}</span></td>
                        <td><small>${parametro.valor || '-'}</small></td>
                        <td>
                            <span class="badge bg-${parametro.ativo ? 'success' : 'secondary'}">
                                ${parametro.ativo ? 'Ativo' : 'Inativo'}
                            </span>
