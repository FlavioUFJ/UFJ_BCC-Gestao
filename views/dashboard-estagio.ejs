        abrirModal() {
            try {
                // Prevenir múltiplas aberturas
                if (this.modalAberto) {
                    console.log('Modal já está aberto');
                    return;
                }

                const modal = document.getElementById('modalCadastroEstagio');
                const form = document.getElementById('formCadastroEstagio');
                
                if (!modal || !form) {
                    console.error('Modal ou formulário não encontrado');
                    return;
