            }
            
            // Botão Editar - lógica diferenciada por nível de usuário
            const btnEditarPlano = document.getElementById('btnPlanAtiEditar');
            if (btnEditarPlano) {
                const userNivelAcesso = '<%= user.nivelacesso %>';
                let podeEditar = false;
                let motivoDesabilitado = '';
                
                if (!plano) {
                    podeEditar = false;
                    motivoDesabilitado = 'Nenhum plano de atividade selecionado';
                } else if (plano.pa_situacao === 'Aprovado com Anexo') {
                    // Ninguém pode editar planos "Aprovado com Anexo", nem mesmo administradores
                    podeEditar = false;
                    motivoDesabilitado = 'Planos aprovados com anexo não podem ser editados';
                } else if (userNivelAcesso === 'Administrador') {
                    // Administradores podem editar outras situações
                    podeEditar = true;
                } else {
                    // Outros usuários não podem editar "Aprovado sem Anexo" e "Aprovado com Anexo"
                    podeEditar = plano.pa_situacao !== 'Aprovado sem Anexo' && plano.pa_situacao !== 'Aprovado com Anexo';
                    if (!podeEditar) {
                        motivoDesabilitado = 'Planos aprovados não podem ser editados';
                    }
                }
                
                btnEditarPlano.disabled = !podeEditar;
                
                // Debug: Verificar estado do botão
                console.log('Estado do botão Editar:', {
                    disabled: btnEditarPlano.disabled,
                    podeEditar: podeEditar,
                    classes: btnEditarPlano.className,
                    title: btnEditarPlano.title
                });
                
                if (!podeEditar) {
                    btnEditarPlano.title = motivoDesabilitado;
                    btnEditarPlano.classList.remove('btn-outline-primary');
                    btnEditarPlano.classList.add('btn-outline-secondary');
                } else {
                    btnEditarPlano.title = 'Editar plano de atividade selecionado';
                    btnEditarPlano.classList.remove('btn-outline-secondary');
                    btnEditarPlano.classList.add('btn-outline-primary');
                }
                
                console.log('Estado final do botão:', {
                    disabled: btnEditarPlano.disabled,
                    classes: btnEditarPlano.className,
                    title: btnEditarPlano.title
                });
            }
            
            // Botão Gerar PDF - desabilitado se não existir plano ou se situação for "Aprovado com Anexo"
            const btnGerarPDFPlano = document.getElementById('btnPlanAtiGerarPDF');
            if (btnGerarPDFPlano) {
                const podeGerarPDF = plano !== null && plano.pa_situacao !== 'Aprovado com Anexo';
                btnGerarPDFPlano.disabled = !podeGerarPDF;
                
                if (!plano) {
                    btnGerarPDFPlano.title = 'Nenhum plano de atividade selecionado';
                    btnGerarPDFPlano.classList.remove('btn-outline-info');
                    btnGerarPDFPlano.classList.add('btn-outline-secondary');
                } else if (plano.pa_situacao === 'Aprovado com Anexo') {
                    btnGerarPDFPlano.title = 'Plano aprovado com anexo - use o link "Baixar plano Assinado"';
                    btnGerarPDFPlano.classList.remove('btn-outline-info');
                    btnGerarPDFPlano.classList.add('btn-outline-secondary');
                } else {
                    btnGerarPDFPlano.title = 'Gerar PDF do plano de atividade';
                    btnGerarPDFPlano.classList.remove('btn-outline-secondary');
                    btnGerarPDFPlano.classList.add('btn-outline-info');
                }
            }
            
            // Botão Aprovar - desabilitado se plano já estiver aprovado ou não existir plano
            const btnAprovarPlano = document.getElementById('btnPlanAtiAprovar');
            if (btnAprovarPlano) {
                const podeAprovar = plano && plano.pa_situacao !== 'Aprovado';
                btnAprovarPlano.disabled = !podeAprovar;
                
                if (!podeAprovar) {
                    if (!plano) {
                        btnAprovarPlano.title = 'Nenhum plano de atividade selecionado';
                    } else {
                        btnAprovarPlano.title = 'Este plano já está aprovado';
                    }
                    btnAprovarPlano.classList.remove('btn-outline-warning');
                    btnAprovarPlano.classList.add('btn-outline-secondary');
                } else {
                    btnAprovarPlano.title = 'Aprovar plano de atividade';
                    btnAprovarPlano.classList.remove('btn-outline-secondary');
                    btnAprovarPlano.classList.add('btn-outline-warning');
                }
            }
        },
        
