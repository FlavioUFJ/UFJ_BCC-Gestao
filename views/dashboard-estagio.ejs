    // Adicionar funções utilitárias ao AdminDashboard
    AdminDashboard.aplicarMascaraData = function(elementId) {
        const element = document.getElementById(elementId);
        if (element && !element.hasAttribute('data-mask-applied')) {
            element.addEventListener('input', function(e) {
                let value = e.target.value.replace(/\D/g, '');
                if (value.length >= 2) {
                    value = value.substring(0, 2) + '/' + value.substring(2);
                }
                if (value.length >= 5) {
                    value = value.substring(0, 5) + '/' + value.substring(5, 9);
                }
                e.target.value = value;
            });
            element.setAttribute('data-mask-applied', 'true');
        }
    };

    AdminDashboard.validarDataBrasileira = function(data) {
        if (!data) return true; // Campo opcional
        const regex = /^(\d{2})\/(\d{2})\/(\d{4})$/;
        const match = data.match(regex);
        if (!match) return false;
        
        const dia = parseInt(match[1], 10);
        const mes = parseInt(match[2], 10);
        const ano = parseInt(match[3], 10);
        
        if (mes < 1 || mes > 12) return false;
        if (dia < 1 || dia > 31) return false;
        if (ano < 1900 || ano > 2100) return false;
        
        const dataObj = new Date(ano, mes - 1, dia);
        return dataObj.getFullYear() === ano && 
               dataObj.getMonth() === mes - 1 && 
               dataObj.getDate() === dia;
    };

    AdminDashboard.toggleCamposNaoObrigatorio = function() {
        const tipoEstagio = document.getElementById('modal_tipo_estagio');
        const camposNaoObrigatorio = document.getElementById('camposNaoObrigatorio');
        
        if (tipoEstagio && camposNaoObrigatorio) {
            if (tipoEstagio.value === 'Não obrigatório') {
                camposNaoObrigatorio.style.display = 'block';
            } else {
                camposNaoObrigatorio.style.display = 'none';
                // Limpar valores dos campos ocultos
                const valorBolsa = document.getElementById('modal_valor_bolsa');
                const auxilioTransporte = document.getElementById('modal_auxilio_transporte');
                if (valorBolsa) valorBolsa.value = '';
                if (auxilioTransporte) auxilioTransporte.value = '';
            }
        }
    };

    AdminDashboard.salvarCampoEstagio = function() {
        const form = document.getElementById('formCadastroEstagio');
        if (!form) {
            this.mostrarAlerta('Formulário não encontrado', 'error');
            return;
        }
        
        const formData = new FormData(form);
        
        // Validar campos obrigatórios
        const camposObrigatorios = ['numero_matricula', 'nome', 'email', 'curso', 'situacao'];
        for (let campo of camposObrigatorios) {
            const valor = formData.get(campo);
            if (!valor || valor.trim() === '') {
                this.mostrarAlerta(`O campo ${campo.replace('_', ' ')} é obrigatório.`, 'error');
                const element = document.getElementById('modal_' + campo);
                if (element) element.focus();
                return;
            }
        }
        
        // Validar datas
        const dataInicio = formData.get('data_inicio');
        const dataTermino = formData.get('data_termino');
        
        if (dataInicio && !this.validarDataBrasileira(dataInicio)) {
            this.mostrarAlerta('Data de início inválida. Use o formato dd/mm/aaaa.', 'error');
            const element = document.getElementById('modal_data_inicio');
            if (element) element.focus();
            return;
        }
        
        if (dataTermino && !this.validarDataBrasileira(dataTermino)) {
            this.mostrarAlerta('Data de término inválida. Use o formato dd/mm/aaaa.', 'error');
            const element = document.getElementById('modal_data_termino');
            if (element) element.focus();
            return;
        }
        
        // Converter FormData para objeto
        const data = {};
        for (let [key, value] of formData.entries()) {
            data[key] = value;
        }
        
        // Enviar dados para o servidor
        fetch('/secure/estagio/campo/criar', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(data)
        })
        .then(response => response.json())
        .then(result => {
            if (result.success) {
                this.mostrarAlerta('Campo de estágio cadastrado com sucesso!', 'success');
                // Fechar modal
                const modalElement = document.getElementById('modalCadastroEstagioAdmin');
                if (modalElement) {
                    const modal = bootstrap.Modal.getInstance(modalElement);
                    if (modal) modal.hide();
                }
                // Recarregar página para mostrar o novo registro
                setTimeout(() => location.reload(), 1500);
            } else {
                this.mostrarAlerta('Erro ao cadastrar campo de estágio: ' + result.message, 'error');
            }
        })
        .catch(error => {
            console.error('Erro:', error);
            this.mostrarAlerta('Erro ao cadastrar campo de estágio. Tente novamente.', 'error');
        });
    };
    
