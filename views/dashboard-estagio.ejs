                const situacao = form.querySelector('[name="situacao"]');
                if (situacao) situacao.value = 'Em edição';
                
                // Mostrar modal usando CSS
                modal.style.display = 'block';
                document.body.style.overflow = 'hidden'; // Prevenir scroll do body
                
                // Focar no primeiro campo editável após um pequeno delay
                setTimeout(() => {
                    const primeiroInput = form.querySelector('input:not([readonly])');
                    if (primeiroInput) {
                        primeiroInput.focus();
                    }
                }, 150);
                
            } catch (error) {
                console.error('Erro ao abrir modal:', error);
                this.modalAberto = false; // Reset em caso de erro
                mostrarAlerta('Erro ao abrir o formulário. Tente recarregar a página.', 'error');
            }
        },

        fecharModal() {
            try {
                const modal = document.getElementById('modalCadastroEstagio');
                if (modal) {
                    modal.style.display = 'none';
                    document.body.style.overflow = ''; // Restaurar scroll do body
                }
                
                // Resetar controle de abertura
                this.modalAberto = false;
                
            } catch (error) {
                console.error('Erro ao fechar modal:', error);
                this.modalAberto = false; // Reset mesmo em caso de erro
            }
        }
    };
    
