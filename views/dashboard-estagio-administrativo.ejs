    // Função para normalizar texto removendo acentos
    normalizarTexto(texto) {
        if (!texto) return '';
        return texto.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
    },
    
    filtrarCamposEstagio() {
        const busca = document.getElementById('buscaPessoa').value.toLowerCase();
        const buscaNormalizada = this.normalizarTexto(busca);
        const tipoPessoa = document.getElementById('filtroTipoPessoa').value;
        const filtroEmEdicao = document.getElementById('filtroEmEdicao').checked;
        const filtroConcluido = document.getElementById('filtroConcluido').checked;
        const filtroFinalizado = document.getElementById('filtroFinalizado').checked;
        
        const linhas = document.querySelectorAll('#tabelaCamposEstagio tbody tr');
        let registrosVisiveis = 0;
        
        linhas.forEach(linha => {
            if (linha.children.length === 1) return; // Pular linha de "nenhum resultado"
            
            const estagiario = linha.children[0].textContent.toLowerCase();
            const orientador = linha.children[1].textContent.toLowerCase();
            const supervisor = linha.children[2].textContent.toLowerCase();
            const concedente = linha.children[3].textContent.toLowerCase();
            const situacao = linha.dataset.situacao;
            
            let mostrar = true;
            
            // Filtro por busca e tipo de pessoa
            if (busca) {
                let textoParaBusca = '';
                let textoParaBuscaNormalizado = '';
                
                switch (tipoPessoa) {
                    case 'estagiario':
                        textoParaBusca = estagiario;
                        textoParaBuscaNormalizado = this.normalizarTexto(linha.children[0].textContent);
                        break;
                    case 'orientador':
                        textoParaBusca = orientador;
                        textoParaBuscaNormalizado = this.normalizarTexto(linha.children[1].textContent);
                        break;
                    case 'supervisor':
                        textoParaBusca = supervisor;
                        textoParaBuscaNormalizado = this.normalizarTexto(linha.children[2].textContent);
                        break;
                    case 'concedente':
                        textoParaBusca = concedente;
                        textoParaBuscaNormalizado = this.normalizarTexto(linha.children[3].textContent);
                        break;
                    case 'tudo':
                    default:
                        textoParaBusca = `${estagiario} ${orientador} ${supervisor} ${concedente}`;
                        textoParaBuscaNormalizado = `${this.normalizarTexto(linha.children[0].textContent)} ${this.normalizarTexto(linha.children[1].textContent)} ${this.normalizarTexto(linha.children[2].textContent)} ${this.normalizarTexto(linha.children[3].textContent)}`;
                        break;
                }
                
                // Busca normal ou normalizada
                mostrar = textoParaBusca.includes(busca) || textoParaBuscaNormalizado.includes(buscaNormalizada);
            }
            
            // Filtro por situação
            if (mostrar) {
                const situacaoValida = 
                    (filtroEmEdicao && situacao === 'Em Edição') ||
                    (filtroConcluido && situacao === 'Concluído') ||
                    (filtroFinalizado && situacao === 'Finalizado');
                
                mostrar = situacaoValida;
            }
            
            linha.style.display = mostrar ? '' : 'none';
            if (mostrar) registrosVisiveis++;
        });
        
        // Atualizar contador
        document.getElementById('contadorRegistros').textContent = registrosVisiveis;
    },
    
    editarCampo(campoId) {
        window.location.href = `/secure/estagios/campo/editar/${campoId}?referrer=dashboard-administrativo`;
