            renderizarTabelaModulos() {
                const tbody = document.getElementById('corpoTabelaModulos');
                if (!tbody) return;
                
                if (!this.modulos || this.modulos.length === 0) {
                    tbody.innerHTML = `
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
