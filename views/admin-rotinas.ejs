                            <button class="btn btn-sm btn-outline-success" onclick="GerenciadorModulos.vincularPessoas(${modulo.id_modulo})" title="Vincular Pessoas">
                                <i class="fas fa-users"></i>
                            </button>
                        </td>
                    </tr>
                `).join('');
            },
            
            filtrarModulos() {
                const busca = document.getElementById('buscaModulo')?.value.toLowerCase() || '';
                const buscaNormalizada = this.normalizarTexto(busca);
                const status = document.getElementById('filtroStatusModulo')?.value || '';
                
                if (!this.modulos) return;
                
                let modulosFiltrados = this.modulos;
                
                if (busca) {
                    modulosFiltrados = modulosFiltrados.filter(modulo => {
                        const nomeNormal = modulo.nome.toLowerCase();
                        const nomeNormalizado = this.normalizarTexto(modulo.nome);
                        const descricaoNormal = modulo.descricao ? modulo.descricao.toLowerCase() : '';
                        const descricaoNormalizada = this.normalizarTexto(modulo.descricao || '');
                        
                        return nomeNormal.includes(busca) || nomeNormalizado.includes(buscaNormalizada) ||
                               descricaoNormal.includes(busca) || descricaoNormalizada.includes(buscaNormalizada);
                    });
                }
                
                if (status !== '') {
                    modulosFiltrados = modulosFiltrados.filter(modulo => 
                        modulo.ativo === (status === '1')
                    );
                }
                
                const tbody = document.getElementById('corpoTabelaModulos');
                if (!tbody) return;
                
                if (modulosFiltrados.length === 0) {
                    tbody.innerHTML = `
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                <i class="fas fa-search fa-2x mb-2"></i><br>
                                Nenhum módulo encontrado com os filtros aplicados
                            </td>
                        </tr>
                    `;
                    return;
                }
                
                tbody.innerHTML = modulosFiltrados.map(modulo => `
                    <tr>
                        <td>${modulo.nome}</td>
                        <td>${modulo.descricao || '-'}</td>
                        <td><small>${modulo.url || '-'}</small></td>
