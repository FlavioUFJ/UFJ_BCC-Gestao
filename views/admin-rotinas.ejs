            async carregarPessoasVinculadas(idModulo) {
                try {
                    const response = await fetch(`/admin/modulos/${idModulo}/pessoas`);
                    const pessoas = await response.json();
                    
                    const tbody = document.getElementById('corpoPessoasVinculadas');
                    
                    if (!response.ok) {
                        tbody.innerHTML = `
                            <tr>
                                <td colspan="3" class="text-center text-danger">
                                    Erro ao carregar pessoas vinculadas
                                </td>
                            </tr>
                        `;
                        return;
                    }
                    
                    if (pessoas.length === 0) {
                        tbody.innerHTML = `
                            <tr>
                                <td colspan="3" class="text-center text-muted py-3">
                                    <i class="fas fa-users fa-2x mb-2"></i><br>
                                    Nenhuma pessoa vinculada a este módulo
                                </td>
                            </tr>
                        `;
                        return;
