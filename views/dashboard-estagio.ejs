                            ${userNivelAcesso === 'Administrador' ? `<p class="mb-1 text-muted"><small><a href="#" onclick="removerPlanoAssinado(${plano.pa_id_planoatividade})" class="text-decoration-none text-danger"><i class="fas fa-trash me-1"></i>Remover Plano Assinado</a></small></p>` : ''}
                        ` : `
