    // Função para anexar documento PDF ao plano de atividade
    function anexarDocumentoPDF(planoId) {
        if (!planoId) {
            alert('ID do plano de atividade não encontrado.');
            return;
        }
        
        // Criar input file para seleção do PDF
        const input = document.createElement('input');
        input.type = 'file';
        input.accept = '.pdf';
        input.style.display = 'none';
        
        input.onchange = async function(event) {
            const file = event.target.files[0];
            if (!file) return;
            
            if (file.type !== 'application/pdf') {
                alert('Por favor, selecione apenas arquivos PDF.');
                return;
            }
            
            // Criar FormData para upload
            const formData = new FormData();
            formData.append('documento_pdf', file);
            formData.append('plano_id', planoId);
            
            try {
                const uploadResponse = await fetch('/planos-atividade/anexar-documento', {
                    method: 'POST',
                    body: formData
                });
                
                const result = await uploadResponse.json();
                
                if (result.success) {
                    alert('Documento PDF anexado com sucesso!');
                    // Recarregar os dados do plano
                    AdminDashboard.carregarPlanosAtividade(null, true);
                } else {
                    alert('Erro ao anexar documento: ' + (result.message || 'Erro desconhecido'));
                }
            } catch (error) {
                console.error('Erro ao anexar documento:', error);
                alert('Erro ao anexar documento. Tente novamente.');
            }
        };
        
        // Adicionar input ao DOM e simular clique
        document.body.appendChild(input);
        input.click();
        document.body.removeChild(input);
    }
    
    // Função para remover plano assinado (apenas administradores)
    async function removerPlanoAssinado(planoId) {
        if (!confirm('Tem certeza que deseja remover o plano assinado? Esta ação não pode ser desfeita.')) {
            return;
        }
        
        try {
            const response = await fetch(`/planos-atividade/${planoId}/remover-assinado`, {
                method: 'DELETE',
                headers: {
                    'Content-Type': 'application/json'
                }
            });
            
            const result = await response.json();
            
            if (result.success) {
                alert('Plano assinado removido com sucesso!');
                // Recarregar os dados do plano
                AdminDashboard.carregarPlanosAtividade(null, true);
            } else {
                alert('Erro ao remover plano assinado: ' + (result.message || 'Erro desconhecido'));
            }
        } catch (error) {
            console.error('Erro ao remover plano assinado:', error);
            alert('Erro ao remover plano assinado. Tente novamente.');
        }
    }
    

    
