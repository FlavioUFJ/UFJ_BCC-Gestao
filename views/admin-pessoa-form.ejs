<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - CoordenAI - Gestão Inteligente</title>
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" crossorigin="anonymous" referrerpolicy="no-referrer">
    
    <!-- CSS Externo -->
    <link href="/css/admin-pessoa-form.css" rel="stylesheet">
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container-fluid">
            <a class="navbar-brand" href="/dashboard">
                <i class="fas fa-graduation-cap me-2"></i>CoordenAI - Gestão Inteligente
            </a>
            
            <div class="navbar-nav ms-auto">
                <a class="nav-link" href="<%= origem %>">
                    <i class="fas fa-arrow-left me-2"></i>Voltar
                </a>
                <a class="nav-link" href="/logout">
                    <i class="fas fa-sign-out-alt me-2"></i>Sair
                </a>
            </div>
        </div>
    </nav>

    <div class="container-fluid">
        <div class="form-container">
            <div class="form-header">
                <h2>
                    <i class="fas fa-<%= isEdit ? 'edit' : 'plus' %> me-2"></i>
                    <%= title %>
                </h2>
            </div>
            
            <!-- Alertas -->
            <div id="alertContainer" aria-live="polite" aria-atomic="true"></div>
            
            <form id="pessoaForm">
                <input type="hidden" id="pessoaId" value="<%= pessoa ? pessoa.id_pessoa : '' %>">
                
                <div class="row">
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label for="tipo" class="form-label">Tipo <span class="required" aria-label="campo obrigatório">*</span></label>
                            <select class="form-select" id="tipo" name="tipo" required aria-describedby="tipo-help">
                                <option value="">Selecione...</option>
                                <option value="F" <%= pessoa && pessoa.tipo === 'F' ? 'selected' : '' %>>Pessoa Física</option>
                                <option value="J" <%= pessoa && pessoa.tipo === 'J' ? 'selected' : '' %>>Pessoa Jurídica</option>
                                <option value="N" <%= pessoa && pessoa.tipo === 'N' ? 'selected' : '' %>>Não Informada</option>
                            </select>
                            <div id="tipo-help" class="form-text visually-hidden">Selecione se é pessoa física ou jurídica</div>
                        </div>
                    </div>
                    
                    <div class="col-md-8">
                        <div class="mb-3">
                            <label for="nome" class="form-label">Nome <span class="required" aria-label="campo obrigatório">*</span></label>
                            <input type="text" class="form-control" id="nome" name="nome" 
                                   value="<%= pessoa ? pessoa.nome.replace(/"/g, '&quot;') : '' %>" required aria-describedby="nome-help">
                            <div id="nome-help" class="form-text visually-hidden">Digite o nome completo da pessoa</div>
                        </div>
                    </div>
                    
                    <div class="col-12">
                        <div class="mb-3">
                            <fieldset>
                                <legend class="form-label" id="categorias-legend">Categorias <span class="required" aria-label="campo obrigatório">*</span></legend>
                                <div class="border rounded p-2" role="group" aria-labelledby="categorias-legend" aria-describedby="categorias-help">
                                    <div class="row">
                                        <div class="col-md-4">
                                            <% 
                                                 const categorias = pessoa && pessoa.categoria ? pessoa.categoria : [];
                                                 const categoriasConfig = [
                                                     { id: 'catCoordenador', value: 'Coordenador', label: 'Coordenador', desc: 'Pessoa responsável pela coordenação' },
                                                     { id: 'catProfessor', value: 'Professor', label: 'Professor/Orientador', desc: 'Pessoa que atua como professor ou orientador' }
                                                 ];
                                             %>
                                             <% categoriasConfig.forEach(cat => { %>
                                             <div class="form-check">
                                                 <input class="form-check-input categoria-checkbox" type="checkbox" value="<%= cat.value %>" id="<%= cat.id %>"
                                                        <%= categorias.includes(cat.value) ? 'checked' : '' %> aria-describedby="<%= cat.id %>-desc">
                                                 <label class="form-check-label" for="<%= cat.id %>"><%= cat.label %></label>
                                                 <div id="<%= cat.id %>-desc" class="visually-hidden"><%= cat.desc %></div>
                                             </div>
                                             <% }); %>
                                        </div>
                                        <div class="col-md-4">
                                            <% 
                                                 const categoriasCol2 = [
                                                     { id: 'catAluno', value: 'Aluno', label: 'Aluno/Estagiário', desc: 'Pessoa que atua como aluno ou estagiário' },
                                                     { id: 'catConcedente', value: 'Concedente', label: 'Concedente', desc: 'Pessoa ou empresa que concede estágio' }
                                                 ];
                                             %>
                                             <% categoriasCol2.forEach(cat => { %>
                                             <div class="form-check">
                                                 <input class="form-check-input categoria-checkbox" type="checkbox" value="<%= cat.value %>" id="<%= cat.id %>"
                                                        <%= categorias.includes(cat.value) ? 'checked' : '' %> aria-describedby="<%= cat.id %>-desc">
                                                 <label class="form-check-label" for="<%= cat.id %>"><%= cat.label %></label>
                                                 <div id="<%= cat.id %>-desc" class="visually-hidden"><%= cat.desc %></div>
                                             </div>
                                             <% }); %>
                                        </div>
                                        <div class="col-md-4">
                                            <% 
                                                 const categoriasCol3 = [
                                                     { id: 'catSupervisor', value: 'Supervisor', label: 'Supervisor', desc: 'Pessoa que supervisiona estágios' },
                                                     { id: 'catInstituicao', value: 'Instituição', label: 'Instituição/Curso', desc: 'Representa uma instituição ou curso' },
                                                     { id: 'catUsuarioGeral', value: 'Usuário Geral', label: 'Usuário Geral', desc: 'Usuário com acesso geral ao sistema' }
                                                 ];
                                             %>
                                             <% categoriasCol3.forEach(cat => { %>
                                             <div class="form-check">
                                                 <input class="form-check-input categoria-checkbox" type="checkbox" value="<%= cat.value %>" id="<%= cat.id %>"
                                                        <%= categorias.includes(cat.value) ? 'checked' : '' %> aria-describedby="<%= cat.id %>-desc">
                                                 <label class="form-check-label" for="<%= cat.id %>"><%= cat.label %></label>
                                                 <div id="<%= cat.id %>-desc" class="visually-hidden"><%= cat.desc %></div>
                                             </div>
                                             <% }); %>
                                        </div>
                                    </div>
                                    <div id="categorias-help" class="form-text mt-2">Selecione pelo menos uma categoria. Algumas categorias são incompatíveis entre si.</div>
                                </div>
                            </fieldset>
                            <input type="hidden" id="categoria" name="categoria" aria-label="Categorias selecionadas">
                        </div>
                    </div>
                </div>
                
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="email" class="form-label">E-mail <span class="required" aria-label="campo obrigatório">*</span></label>
                            <input type="email" class="form-control" id="email" name="email" 
                                   value="<%= pessoa ? pessoa.email.replace(/"/g, '&quot;') : '' %>" required aria-describedby="email-help">
                            <div id="email-help" class="form-text visually-hidden">Digite um endereço de email válido</div>
                        </div>
                    </div>
                    
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="cnpj_cpf" class="form-label">CPF/CNPJ</label>
                            <input type="text" class="form-control" id="cnpj_cpf" name="cnpj_cpf" 
                                   value="<%= pessoa ? pessoa.cnpj_cpf : '' %>" aria-describedby="cnpj_cpf-help">
                            <div id="cnpj_cpf-help" class="form-text visually-hidden">Digite o CPF ou CNPJ da pessoa (opcional)</div>
                        </div>
                    </div>
                </div>
                
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="telefone" class="form-label">Telefone</label>
                            <input type="tel" class="form-control" id="telefone" name="telefone" 
                                   value="<%= pessoa ? pessoa.telefone : '' %>" aria-describedby="telefone-help">
                            <div id="telefone-help" class="form-text visually-hidden">Digite o número de telefone (opcional)</div>
                        </div>
                    </div>
                </div>
                
                <!-- Seção de Dados de Login -->
                <div class="card mt-4">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="fas fa-key me-2"></i>Dados de Login</h5>
                    </div>
                    <div class="card-body">
                        <fieldset>
                            <legend class="visually-hidden" id="login-legend">Configurações de acesso ao sistema</legend>
                            <div class="row">
                                <div class="col-md-6">
                                    <label for="nivelAcesso" class="form-label">Nível de Acesso <span class="required" aria-label="campo obrigatório">*</span></label>
                                    <select class="form-select" id="nivelAcesso" name="nivelAcesso" required aria-describedby="nivelAcesso-help">
                                        <option value="">Selecione o nível de acesso</option>
                                        <option value="Administrador">Administrador</option>
                                        <option value="Operador">Operador</option>
                                        <option value="Visitante">Visitante</option>
                                    </select>
                                    <div id="nivelAcesso-help" class="form-text">Define o nível de permissões no sistema</div>
                                </div>
                                <div class="col-md-6">
                                    <label for="statusLogin" class="form-label">Status <span class="required" aria-label="campo obrigatório">*</span></label>
                                    <select class="form-select" id="statusLogin" name="statusLogin" required aria-describedby="statusLogin-help">
                                        <option value="Ativo" selected>Ativo</option>
                                        <option value="Inativo">Inativo</option>
                                        <option value="Bloqueado">Bloqueado</option>
                                    </select>
                                    <div id="statusLogin-help" class="form-text">Define se o usuário pode acessar o sistema</div>
                                </div>
                            </div>
                        </fieldset>
                    </div>
                </div>

                <!-- Seção de Módulos -->
                <div class="card mt-4">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="fas fa-cubes me-2"></i>Módulos do Sistema</h5>
                    </div>
                    <div class="card-body">
                        <fieldset>
                            <legend class="visually-hidden" id="modulos-legend">Gerenciamento de módulos do sistema</legend>
                            <div class="row mb-3">
                                <div class="col-md-8">
                                    <label for="moduloSelect" class="form-label">Selecionar Módulo:</label>
                                    <select id="moduloSelect" class="form-select" aria-describedby="moduloSelect-help">
                                        <option value="">Carregando módulos...</option>
                                    </select>
                                    <div id="moduloSelect-help" class="form-text">Escolha um módulo para adicionar às permissões do usuário</div>
                                </div>
                                <div class="col-md-4 d-flex align-items-end">
                                    <button type="button" id="btnAdicionarModulo" class="btn btn-success" aria-describedby="btnAdicionarModulo-help">
                                        <i class="fas fa-plus me-1" aria-hidden="true"></i>Adicionar
                                    </button>
                                    <div id="btnAdicionarModulo-help" class="visually-hidden">Adiciona o módulo selecionado à lista de permissões</div>
                                </div>
                            </div>
                            
                            <div class="row">
                                <div class="col-12">
                                    <label class="form-label" for="tabelaModulos">Módulos Selecionados:</label>
                                    <div class="table-responsive">
                                        <table id="tabelaModulos" class="table table-striped table-hover" role="table" aria-label="Lista de módulos selecionados">
                                            <thead class="table-dark">
                                                <tr>
                                                    <th width="60" scope="col">Ícone</th>
                                                    <th scope="col">Nome</th>
                                                    <th scope="col">Descrição</th>
                                                    <th width="100" scope="col">Ações</th>
                                                </tr>
                                            </thead>
                                            <tbody id="tabelaModulosBody">
                                                <tr id="semModulos">
                                                    <td colspan="4" class="text-center text-muted py-3">
                                                        <i class="fas fa-info-circle me-2" aria-hidden="true"></i>Nenhum módulo selecionado
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </fieldset>
                    </div>
                </div>
                
                <div class="btn-group-actions d-flex justify-content-between">
                    <div>
                        <button type="button" class="btn btn-secondary" id="btnVoltar">
                            <i class="fas fa-arrow-left me-1"></i>
                            Voltar
                        </button>
                    </div>
                    
                    <div>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-1"></i>
                            <%= isEdit ? 'Atualizar' : 'Salvar' %>
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
    
    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Dados para o JavaScript -->
    <script>
        // Configurações globais seguras
        window.isEditMode = <%= typeof isEdit !== 'undefined' && isEdit ? 'true' : 'false' %>;
        window.origemUrl = '<%= typeof origem !== 'undefined' ? origem : '/admin/pessoas' %>';
        
        <% if (typeof pessoa !== 'undefined' && pessoa) { %>
        // Dados da pessoa de forma segura
        window.pessoaData = {
            id_pessoa: '<%= pessoa.id_pessoa || '' %>',
            tipo: '<%= pessoa.tipo || '' %>',
            nome: '<%= (pessoa.nome || '').replace(/'/g, "\\'") %>',
            email: '<%= (pessoa.email || '').replace(/'/g, "\\'") %>',
            cnpj_cpf: '<%= pessoa.cnpj_cpf || '' %>',
            categoria: '<%= pessoa.categoria || '' %>',
            telefone: '<%= pessoa.telefone || '' %>',
            nivelAcesso: '<%= pessoa.nivelAcesso || '' %>',
            statusLogin: '<%= pessoa.statusLogin || '' %>',
            modulos: <%= JSON.stringify(pessoa.modulos || []) %>
        };
        console.log('Dados da pessoa carregados:', window.pessoaData);
        <% } else { %>
        window.pessoaData = null;
        <% } %>
    </script>
    
    <!-- JavaScript externo -->
    <script src="/js/admin-pessoa-form.js"></script>
</body>
</html>