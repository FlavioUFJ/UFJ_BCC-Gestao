            async buscarPessoasVinculo(termo) {
                if (!termo || termo.length < 2) {
                    const resultadosBusca = document.getElementById('resultadosBuscaPessoaVinculo');
                    if (resultadosBusca) resultadosBusca.innerHTML = '';
                    return;
                }
                
                try {
                    const response = await fetch(`/admin/pessoas?busca=${encodeURIComponent(termo)}`);
                    const pessoas = await response.json();
                    
                    const resultados = document.getElementById('resultadosBuscaPessoaVinculo');
                    
                    if (!resultados) return;
                    
                    if (!response.ok || pessoas.length === 0) {
                        resultados.innerHTML = `
                            <div class="list-group-item text-muted text-center">
                                Nenhuma pessoa encontrada
                            </div>
                        `;
                        return;
                    }
                    
                    resultados.innerHTML = pessoas.slice(0, 10).map(pessoa => `
                        <div class="list-group-item list-group-item-action" onclick="GerenciadorModulos.vincularPessoa(${pessoa.id_pessoa}, '${pessoa.nome}')" style="cursor: pointer;">
