<div class="container mt-4">
    <!-- Header Administrativo -->
    <div class="row mb-3">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h3 class="mb-1" style="color: #333; font-weight: 600;"><i class="fas fa-graduation-cap me-2"></i>Módulo Estágio</h3>
                    <p class="mb-0" style="color: #666;">Painel Principal</p>
                </div>
                <div>
                    <!-- Link do WhatsApp -->
                    <a href="#" id="whatsappLink" class="btn btn-success btn-sm" style="display: none;" target="_blank">
                        <i class="fab fa-whatsapp me-2"></i>Entre no Grupo do WhatsApp
                    </a>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Mensagens de Feedback -->
    <% if (typeof success !== 'undefined' && success) { %>
    <div class="row mb-4">
        <div class="col-12">
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fas fa-check-circle me-2"></i>
                <strong>Sucesso!</strong> <%= success %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        </div>
    </div>
    <% } %>
    
    <% if (typeof error !== 'undefined' && error) { %>
    <div class="row mb-4">
        <div class="col-12">
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fas fa-exclamation-triangle me-2"></i>
                <strong>Erro!</strong> <%= error %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        </div>
    </div>
    <% } %>



    <!-- Cards das Rotinas do Módulo Estágio -->
    <div class="row mb-4">
        <!-- Card Campo de Estágio -->
        <div class="col-lg-4 col-md-6 mb-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-building fa-2x me-3"></i>
                            <div>
                                <h5 class="mb-0">Campo de Estágio</h5>
                                <small class="opacity-75">Gestão de campos de estágio</small>
                            </div>
                        </div>
                        <div class="text-end">
                            <% if (camposEstagio && camposEstagio.length > 1) { %>
                                <small class="opacity-75" id="contadorHeader">1 de <%= camposEstagio.length %></small>
                            <% } else if (camposEstagio && camposEstagio.length === 0) { %>
                                <small class="opacity-75">0 registros</small>
                            <% } %>
                        </div>
                    </div>
                </div>
                <div class="card-body" id="cardCampoEstagio">
                    <% if (camposEstagio && camposEstagio.length > 0) { %>
                        <div class="mb-3" id="campoEstagioContent">
                            <!-- Primeira linha: Concedente em negrito -->
                            <p class="mb-2"><strong id="concedenteAtual"><%= camposEstagio[0].nome_concedente || 'N/A' %></strong></p>
                            
                            <div class="row mb-2">
                                <div class="col-4">
                                    <strong>Início:</strong> <span id="inicioAtual"><%= camposEstagio[0].data_inicio ? new Date(camposEstagio[0].data_inicio).toLocaleDateString('pt-BR') : 'N/A' %></span>
                                </div>
                                <div class="col-4">
                                    <strong>Fim:</strong> <span id="fimAtual"><%= camposEstagio[0].data_fim ? new Date(camposEstagio[0].data_fim).toLocaleDateString('pt-BR') : 'N/A' %></span>
                                </div>
                                <div class="col-4 text-end">
                                    <span style="color: #ffc107; font-weight: bold;" id="situacaoAtual">
                                        <%= camposEstagio[0].situacao || 'N/A' %>
                                    </span>
                                </div>
                            </div>
                            <p class="mb-1"><strong>Estagiário:</strong> <span id="estagiarioAtual"><%= camposEstagio[0].nome_estagiario || 'N/A' %></span></p>
                            <p class="mb-1"><strong>Orientador:</strong> <span id="orientadorAtual"><%= camposEstagio[0].nome_orientador || 'N/A' %></span></p>
                            <p class="mb-0"><strong>Supervisor:</strong> <span id="supervisorAtual"><%= camposEstagio[0].nome_supervisor || 'N/A' %></span></p>
                        </div>
                        

                    <% } else { %>
                        <div class="text-center py-3">
                            <i class="fas fa-inbox fa-3x text-muted mb-2"></i>
                            <p class="text-muted mb-0">Nenhum campo de estágio cadastrado</p>
                        </div>
                    <% } %>
                </div>
                <div class="card-footer bg-transparent">
                    <div class="d-flex justify-content-between mb-3">
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-success btn-sm" id="btnCampEstNovo" onclick="window.location.href='/secure/estagios/campo/novo?origem=' + encodeURIComponent(window.location.pathname)">
                                <i class="fas fa-plus me-1"></i>Novo
                            </button>
                            <button type="button" class="btn btn-outline-primary btn-sm" id="btnCampEstEditar" onclick="campEstGerenciar()">
                                <i class="fas fa-edit me-1"></i>Editar
                            </button>
                        </div>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-outline-info btn-sm" id="btnCampEstGerarPDF" onclick="campEstGerarPDF()">
                                <i class="fas fa-file-pdf me-1"></i>Gerar PDF
                            </button>
                            <button type="button" class="btn btn-outline-warning btn-sm" id="btnCampEstAnexarPlano" onclick="campEstAnexarPlano()">
                                <i class="fas fa-paperclip me-1"></i>Anexar Plano Assinado
                            </button>
                        </div>
                    </div>
                    
                    <% if (camposEstagio && camposEstagio.length > 1) { %>
                        <!-- Barra de navegação -->
                        <div class="d-flex align-items-center justify-content-between p-2 bg-light rounded">
                            <button type="button" class="btn btn-sm btn-outline-secondary" id="btnCampEstAnterior" onclick="campEstNavegar(-1)">
                                <i class="fas fa-chevron-left"></i>
                            </button>
                            
                            <div class="flex-grow-1 mx-2">
                                <input type="text" class="form-control form-control-sm" id="campEstBusca" placeholder="Buscar por estagiário, orientador..." onkeyup="campEstFiltrar()">
                            </div>
                            
                            <button type="button" class="btn btn-sm btn-outline-secondary" id="btnCampEstProximo" onclick="campEstNavegar(1)">
                                <i class="fas fa-chevron-right"></i>
                            </button>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- Card Plano de Atividade -->
        <div class="col-lg-4 col-md-6 mb-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-header bg-success text-white">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-tasks fa-2x me-3"></i>
                            <div>
                                <h5 class="mb-0">Plano de Atividade</h5>
                                <small class="opacity-75">Planos de atividades dos estágios</small>
                            </div>
                        </div>
                        <div class="text-end">
                            <small class="opacity-75">Em desenvolvimento</small>
                        </div>
                    </div>
                </div>
                <div class="card-body" id="cardPlanoAtividade">
                    <div class="mb-3">
                        <!-- Primeira linha: Título do plano em negrito -->
                        <p class="mb-2"><strong>Plano de Atividades - Semestre 2024/1</strong></p>
                        
                        <div class="row mb-2">
                            <div class="col-4">
                                <strong>Criado:</strong> <span>--/--/----</span>
                            </div>
                            <div class="col-4">
                                <strong>Aprovado:</strong> <span>--/--/----</span>
                            </div>
                            <div class="col-4 text-end">
                                <span style="color: #6c757d; font-weight: bold;">
                                    Pendente
                                </span>
                            </div>
                        </div>
                        <p class="mb-1"><strong>Estagiário:</strong> <span>Aguardando implementação</span></p>
                        <p class="mb-1"><strong>Orientador:</strong> <span>Aguardando implementação</span></p>
                        <p class="mb-0"><strong>Supervisor:</strong> <span>Aguardando implementação</span></p>
                    </div>
                </div>
                <div class="card-footer bg-transparent">
                    <div class="d-flex justify-content-between mb-3">
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-success btn-sm" id="btnPlanAtiNovo" onclick="planAtiNovo()" title="Criar novo plano de atividade">
                                <i class="fas fa-plus me-1"></i>Novo
                            </button>
                            <button type="button" class="btn btn-outline-primary btn-sm" id="btnPlanAtiEditar" onclick="planAtiEditar()" title="Editar plano de atividade selecionado">
                                <i class="fas fa-edit me-1"></i>Editar
                            </button>
                        </div>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-outline-info btn-sm" id="btnPlanAtiGerarPDF" onclick="planAtiGerarPDF()" title="Gerar PDF do plano de atividade">
                                <i class="fas fa-file-pdf me-1"></i>Gerar PDF
                            </button>
                            <button type="button" class="btn btn-outline-warning btn-sm" id="btnPlanAtiAprovar" onclick="planAtiAprovar()" title="Aprovar plano de atividade">
                                <i class="fas fa-check me-1"></i>Aprovar
                            </button>
                        </div>
                    </div>
                    
                    <!-- Barra de navegação -->
                    <div class="d-flex align-items-center justify-content-between p-2 bg-light rounded">
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="btnPlanAtiAnterior" onclick="planAtiNavegar('anterior')" title="Plano anterior">
                            <i class="fas fa-chevron-left"></i>
                        </button>
                        
                        <div class="flex-grow-1 mx-2">
                            <input type="text" class="form-control form-control-sm" id="planAtiBusca" placeholder="Buscar planos..." onkeyup="planAtiFiltrar()">
                        </div>
                        
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="btnPlanAtiProximo" onclick="planAtiNavegar('proximo')" title="Próximo plano">
                            <i class="fas fa-chevron-right"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card Frequência -->
        <div class="col-lg-4 col-md-6 mb-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-header bg-warning text-white">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-calendar-check fa-2x me-3"></i>
                            <div>
                                <h5 class="mb-0">Frequência</h5>
                                <small class="opacity-75">Controle de frequência dos estágios</small>
                            </div>
                        </div>
                        <div class="text-end">
                            <small class="opacity-75">Em desenvolvimento</small>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <!-- Primeira linha: Período em negrito -->
                        <p class="mb-2"><strong>Frequência - Março 2024</strong></p>
                        
                        <div class="row mb-2">
                            <div class="col-4">
                                <strong>Dias:</strong> <span>--/--</span>
                            </div>
                            <div class="col-4">
                                <strong>Horas:</strong> <span>-- h</span>
                            </div>
                            <div class="col-4 text-end">
                                <span style="color: #6c757d; font-weight: bold;">
                                    Pendente
                                </span>
                            </div>
                        </div>
                        <p class="mb-1"><strong>Estagiário:</strong> <span>Aguardando implementação</span></p>
                        <p class="mb-1"><strong>Orientador:</strong> <span>Aguardando implementação</span></p>
                        <p class="mb-0"><strong>Supervisor:</strong> <span>Aguardando implementação</span></p>
                    </div>
                </div>
                <div class="card-footer bg-transparent">
                    <div class="d-flex justify-content-between mb-3">
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-warning btn-sm" id="btnFreqAtiNovo" disabled title="Funcionalidade em desenvolvimento">
                                <i class="fas fa-plus me-1"></i>Novo
                            </button>
                            <button type="button" class="btn btn-outline-primary btn-sm" id="btnFreqAtiEditar" disabled title="Funcionalidade em desenvolvimento">
                                <i class="fas fa-edit me-1"></i>Editar
                            </button>
                        </div>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-outline-info btn-sm" id="btnFreqAtiGerarPDF" disabled title="Funcionalidade em desenvolvimento">
                                <i class="fas fa-file-pdf me-1"></i>Gerar PDF
                            </button>
                            <button type="button" class="btn btn-outline-success btn-sm" id="btnFreqAtiValidar" disabled title="Funcionalidade em desenvolvimento">
                                <i class="fas fa-check-circle me-1"></i>Validar
                            </button>
                        </div>
                    </div>
                    
                    <!-- Barra de navegação desabilitada -->
                    <div class="d-flex align-items-center justify-content-between p-2 bg-light rounded opacity-50">
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="btnFreqAtiAnterior" disabled>
                            <i class="fas fa-chevron-left"></i>
                        </button>
                        
                        <div class="flex-grow-1 mx-2">
                            <input type="text" class="form-control form-control-sm" id="freqAtiBusca" placeholder="Buscar frequências..." disabled>
                        </div>
                        
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="btnFreqAtiProximo" disabled>
                            <i class="fas fa-chevron-right"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card Relatórios -->
        <div class="col-lg-4 col-md-6 mb-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-header bg-info text-white">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-file-alt fa-2x me-3"></i>
                            <div>
                                <h5 class="mb-0">Relatórios</h5>
                                <small class="opacity-75">Relatórios dos estágios</small>
                            </div>
                        </div>
                        <div class="text-end">
                            <small class="opacity-75">Em desenvolvimento</small>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <!-- Primeira linha: Tipo do relatório em negrito -->
                        <p class="mb-2"><strong>Relatório Final - 2024/1</strong></p>
                        
                        <div class="row mb-2">
                            <div class="col-4">
                                <strong>Entrega:</strong> <span>--/--/----</span>
                            </div>
                            <div class="col-4">
                                <strong>Avaliado:</strong> <span>--/--/----</span>
                            </div>
                            <div class="col-4 text-end">
                                <span style="color: #6c757d; font-weight: bold;">
                                    Pendente
                                </span>
                            </div>
                        </div>
                        <p class="mb-1"><strong>Estagiário:</strong> <span>Aguardando implementação</span></p>
                        <p class="mb-1"><strong>Orientador:</strong> <span>Aguardando implementação</span></p>
                        <p class="mb-0"><strong>Supervisor:</strong> <span>Aguardando implementação</span></p>
                    </div>
                </div>
                <div class="card-footer bg-transparent">
                    <div class="d-flex justify-content-between mb-3">
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-info btn-sm" id="btnRelAtiNovo" disabled title="Funcionalidade em desenvolvimento">
                                <i class="fas fa-plus me-1"></i>Novo
                            </button>
                            <button type="button" class="btn btn-outline-primary btn-sm" id="btnRelAtiEditar" disabled title="Funcionalidade em desenvolvimento">
                                <i class="fas fa-edit me-1"></i>Editar
                            </button>
                        </div>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-outline-info btn-sm" id="btnRelAtiGerarPDF" disabled title="Funcionalidade em desenvolvimento">
                                <i class="fas fa-file-pdf me-1"></i>Gerar PDF
                            </button>
                            <button type="button" class="btn btn-outline-success btn-sm" id="btnRelAtiAvaliar" disabled title="Funcionalidade em desenvolvimento">
