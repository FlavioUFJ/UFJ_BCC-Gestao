                }
                
                try {
                    const response = await fetch(`/api/pessoas/buscar?termo=${encodeURIComponent(termo)}&limite=10`);
                    const data = await response.json();
                    
                    if (data.success && data.pessoas.length > 0) {
                        this.renderSearchResults(data.pessoas, 'resultadosBuscaPessoa', 'selectPessoaLogin');
                    } else {
                        document.getElementById('resultadosBuscaPessoa').style.display = 'none';
