    <script>
        // ===== FUNCIONALIDADE DE MÓDULOS E USUÁRIOS =====
        const GerenciadorModulos = {
            init() {
                this.bindEvents();
                this.carregarUsuarios();
                this.carregarModulos();
                this.limparFormularioCriarLogin();
            },
            
            bindEvents() {
                // Formulário de criar login
                document.getElementById('criarLoginForm')?.addEventListener('submit', (e) => {
                    e.preventDefault();
                    this.criarLogin();
                });
                
