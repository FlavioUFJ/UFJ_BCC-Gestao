            },
            
            // ===== FUNCIONALIDADES DE DESVINCULAÇÃO =====
            
            async carregarVinculosParaDesvinculo(idPessoa) {
                if (!idPessoa) {
                    document.getElementById('vinculosAtuaisDesvinculo').style.display = 'none';
                    return;
                }
                
                try {
                    const response = await fetch(`/admin/usuario-modulos/${idPessoa}`);
                    const vinculos = await response.json();
                    
                    document.getElementById('vinculosAtuaisDesvinculo').style.display = 'block';
                    
                    const tbody = document.getElementById('corpoVinculosAtuaisDesvinculo');
                    
                    if (vinculos.length === 0) {
                        tbody.innerHTML = `
                            <tr>
                                <td colspan="5" class="text-center text-muted py-3">
                                    <i class="fas fa-unlink fa-2x mb-2"></i><br>
                                    Nenhum módulo vinculado
                                </td>
                            </tr>
                        `;
                        return;
                    }
                    
                    tbody.innerHTML = vinculos.filter(v => v.ativo).map(vinculo => `
                        <tr>
                            <td>
                                <input type="checkbox" class="form-check-input vinculo-checkbox" value="${vinculo.id_modulo}">
                            </td>
                            <td>
                                <i class="${vinculo.icone} me-2" style="color: ${vinculo.cor};"></i>
                                ${vinculo.nome_modulo}
                            </td>
                            <td>
                                <span class="badge bg-success">Ativo</span>
                            </td>
                            <td>${new Date(vinculo.dataCadastro).toLocaleDateString('pt-BR')}</td>
                            <td>
                                <button class="btn btn-sm btn-outline-warning" onclick="GerenciadorModulos.desvincularIndividual(${idPessoa}, ${vinculo.id_modulo})" title="Desvincular este módulo">
                                    <i class="fas fa-unlink"></i>
                                </button>
                            </td>
                        </tr>
                    `).join('');
                    
                } catch (error) {
                    console.error('Erro ao carregar vínculos:', error);
                    AdminRotinas.mostrarMensagem('Erro ao carregar vínculos do usuário', 'error');
                }
            },
            
            selecionarTodosVinculosDesvinculo(checked) {
                document.querySelectorAll('.vinculo-checkbox').forEach(cb => {
                    cb.checked = checked;
                });
            },
            
            async desvincularSelecionados() {
                const idPessoa = document.getElementById('usuarioDesvinculo').value;
                if (!idPessoa) {
                    AdminRotinas.mostrarMensagem('Selecione um usuário', 'error');
                    return;
                }
                
                const modulosSelecionados = Array.from(document.querySelectorAll('.vinculo-checkbox:checked')).map(cb => cb.value);
                
                if (modulosSelecionados.length === 0) {
                    AdminRotinas.mostrarMensagem('Selecione pelo menos um módulo para desvincular', 'error');
                    return;
                }
                
                if (!confirm(`Deseja desvincular ${modulosSelecionados.length} módulo(s) do usuário selecionado?`)) {
                    return;
                }
                
                try {
                    const response = await fetch('/admin/desvincular-modulos', {
                        method: 'POST',
                        headers: {
                            'Accept': 'application/json',
                            'Content-Type': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: JSON.stringify({
                            id_pessoa: idPessoa,
                            modulos: modulosSelecionados
                        })
                    });
                    
                    const result = await response.json();
                    
                    if (response.ok) {
                        AdminRotinas.mostrarMensagem('Módulos desvinculados com sucesso!', 'success');
                        this.carregarVinculosParaDesvinculo(idPessoa);
                    } else {
                        AdminRotinas.mostrarMensagem(result.error || 'Erro ao desvincular módulos', 'error');
                    }
                } catch (error) {
                    console.error('Erro ao desvincular módulos:', error);
                    AdminRotinas.mostrarMensagem('Erro ao desvincular módulos', 'error');
                }
            },
            
            async desvincularTodos() {
                const idPessoa = document.getElementById('usuarioDesvinculo').value;
                if (!idPessoa) {
                    AdminRotinas.mostrarMensagem('Selecione um usuário', 'error');
                    return;
                }
                
                if (!confirm('Deseja desvincular TODOS os módulos do usuário selecionado?')) {
                    return;
                }
                
                try {
                    const response = await fetch(`/admin/desvincular-todos-modulos/${idPessoa}`, {
                        method: 'POST',
                        headers: {
                            'Accept': 'application/json',
                            'Content-Type': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    });
                    
                    const result = await response.json();
                    
                    if (response.ok) {
                        AdminRotinas.mostrarMensagem('Todos os módulos foram desvinculados com sucesso!', 'success');
                        this.carregarVinculosParaDesvinculo(idPessoa);
                    } else {
                        AdminRotinas.mostrarMensagem(result.error || 'Erro ao desvincular módulos', 'error');
                    }
                } catch (error) {
                    console.error('Erro ao desvincular módulos:', error);
                    AdminRotinas.mostrarMensagem('Erro ao desvincular módulos', 'error');
                }
            },
            
            async desvincularIndividual(idPessoa, idModulo) {
                if (!confirm('Deseja desvincular este módulo do usuário?')) {
                    return;
                }
                
                try {
                    const response = await fetch('/admin/desvincular-modulos', {
                        method: 'POST',
                        headers: {
                            'Accept': 'application/json',
                            'Content-Type': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: JSON.stringify({
                            id_pessoa: idPessoa,
                            modulos: [idModulo]
                        })
                    });
                    
                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }
                    
                    const result = await response.json();
                    
                    if (response.ok) {
                        AdminRotinas.mostrarMensagem('Módulo desvinculado com sucesso!', 'success');
                        this.carregarVinculosParaDesvinculo(idPessoa);
                    } else {
                        AdminRotinas.mostrarMensagem(result.error || 'Erro ao desvincular módulo', 'error');
                    }
                } catch (error) {
                    console.error('Erro ao desvincular módulo:', error);
                    AdminRotinas.mostrarMensagem('Erro ao desvincular módulo', 'error');
                }
            },
            
            async toggleModulo(idModulo, ativo) {
                try {
                    const response = await fetch(`/admin/modulos/${idModulo}`, {
                        method: 'PUT',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({ ativo })
                    });
                    
                    if (response.ok) {
                        AdminRotinas.mostrarMensagem(`Módulo ${ativo ? 'ativado' : 'desativado'} com sucesso!`, 'success');
                        this.carregarModulos();
                    } else {
                        AdminRotinas.mostrarMensagem('Erro ao alterar status do módulo', 'error');
                    }
                } catch (error) {
                    console.error('Erro ao alterar módulo:', error);
                    AdminRotinas.mostrarMensagem('Erro ao alterar módulo', 'error');
                }
            },
            
            async desativarUsuario(idPessoa) {
                if (!confirm('Deseja realmente desativar este usuário?')) {
                    return;
                }
                
                try {
                    const response = await fetch(`/admin/usuarios/${idPessoa}`, {
                        method: 'PUT',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({ status: 'Inativo' })
                    });
                    
                    if (response.ok) {
                        AdminRotinas.mostrarMensagem('Usuário desativado com sucesso!', 'success');
                        this.carregarUsuarios();
                    } else {
                        AdminRotinas.mostrarMensagem('Erro ao desativar usuário', 'error');
                    }
                } catch (error) {
                    console.error('Erro ao desativar usuário:', error);
                    AdminRotinas.mostrarMensagem('Erro ao desativar usuário', 'error');
                }
            },
            
            async ativarUsuario(idPessoa) {
                if (!confirm('Deseja realmente ativar este usuário?')) {
                    return;
                }
                
                try {
                    const response = await fetch(`/admin/usuarios/${idPessoa}`, {
                        method: 'PUT',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({ status: 'Ativo' })
                    });
                    
                    if (response.ok) {
                        AdminRotinas.mostrarMensagem('Usuário ativado com sucesso!', 'success');
                        this.carregarUsuarios();
                    } else {
                        AdminRotinas.mostrarMensagem('Erro ao ativar usuário', 'error');
                    }
                } catch (error) {
                    console.error('Erro ao ativar usuário:', error);
                    AdminRotinas.mostrarMensagem('Erro ao ativar usuário', 'error');
                }
            },
            
            async alterarNivelAcesso(idPessoa, novoNivelAcesso) {
                try {
                    const response = await fetch(`/admin/usuarios/${idPessoa}`, {
                        method: 'PUT',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({ nivelacesso: novoNivelAcesso })
                    });
                    
                    if (response.ok) {
                        AdminRotinas.mostrarMensagem('Tipo de acesso alterado com sucesso!', 'success');
                    } else {
                        AdminRotinas.mostrarMensagem('Erro ao alterar tipo de acesso', 'error');
                        // Recarregar a lista para reverter a mudança visual
                        this.carregarUsuarios();
                    }
                } catch (error) {
                    console.error('Erro ao alterar tipo de acesso:', error);
                    AdminRotinas.mostrarMensagem('Erro ao alterar tipo de acesso', 'error');
                    // Recarregar a lista para reverter a mudança visual
                    this.carregarUsuarios();
                }
            },
            
            filtrarUsuarios() {
                const filtro = document.getElementById('filtroUsuarios').value.toLowerCase();
                const tabela = document.getElementById('tabelaUsuarios');
                const linhas = tabela.getElementsByTagName('tbody')[0].getElementsByTagName('tr');
                
                for (let i = 0; i < linhas.length; i++) {
                    const linha = linhas[i];
                    const nome = linha.getElementsByTagName('td')[0];
                    
                    if (nome) {
                        const textoNome = nome.textContent || nome.innerText;
                        if (textoNome.toLowerCase().indexOf(filtro) > -1) {
                            linha.style.display = '';
                        } else {
                            linha.style.display = 'none';
                        }
                    }
                }
            },
            
            limparFormularioCriarLogin() {
                // Garantir que os campos estejam vazios na inicialização
                const buscaPessoa = document.getElementById('buscaPessoaLogin');
                const senhaLogin = document.getElementById('senhaLogin');
                const pessoaId = document.getElementById('pessoaLoginId');
                const nivelAcesso = document.getElementById('nivelAcessoLogin');
                const resultados = document.getElementById('resultadosBuscaPessoa');
                
                if (buscaPessoa) buscaPessoa.value = '';
                if (senhaLogin) senhaLogin.value = '';
                if (pessoaId) pessoaId.value = '';
                if (nivelAcesso) nivelAcesso.value = '';
                if (resultados) resultados.style.display = 'none';
            }
        };

        // Função para monitorar e prevenir adição da classe loading
        function prevenirClasseLoading() {
            const observer = new MutationObserver(function(mutations) {
                mutations.forEach(function(mutation) {
                    if (mutation.type === 'attributes' && mutation.attributeName === 'class') {
                        const target = mutation.target;
                        if (target === document.body && target.classList.contains('loading')) {
                            // Verificar se algum modal está aberto
                            const modalAberto = document.querySelector('.modal.show');
                            if (modalAberto && modalAberto.id === 'modalImportarCsv') {
                                console.log('Detectada adição da classe loading com modal aberto - removendo...');
                                target.classList.remove('loading');
                            }
                        }
                    }
                });
            });
            
            observer.observe(document.body, {
                attributes: true,
                attributeFilter: ['class']
            });
        }

        // Event listener único consolidado
        document.addEventListener('DOMContentLoaded', function() {
            // Iniciar monitoramento da classe loading
            prevenirClasseLoading();
            // Inicializar AdminRotinas
            if (typeof AdminRotinas !== 'undefined') AdminRotinas.init();
            
            // Inicializar GerenciadorPessoas
            console.log('Verificando GerenciadorPessoas:', typeof GerenciadorPessoas);
            if (typeof GerenciadorPessoas !== 'undefined') {
                console.log('Inicializando GerenciadorPessoas...');
                GerenciadorPessoas.init();
            } else {
                console.error('GerenciadorPessoas não está definido!');
            }
            
            // Inicializar GerenciadorModulos
            GerenciadorModulos.init();
            
            // Inicializar ImportadorCsv
            if (typeof ImportadorCsv !== 'undefined') {
                console.log('Inicializando ImportadorCsv...');
                window.importadorCsv = new ImportadorCsv();
            } else {
                console.error('ImportadorCsv não está definido!');
            }
            
            // Configurar botão Nova Pessoa
            configurarBtnNovaPessoa();
            
            // Configurar link Importar CSV
            const linkImportarCsv = document.getElementById('linkImportarCsv');
            if (linkImportarCsv) {
                linkImportarCsv.addEventListener('click', (e) => {
                    e.preventDefault();
                    console.log('Link Importar CSV clicado');
                    
                    // Forçar remoção da classe loading
                    document.body.classList.remove('loading');
                    console.log('Classe loading removida do body');
                    
                    // Aguardar um pouco antes de abrir o modal
                    setTimeout(() => {
                        const modal = new bootstrap.Modal(document.getElementById('modalImportarCsv'));
                        modal.show();
                        console.log('Modal importar CSV exibido');
                    }, 100);
                });
            }
            
            // Garantir que o modal de importação CSV não seja bloqueado pela classe loading
            const modalImportarCsv = document.getElementById('modalImportarCsv');
            if (modalImportarCsv) {
                modalImportarCsv.addEventListener('show.bs.modal', function() {
                    // Remover classe loading do body quando o modal for aberto
                    document.body.classList.remove('loading');
                    console.log('Modal importar CSV aberto - classe loading removida');
                    
                    // Garantir que o modal tenha pointer-events habilitados
                    this.style.pointerEvents = 'auto';
                    console.log('Pointer events habilitados no modal');
                });
                
                // Adicionar evento para quando o modal for totalmente exibido
                modalImportarCsv.addEventListener('shown.bs.modal', function() {
                    // Dupla verificação para remover loading
                    document.body.classList.remove('loading');
                    this.style.pointerEvents = 'auto';
                    console.log('Modal importar CSV totalmente exibido - verificações finais concluídas');
                });
            }
        });
    </script>

