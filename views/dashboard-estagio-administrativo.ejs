                }
                if (filtros.filtroEmEdicao !== undefined) {
                    document.getElementById('filtroEmEdicao').checked = filtros.filtroEmEdicao;
                }
                if (filtros.filtroConcluido !== undefined) {
                    document.getElementById('filtroConcluido').checked = filtros.filtroConcluido;
                }
                if (filtros.filtroFinalizado !== undefined) {
                    document.getElementById('filtroFinalizado').checked = filtros.filtroFinalizado;
                }
                
                // Aplicar filtros após restaurar
