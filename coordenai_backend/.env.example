# CoordenAI - Backend. Copie para .env e ajuste.

NODE_ENV=production
PORT=3001

# Sessão. Durante a convivência com o legado use o MESMO segredo e o mesmo
# nome de cookie dele, para que o login valha nos dois sistemas.
# Gerar: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=
SESSION_COOKIE_NAME=gestao.sid

# Banco de dados MariaDB/MySQL (o mesmo do legado)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gestao_bccufj
DB_USER=
DB_PASSWORD=
DB_CONNECTION_LIMIT=10

# Endereço público do frontend (usado nos links enviados por e-mail)
FRONTEND_URL=https://gestao.computacaoufj.online/app

# Pasta dos arquivos enviados. Durante a convivência com o legado, aponte para
# a pasta public/uploads dele (ex.: /opt/nodejs/apps/gestao-bcc/public/uploads).
UPLOADS_DIR=

# Só é necessário se o frontend for aberto em outra origem (lista separada por vírgula)
CORS_ORIGIN=

# Caminho do Chromium para geração de PDF (opcional)
PUPPETEER_EXECUTABLE_PATH=

LOG_LEVEL=info
