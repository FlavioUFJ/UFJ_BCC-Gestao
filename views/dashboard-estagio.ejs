    AdminDashboard.atualizarStatus = function(estagiarioId, novoStatus) {
        console.log('Iniciando atualização de status:', { estagiarioId, novoStatus });
        
        fetch(`/admin/estagiario/${estagiarioId}/status`, {
            method: 'PUT',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ situacao: novoStatus })
        })
        .then(response => {
            console.log('Resposta recebida:', response.status, response.statusText);
            
            if (!response.ok) {
                console.error('Resposta não OK:', response.status, response.statusText);
                throw new Error(`HTTP ${response.status}: ${response.statusText}`);
            }
            
            return response.text().then(text => {
                console.log('Texto bruto da resposta:', text);
                try {
                    return JSON.parse(text);
                } catch (e) {
                    console.error('Erro ao fazer parse do JSON:', e);
                    throw new Error('Resposta não é um JSON válido');
                }
            });
        })
        .then(data => {
            console.log('Dados da resposta:', data);
            if (data.success) {
                // Mostrar feedback visual de sucesso
                const select = document.querySelector(`select[data-estagiario-id="${estagiarioId}"]`);
                if (select) {
                    select.style.backgroundColor = '#d4edda';
                    select.style.borderColor = '#c3e6cb';
                    setTimeout(() => {
                        select.style.backgroundColor = '';
                        select.style.borderColor = '';
                    }, 2000);
                }
                this.mostrarAlerta('Status atualizado com sucesso!', 'success');
            } else {
                console.error('Erro retornado pelo servidor:', data.message);
                this.mostrarAlerta('Erro ao atualizar status: ' + data.message, 'error');
                location.reload();
            }
        })
        .catch(error => {
            console.error('Erro na requisição:', error);
            this.mostrarAlerta('Erro ao atualizar status: ' + error.message, 'error');
            location.reload();
        });
    };

