                            <td>${pessoa.email || '-'}</td>
                            <td>
                                <button class="btn btn-sm btn-outline-danger" onclick="GerenciadorModulos.desvincularPessoa(${this.moduloAtual.id_modulo}, ${pessoa.id_pessoa})" title="Desvincular">
