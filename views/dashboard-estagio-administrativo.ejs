<script>
// Dashboard Administrativo de Estágios
const DashboardAdmin = {
    campoSelecionado: null,
    planoSelecionado: null,
    
    init() {
        this.carregarDashboards();
        this.carregarCamposEstagio();
        this.setupEventListeners();
        this.restaurarFiltros();
        
        // Configurar event listeners para as abas
        document.querySelectorAll('[data-bs-toggle="tab"]').forEach(tab => {
            tab.addEventListener('shown.bs.tab', (event) => {
                const targetTab = event.target.getAttribute('data-bs-target');
                
                if (targetTab === '#planos') {
                    this.carregarPlanosIndependente();
                } else if (targetTab === '#frequencias') {
                    this.carregarFrequenciasIndependente();
                }
            });
        });
        
        // Event listeners para filtros de Planos de Atividade
        const filtrosPlanos = ['filtroSituacaoEmEdicao', 'filtroSituacaoEmAprovacao', 'filtroSituacaoAprovadoSemAnexo', 'filtroSituacaoAprovadoComAnexo', 'filtroCategoriaPessoa', 'filtroAnexadoSEISim', 'filtroAnexadoSEINao'];
        filtrosPlanos.forEach(filtroId => {
            const elemento = document.getElementById(filtroId);
            if (elemento) {
                elemento.addEventListener('change', () => {
                    if (filtroId === 'filtroCategoriaPessoa') {
                        this.toggleCaixaPesquisaNome();
                    }
                    this.filtrarPlanosIndependente();
                });
            }
        });
        
        // Event listener para o campo de pesquisa por nome
        const filtroNome = document.getElementById('filtroNomePessoa');
        if (filtroNome) {
            filtroNome.addEventListener('input', () => this.filtrarPlanosIndependente());
        }
        
        // Event listeners para filtros de Frequências
        const filtrosFreq = ['filtroAprovadoEstagiario', 'filtroAprovadoOrientador', 'filtroAprovadoSupervisor', 'filtroPendentes', 'filtroCategoriaFreq', 'filtroAnexadoSEISimFreq', 'filtroAnexadoSEINaoFreq'];
        filtrosFreq.forEach(filtroId => {
            const elemento = document.getElementById(filtroId);
            if (elemento) {
                elemento.addEventListener('change', () => {
                    if (filtroId === 'filtroCategoriaFreq') {
                        this.toggleCaixaPesquisaNomeFreq();
                    }
                    this.filtrarFrequenciasIndependente();
                });
            }
        });
        
        // Event listener para o campo de pesquisa por nome na aba Frequências
        const filtroNomeFreq = document.getElementById('filtroNomeFreq');
        if (filtroNomeFreq) {
            filtroNomeFreq.addEventListener('input', () => this.filtrarFrequenciasIndependente());
        }
